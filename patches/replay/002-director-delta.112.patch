+}
+
+/* --- Quick Status Bar --- */
+
+.dc-status-bar {
+	display: flex;
+	gap: 16px;
+	padding: 10px 14px;
+	border-radius: 6px;
+	border: 1px solid var(--vscode-widget-border, var(--vscode-input-border));

+	margin-bottom: 32px;
+}
+
+.dc-settings-form {
+	display: flex;
+	flex-direction: column;
+	gap: 12px;
+	max-width: 500px;
+}
+
+.dc-form-row {
+	display: flex;
+	flex-direction: column;
+	gap: 4px;
+}
+
+.dc-form-label {
+	font-size: 12px;
+	font-weight: 500;
+	color: var(--vscode-foreground);
+}
+
+.dc-form-select,

+
+/* ============================================================================
+   Director Code Settings Editor Styles
+   ============================================================================ */
+
+/* --- General Layout --- */
+
+.director-code-settings-editor {
+	padding: 20px 24px;
+	overflow-y: auto;
+	height: 100%;
+	box-sizing: border-box;
+}
+
+.dc-section-header {
+	font-size: 16px;

+
+		test("converts init event to progress message", () => {
+			const event: AgentEvent = {
+				type: 'system',
+				subtype: 'init',
+				model: 'claude-sonnet-4-6',
+				tools: ['search', 'edit'],
+			} as any;
+
+			const progress = agentEventToProgress(event);
+			assert.strictEqual(progress.length, 1);

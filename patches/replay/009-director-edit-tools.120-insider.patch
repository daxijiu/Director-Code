+import { ILanguageModelToolsService, IToolData, IToolImpl } from '../../../common/tools/languageModelToolsService.js';
+
+export class DirectorEditToolsContribution extends Disposable implements IWorkbenchContribution {
+	static readonly ID = 'workbench.contrib.directorEditTools';
+
+	constructor(
+		@ILanguageModelToolsService toolsService: ILanguageModelToolsService,
+		@IInstantiationService instantiationService: IInstantiationService,
+	) {
+		super();
+
+		this.registerEditTool(toolsService, DirectorApplyPatchToolData, instantiationService.createInstance(DirectorApplyPatchTool));
+		this.registerEditTool(toolsService, DirectorCreateFileToolData, instantiationService.createInstance(DirectorCreateFileTool));
+		this.registerEditTool(toolsService, DirectorCreateDirectoryToolData, instantiationService.createInstance(DirectorCreateDirectoryTool));
+		this.registerEditTool(toolsService, DirectorReplaceStringInFileToolData, instantiationService.createInstance(DirectorReplaceStringInFileTool));
+		this.registerEditTool(toolsService, DirectorMultiReplaceStringInFileToolData, instantiationService.createInstance(DirectorMultiReplaceStringInFileTool));
+	}
+
+	private registerEditTool(toolsService: ILanguageModelToolsService, toolData: IToolData, tool: IToolImpl): void {
+		this._register(toolsService.registerTool(toolData, tool));
+	}
+}
+
+CommandsRegistry.registerCommand(DirectorAcceptDirectoryCreationCommandId, async (accessor, transactionId: string) => {
+	return acceptDirectorDirectoryCreationTransaction(accessor.get(IFileService), transactionId);
+});
+
+CommandsRegistry.registerCommand(DirectorRejectDirectoryCreationCommandId, async (_accessor, transactionId: string) => {
+	return rejectDirectorDirectoryCreationTransaction(transactionId);
+});
+
+registerWorkbenchContribution2(DirectorEditToolsContribution.ID, DirectorEditToolsContribution, WorkbenchPhase.AfterRestored);
+
+export { DirectorEditToolData };

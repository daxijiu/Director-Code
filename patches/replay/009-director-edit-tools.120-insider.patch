+import { IChatProgress, IChatService } from '../../../../chat/common/chatService/chatService.js';
+import { IChatModel, IChatRequestModel } from '../../../../chat/common/model/chatModel.js';
+import { IToolInvocation, IToolResult } from '../../../../chat/common/tools/languageModelToolsService.js';
+
+suite('Director Edit Tools', () => {
+
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	const root = URI.file('/workspace');
+	const folder = { uri: root, name: 'workspace', index: 0 } as IWorkspaceFolder;
+	const sessionResource = URI.parse('vscode-chat://director-test/session');
+
+	function workspaceService(): IWorkspaceContextService {
+		return {
+			getWorkspace: () => ({ id: 'test', folders: [folder] }),
+			getWorkspaceFolder: (resource: URI) => resource.path.startsWith(root.path) ? folder : null,
+		} as unknown as IWorkspaceContextService;
+	}
+
+	function invocation(parameters: Record<string, unknown>): IToolInvocation {
+		return {
+			callId: 'call',
+			toolId: 'tool',
+			parameters,
+			context: { sessionResource },
+			chatRequestId: 'target-request',
+		};
+	}
+
+	function textOf(result: IToolResult): string {
+		const part = result.content[0];
+		assert.strictEqual(part.kind, 'text');
+		return part.value;
+	}
+
+	function modelAndCalls() {
+		const calls: Array<{ requestId: string; progress: IChatProgress }> = [];
+		const request = { id: 'target-request' } as IChatRequestModel;
+		const model = {
+			getRequests: () => [request],
+			startEditingSession: () => undefined,
+			acceptResponseProgress: (target: IChatRequestModel, progress: IChatProgress) => calls.push({ requestId: target.id, progress }),
+			sessionResource,
+		} as unknown as IChatModel & { acceptResponseProgress(target: IChatRequestModel, progress: IChatProgress): void };
+		const chatService = {
+			getSession: (resource: URI) => resource.toString() === sessionResource.toString() ? model : undefined,
+		} as unknown as IChatService;
+		return { chatService, calls };
+	}
+
+	function fileService(initialFiles: Record<string, string> = {}) {
+		const files = new Map<string, string>();
+		const folders = new Set<string>();
+		for (const [path, content] of Object.entries(initialFiles)) {
+			files.set(URI.joinPath(root, path).toString(), content);
+		}
+
+		const service = {
+			exists: async (resource: URI) => files.has(resource.toString()) || folders.has(resource.toString()),
+			readFile: async (resource: URI): Promise<IFileContent> => {
+				const value = files.get(resource.toString());
+				if (value === undefined) {
+					throw new Error(`File not found: ${resource.toString()}`);
+				}
+				const buffer = VSBuffer.fromString(value);
+				return {
+					resource,
+					name: resource.path.split('/').pop() ?? 'file',
+					value: buffer,
+					mtime: 1,
+					ctime: 1,
+					etag: '1',
+					size: buffer.byteLength,
+					readonly: false,
+					locked: false,
+					executable: false,
+				};
+			},
+			createFolder: async (resource: URI): Promise<IFileStatWithMetadata> => {
+				folders.add(resource.toString());
+				return {
+					resource,
+					name: resource.path.split('/').pop() ?? 'folder',
+					isFile: false,
+					isDirectory: true,
+					isSymbolicLink: false,
+					mtime: 1,
+					ctime: 1,
+					etag: '1',
+					size: 0,
+					readonly: false,
+					locked: false,
+					executable: false,
+					children: undefined,
+				};
+			},
+			_folders: folders,
+		} as unknown as IFileService & { readonly _folders: Set<string> };
+		return service;
+	}
+
+	test('replace_string_in_file emits reviewable text edit progress', async () => {
+		const fakeFiles = fileService({ 'src/a.ts': 'const a = 1;\n' });
+		const fakeChat = modelAndCalls();
+		const tool = new DirectorReplaceStringInFileTool(fakeFiles, fakeChat.chatService, workspaceService());
+
+		const result = await tool.invoke(invocation({ path: 'src/a.ts', oldString: '1', newString: '2' }), async () => 0, undefined as any, CancellationToken.None);
+
+		assert.ok(/edit_result: success/.test(textOf(result)));
+		assert.deepStrictEqual(fakeChat.calls.map(call => call.progress.kind), ['markdownContent', 'codeblockUri', 'textEdit', 'textEdit', 'textEdit']);
+		const editProgress = fakeChat.calls[3].progress;
+		assert.strictEqual(editProgress.kind, 'textEdit');
+		assert.strictEqual(editProgress.edits[0].text, '2');
+	});
+
+	test('multi_replace_string_in_file rejects overlapping replacements', async () => {
+		const fakeFiles = fileService({ 'src/a.ts': 'abc\n' });
+		const fakeChat = modelAndCalls();
+		const tool = new DirectorMultiReplaceStringInFileTool(fakeFiles, fakeChat.chatService, workspaceService());
+
+		const result = await tool.invoke(invocation({
+			path: 'src/a.ts',
+			replacements: [
+				{ oldString: 'ab', newString: 'x' },
+				{ oldString: 'bc', newString: 'y' },
+			],
+		}), async () => 0, undefined as any, CancellationToken.None);
+
+		assert.ok(/overlap/.test(textOf(result)));
+		assert.strictEqual(fakeChat.calls.length, 0);
+	});
+
+	test('createFile rejects duplicate files before emitting progress', async () => {
+		const fakeFiles = fileService({ 'src/a.ts': 'old' });
+		const fakeChat = modelAndCalls();
+		const tool = new DirectorCreateFileTool(fakeFiles, fakeChat.chatService, workspaceService());
+
+		const result = await tool.invoke(invocation({ filePath: 'src/a.ts', content: 'new' }), async () => 0, undefined as any, CancellationToken.None);
+
+		assert.ok(/already exists/.test(textOf(result)));
+		assert.strictEqual(fakeChat.calls.length, 0);
+	});
+
+	test('apply_patch emits reviewable edits for a unified diff', async () => {
+		const fakeFiles = fileService({ 'src/a.ts': 'const a = 1;\n' });
+		const fakeChat = modelAndCalls();
+		const tool = new DirectorApplyPatchTool(fakeFiles, fakeChat.chatService, workspaceService());
+		const patch = [
+			'--- a/src/a.ts',
+			'+++ b/src/a.ts',
+			'@@ -1,1 +1,1 @@',
+			'-const a = 1;',
+			'+const a = 2;',
+		].join('\n');
+
+		const result = await tool.invoke(invocation({ patch }), async () => 0, undefined as any, CancellationToken.None);
+
+		assert.ok(/edit_result: success/.test(textOf(result)));
+		const editProgress = fakeChat.calls[3].progress;
+		assert.strictEqual(editProgress.kind, 'textEdit');
+		assert.strictEqual(editProgress.edits[0].text, 'const a = 2;\n');
+	});
+
+	test('createDirectory waits for accept before creating the folder', async () => {
+		const fakeFiles = fileService();
+		const fakeChat = modelAndCalls();
+		const tool = new DirectorCreateDirectoryTool(fakeFiles, fakeChat.chatService, workspaceService());
+		const resultPromise = tool.invoke(invocation({ dirPath: 'src/new-dir' }), async () => 0, undefined as any, CancellationToken.None);
+
+		await Promise.resolve();
+		await Promise.resolve();
+
+		assert.strictEqual(fakeFiles._folders.size, 0);
+		const commandProgress = fakeChat.calls.find(call => call.progress.kind === 'command')?.progress;
+		assert.ok(commandProgress);
+		assert.strictEqual(commandProgress.kind, 'command');
+		const transactionId = commandProgress.command.arguments?.[0] as string;
+		assert.ok(transactionId);
+
+		await acceptDirectorDirectoryCreationTransaction(fakeFiles, transactionId);
+		const result = await resultPromise;
+
+		assert.ok(/edit_result: success/.test(textOf(result)));
+		assert.strictEqual(fakeFiles._folders.has(URI.joinPath(root, 'src/new-dir').toString()), true);
+	});
+});

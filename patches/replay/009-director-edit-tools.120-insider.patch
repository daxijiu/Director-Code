+export const DirectorEditToolData = [
+	DirectorApplyPatchToolData,
+	DirectorCreateFileToolData,
+	DirectorCreateDirectoryToolData,
+	DirectorReplaceStringInFileToolData,
+	DirectorMultiReplaceStringInFileToolData,
+] as const;
+
+type DirectoryCreationOutcome =
+	| { readonly status: 'accepted'; readonly path: string }
+	| { readonly status: 'rejected'; readonly path: string }
+	| { readonly status: 'cancelled'; readonly path: string }
+	| { readonly status: 'error'; readonly path: string; readonly message: string };
+
+interface DirectoryCreationTransaction {
+	readonly id: string;
+	readonly uri: URI;
+	readonly relativePath: string;
+	readonly deferred: DeferredPromise<DirectoryCreationOutcome>;
+}
+
+const directoryCreationTransactions = new Map<string, DirectoryCreationTransaction>();
+
+export function getPendingDirectorDirectoryCreationTransaction(id: string): DirectoryCreationTransaction | undefined {
+	return directoryCreationTransactions.get(id);
+}
+
+export function createDirectorDirectoryCreationTransaction(uri: URI, relativePath: string): DirectoryCreationTransaction {
+	const transaction = {
+		id: generateUuid(),
+		uri,
+		relativePath,
+		deferred: new DeferredPromise<DirectoryCreationOutcome>(),
+	};
+	directoryCreationTransactions.set(transaction.id, transaction);
+	return transaction;
+}
+
+export async function acceptDirectorDirectoryCreationTransaction(fileService: IFileService, transactionId: string): Promise<DirectoryCreationOutcome> {
+	const transaction = directoryCreationTransactions.get(transactionId);
+	if (!transaction) {
+		return { status: 'error', path: '', message: 'Directory creation transaction was not found.' };
+	}
+
+	try {
+		if (await fileService.exists(transaction.uri)) {
+			const outcome: DirectoryCreationOutcome = { status: 'error', path: transaction.relativePath, message: 'Target path already exists.' };
+			await transaction.deferred.complete(outcome);
+			return outcome;
+		}
+
+		await fileService.createFolder(transaction.uri);
+		const outcome: DirectoryCreationOutcome = { status: 'accepted', path: transaction.relativePath };
+		await transaction.deferred.complete(outcome);
+		return outcome;
+	} catch (error) {
+		const message = error instanceof Error ? error.message : String(error);
+		const outcome: DirectoryCreationOutcome = { status: 'error', path: transaction.relativePath, message };
+		await transaction.deferred.complete(outcome);
+		return outcome;
+	} finally {
+		directoryCreationTransactions.delete(transactionId);
+	}
+}
+
+export async function rejectDirectorDirectoryCreationTransaction(transactionId: string): Promise<DirectoryCreationOutcome> {
+	const transaction = directoryCreationTransactions.get(transactionId);
+	if (!transaction) {
+		return { status: 'error', path: '', message: 'Directory creation transaction was not found.' };
+	}
+
+	const outcome: DirectoryCreationOutcome = { status: 'rejected', path: transaction.relativePath };
+	await transaction.deferred.complete(outcome);
+	directoryCreationTransactions.delete(transactionId);
+	return outcome;
+}
+
+abstract class DirectorEditToolBase implements IToolImpl {
+	protected readonly adapter: DirectorChatEditingAdapter;
+
+	constructor(
+		protected readonly fileService: IFileService,
+		chatService: IChatService,
+		workspaceContextService: IWorkspaceContextService,
+	) {
+		this.adapter = new DirectorChatEditingAdapter(chatService, workspaceContextService);
+	}
+
+	abstract invoke(invocation: IToolInvocation, countTokens: CountTokensCallback, progress: ToolProgress, token: CancellationToken): Promise<IToolResult>;
+
+	protected binding(invocation: IToolInvocation): (DirectorPanelChatEditBinding & { readonly ok: true }) | { readonly ok: false; readonly reason: string } {
+		if (!invocation.context?.sessionResource) {
+			return { ok: false, reason: 'Missing chat session resource for reviewable edit.' };
+		}
+		if (!invocation.chatRequestId) {
+			return { ok: false, reason: 'Missing chatRequestId for reviewable edit.' };
+		}
+		return {
+			ok: true,
+			chatSessionResource: invocation.context.sessionResource,
+			chatRequestId: invocation.chatRequestId,
+		};
+	}
+
+	protected async readWorkspaceText(path: string, token: CancellationToken): Promise<{ readonly ok: true; readonly uri: URI; readonly relativePath: string; readonly text: string } | { readonly ok: false; readonly reason: string }> {
+		const target = this.adapter.resolveWorkspaceTarget({ path });
+		if (!target.ok) {
+			return target;
+		}
+
+		const content = await this.fileService.readFile(target.uri, undefined, token);
+		if (content.value.byteLength > DEFAULT_MAX_TEXT_BYTES) {
+			return { ok: false, reason: `File is too large for reviewable text editing: ${target.relativePath}` };
+		}
+
+		const detected = detectEncodingFromBuffer({ buffer: content.value, bytesRead: content.value.byteLength });
+		if (detected.seemsBinary) {
+			return { ok: false, reason: `Binary files are not supported by reviewable edit tools: ${target.relativePath}` };
+		}
+
+		return { ok: true, uri: target.uri, relativePath: target.relativePath, text: content.value.toString() };
+	}
+
+	protected async emitSingleFileEdits(invocation: IToolInvocation, path: string, explanation: string, edits: readonly TextEdit[], token: CancellationToken): Promise<IToolResult> {
+		const binding = this.binding(invocation);
+		if (!binding.ok) {
+			return textResult(formatDirectorChatEditToolResult(binding));
+		}
+
+		const result = await this.adapter.emitSingleFileTextEdit({
+			...binding,
+			path,
+			explanation,
+			edits,
+		}, token);
+		return textResult(formatDirectorChatEditToolResult(result));
+	}
+}
+
+export class DirectorReplaceStringInFileTool extends DirectorEditToolBase {
+	constructor(
+		@IFileService fileService: IFileService,
+		@IChatService chatService: IChatService,
+		@IWorkspaceContextService workspaceContextService: IWorkspaceContextService,
+	) {
+		super(fileService, chatService, workspaceContextService);
+	}
+
+	async invoke(invocation: IToolInvocation, _countTokens: CountTokensCallback, _progress: ToolProgress, token: CancellationToken): Promise<IToolResult> {
+		const params = invocation.parameters as ToolParams;
+		const path = stringParam(params, 'path');
+		const oldString = stringParam(params, 'oldString');
+		const newString = stringParam(params, 'newString') ?? '';
+		if (!path || !oldString) {
+			return textResult(formatDirectorChatEditToolResult({ ok: false, reason: 'path and oldString are required.' }));
+		}
+
+		const read = await this.readWorkspaceText(path, token);
+		if (!read.ok) {
+			return textResult(formatDirectorChatEditToolResult(read));
+		}
+
+		const matches = findOccurrences(read.text, oldString);
+		if (matches.length === 0) {
+			return textResult(formatDirectorChatEditToolResult({ ok: false, reason: `oldString was not found in ${read.relativePath}.` }));
+		}
+
+		const replaceAll = booleanParam(params, 'replaceAll') === true;
+		if (matches.length > 1 && !replaceAll) {
+			return textResult(formatDirectorChatEditToolResult({ ok: false, reason: `oldString matched ${matches.length} times in ${read.relativePath}; set replaceAll true or provide a more specific string.` }));
+		}
+
+		const selected = replaceAll ? matches : matches.slice(0, 1);
+		const edits = selected.map(offset => ({
+			range: rangeFromOffsets(read.text, offset, offset + oldString.length),
+			text: newString,
+		}));
+
+		return this.emitSingleFileEdits(invocation, path, `Replace text in ${read.relativePath}`, edits, token);
+	}
+}
+
+export class DirectorMultiReplaceStringInFileTool extends DirectorEditToolBase {
+	constructor(
+		@IFileService fileService: IFileService,
+		@IChatService chatService: IChatService,
+		@IWorkspaceContextService workspaceContextService: IWorkspaceContextService,
+	) {
+		super(fileService, chatService, workspaceContextService);
+	}
+
+	async invoke(invocation: IToolInvocation, _countTokens: CountTokensCallback, _progress: ToolProgress, token: CancellationToken): Promise<IToolResult> {
+		const params = invocation.parameters as ToolParams;
+		const path = stringParam(params, 'path');
+		const replacements = Array.isArray(params.replacements) ? params.replacements as ToolParams[] : undefined;
+		if (!path || !replacements?.length) {
+			return textResult(formatDirectorChatEditToolResult({ ok: false, reason: 'path and at least one replacement are required.' }));
+		}
+
+		const read = await this.readWorkspaceText(path, token);
+		if (!read.ok) {
+			return textResult(formatDirectorChatEditToolResult(read));
+		}
+
+		const edits: Array<{ range: IRange; text: string; start: number; end: number }> = [];
+		for (const replacement of replacements) {
+			const oldString = stringParam(replacement, 'oldString');
+			const newString = stringParam(replacement, 'newString') ?? '';
+			if (!oldString) {
+				return textResult(formatDirectorChatEditToolResult({ ok: false, reason: 'Each replacement requires oldString.' }));
+			}
+
+			const matches = findOccurrences(read.text, oldString);
+			if (matches.length === 0) {
+				return textResult(formatDirectorChatEditToolResult({ ok: false, reason: `oldString was not found in ${read.relativePath}: ${oldString}` }));
+			}
+
+			const replaceAll = booleanParam(replacement, 'replaceAll') === true;
+			if (matches.length > 1 && !replaceAll) {
+				return textResult(formatDirectorChatEditToolResult({ ok: false, reason: `oldString matched ${matches.length} times in ${read.relativePath}; set replaceAll true or provide a more specific string.` }));
+			}
+
+			for (const start of replaceAll ? matches : matches.slice(0, 1)) {
+				const end = start + oldString.length;
+				edits.push({ start, end, range: rangeFromOffsets(read.text, start, end), text: newString });
+			}
+		}
+
+		const overlap = firstOverlap(edits);
+		if (overlap) {
+			return textResult(formatDirectorChatEditToolResult({ ok: false, reason: `Replacement ranges overlap in ${read.relativePath}.` }));
+		}
+
+		return this.emitSingleFileEdits(invocation, path, `Replace ${edits.length} text ranges in ${read.relativePath}`, edits, token);
+	}
+}
+
+export class DirectorCreateFileTool extends DirectorEditToolBase {
+	constructor(
+		@IFileService fileService: IFileService,
+		@IChatService chatService: IChatService,
+		@IWorkspaceContextService workspaceContextService: IWorkspaceContextService,
+	) {
+		super(fileService, chatService, workspaceContextService);
+	}
+
+	async invoke(invocation: IToolInvocation, _countTokens: CountTokensCallback, _progress: ToolProgress, token: CancellationToken): Promise<IToolResult> {
+		const params = invocation.parameters as ToolParams;
+		const path = stringParam(params, 'filePath') ?? stringParam(params, 'path');
+		const content = stringParam(params, 'content') ?? '';
+		if (!path) {
+			return textResult(formatDirectorChatEditToolResult({ ok: false, reason: 'filePath is required.' }));
+		}
+		if (content.length > DEFAULT_MAX_TEXT_BYTES) {
+			return textResult(formatDirectorChatEditToolResult({ ok: false, reason: 'File content is too large for createFile.' }));
+		}
+
+		const target = this.adapter.resolveWorkspaceTarget({ path });
+		if (!target.ok) {
+			return textResult(formatDirectorChatEditToolResult(target));
+		}
+
+		const overwrite = booleanParam(params, 'overwrite') === true;
+		if (!overwrite && await this.fileService.exists(target.uri)) {
+			return textResult(formatDirectorChatEditToolResult({ ok: false, reason: `Target file already exists: ${target.relativePath}` }));
+		}
+
+		return this.emitSingleFileEdits(invocation, path, `Create file ${target.relativePath}`, [{ range: emptyStartRange(), text: content }], token);
+	}
+}
+
+export class DirectorApplyPatchTool extends DirectorEditToolBase {
+	constructor(
+		@IFileService fileService: IFileService,
+		@IChatService chatService: IChatService,
+		@IWorkspaceContextService workspaceContextService: IWorkspaceContextService,
+	) {
+		super(fileService, chatService, workspaceContextService);
+	}
+
+	async invoke(invocation: IToolInvocation, _countTokens: CountTokensCallback, _progress: ToolProgress, token: CancellationToken): Promise<IToolResult> {
+		const params = invocation.parameters as ToolParams;
+		const patchText = stringParam(params, 'patch') ?? stringParam(params, 'diff');
+		if (!patchText) {
+			return textResult(formatDirectorChatEditToolResult({ ok: false, reason: 'patch is required.' }));
+		}
+
+		const parsed = parseUnifiedPatch(patchText, stringParam(params, 'path'));
+		if (!parsed.ok) {
+			return textResult(formatDirectorChatEditToolResult(parsed));
+		}
+
+		const planned: Array<{ path: string; relativePath: string; edits: readonly TextEdit[] }> = [];
+		for (const filePatch of parsed.files) {
+			const target = this.adapter.resolveWorkspaceTarget({ path: filePatch.path });
+			if (!target.ok) {
+				return textResult(formatDirectorChatEditToolResult(target));
+			}
+
+			if (filePatch.isDeletion) {
+				return textResult(formatDirectorChatEditToolResult({ ok: false, reason: `File deletion is not supported by apply_patch v1: ${target.relativePath}` }));
+			}
+
+			if (filePatch.isNewFile) {
+				if (await this.fileService.exists(target.uri)) {
+					return textResult(formatDirectorChatEditToolResult({ ok: false, reason: `Patch creates a file that already exists: ${target.relativePath}` }));
+				}
+				planned.push({ path: filePatch.path, relativePath: target.relativePath, edits: [{ range: emptyStartRange(), text: textForNewFilePatch(filePatch) }] });
+				continue;
+			}
+
+			const read = await this.readWorkspaceText(filePatch.path, token);
+			if (!read.ok) {
+				return textResult(formatDirectorChatEditToolResult(read));
+			}
+
+			const edits = textEditsForPatch(read.text, filePatch);
+			if (!edits.ok) {
+				return textResult(formatDirectorChatEditToolResult({ ok: false, reason: `${read.relativePath}: ${edits.reason}` }));
+			}
+
+			planned.push({ path: filePatch.path, relativePath: read.relativePath, edits: edits.edits });
+		}
+
+		const results = [];
+		for (const entry of planned) {
+			const binding = this.binding(invocation);
+			if (!binding.ok) {
+				return textResult(formatDirectorChatEditToolResult(binding));
+			}
+			const result = await this.adapter.emitSingleFileTextEdit({
+				...binding,
+				path: entry.path,
+				explanation: `Apply patch to ${entry.relativePath}`,
+				edits: entry.edits,
+			}, token);
+			if (!result.ok) {
+				return textResult(formatDirectorChatEditToolResult(result));
+			}
+			results.push(`${result.relativePath}: ${result.editCount} edit(s)`);
+		}
+
+		return textResult(`edit_result: success\nfiles: ${results.length}\n${results.join('\n')}\nreview: Chat Editing UI`);
+	}
+}
+
+export class DirectorCreateDirectoryTool extends DirectorEditToolBase {
+	constructor(
+		@IFileService fileService: IFileService,
+		@IChatService chatService: IChatService,
+		@IWorkspaceContextService workspaceContextService: IWorkspaceContextService,
+	) {
+		super(fileService, chatService, workspaceContextService);
+	}
+
+	async invoke(invocation: IToolInvocation, _countTokens: CountTokensCallback, _progress: ToolProgress, token: CancellationToken): Promise<IToolResult> {
+		const params = invocation.parameters as ToolParams;
+		const path = stringParam(params, 'dirPath') ?? stringParam(params, 'path');
+		if (!path) {
+			return textResult(formatDirectorChatEditToolResult({ ok: false, reason: 'dirPath is required.' }));
+		}
+
+		const binding = this.binding(invocation);
+		if (!binding.ok) {
+			return textResult(formatDirectorChatEditToolResult(binding));
+		}
+
+		const target = this.adapter.resolveWorkspaceTarget({ path });
+		if (!target.ok) {
+			return textResult(formatDirectorChatEditToolResult(target));
+		}
+		if (await this.fileService.exists(target.uri)) {
+			return textResult(formatDirectorChatEditToolResult({ ok: false, reason: `Target path already exists: ${target.relativePath}` }));
+		}
+
+		const transaction = createDirectorDirectoryCreationTransaction(target.uri, target.relativePath);
+		const review = await this.adapter.emitDirectoryCreationReview({
+			...binding,
+			path,
+			transactionId: transaction.id,
+			acceptCommandId: DirectorAcceptDirectoryCreationCommandId,
+			rejectCommandId: DirectorRejectDirectoryCreationCommandId,
+		}, token);
+		if (!review.ok) {
+			await rejectDirectorDirectoryCreationTransaction(transaction.id);
+			return textResult(formatDirectorChatEditToolResult(review));
+		}
+
+		const outcome = await raceCancellation(transaction.deferred.p, token, { status: 'cancelled', path: target.relativePath } satisfies DirectoryCreationOutcome);
+		if (outcome.status === 'accepted') {
+			return textResult(`edit_result: success\npath: ${outcome.path}\nreview: directory creation accepted`);
+		}
+		if (outcome.status === 'rejected') {
+			return textResult(`edit_result: rejected\npath: ${outcome.path}`);
+		}
+		if (outcome.status === 'cancelled') {
+			await rejectDirectorDirectoryCreationTransaction(transaction.id);
+			return textResult(`edit_result: cancelled\npath: ${outcome.path}`);
+		}
+		return textResult(formatDirectorChatEditToolResult({ ok: false, reason: outcome.message }));
+	}
+}
+
+function textResult(value: string): IToolResult {
+	return { content: [{ kind: 'text', value }] };
+}
+
+function stringParam(params: ToolParams, key: string): string | undefined {
+	const value = params[key];
+	return typeof value === 'string' ? value : undefined;
+}
+
+function booleanParam(params: ToolParams, key: string): boolean | undefined {
+	return typeof params[key] === 'boolean' ? params[key] as boolean : undefined;
+}
+
+function findOccurrences(text: string, needle: string): number[] {
+	const out: number[] = [];
+	let offset = 0;
+	while (offset <= text.length) {
+		const index = text.indexOf(needle, offset);
+		if (index === -1) {
+			break;
+		}
+		out.push(index);
+		offset = index + Math.max(needle.length, 1);
+	}
+	return out;
+}
+
+function firstOverlap(edits: readonly { readonly start: number; readonly end: number }[]): boolean {
+	const sorted = [...edits].sort((left, right) => left.start - right.start || left.end - right.end);
+	for (let index = 1; index < sorted.length; index++) {
+		if (sorted[index].start < sorted[index - 1].end) {
+			return true;
+		}
+	}
+	return false;
+}
+
+function emptyStartRange(): IRange {
+	return {
+		startLineNumber: 1,
+		startColumn: 1,
+		endLineNumber: 1,
+		endColumn: 1,
+	};
+}
+
+function rangeFromOffsets(text: string, start: number, end: number): IRange {
+	const startPosition = positionAt(text, start);
+	const endPosition = positionAt(text, end);
+	return {
+		startLineNumber: startPosition.lineNumber,
+		startColumn: startPosition.column,
+		endLineNumber: endPosition.lineNumber,
+		endColumn: endPosition.column,
+	};
+}
+
+function positionAt(text: string, offset: number): { readonly lineNumber: number; readonly column: number } {
+	const lineStarts = computeLineStarts(text);
+	let low = 0;
+	let high = lineStarts.length;
+	while (low < high) {
+		const mid = Math.floor((low + high) / 2);
+		if (lineStarts[mid] > offset) {
+			high = mid;
+		} else {
+			low = mid + 1;
+		}
+	}
+	const lineIndex = Math.max(0, low - 1);
+	return {
+		lineNumber: lineIndex + 1,
+		column: offset - lineStarts[lineIndex] + 1,
+	};
+}
+
+function computeLineStarts(text: string): number[] {
+	const starts = [0];
+	for (let index = 0; index < text.length; index++) {
+		if (text.charCodeAt(index) === 10) {
+			starts.push(index + 1);
+		}
+	}
+	return starts;
+}
+
+interface ParsedPatchLine {
+	readonly kind: 'context' | 'add' | 'remove';
+	readonly text: string;
+}
+
+interface ParsedPatchHunk {
+	readonly oldStart: number;
+	readonly oldLength: number;
+	readonly lines: readonly ParsedPatchLine[];
+}
+
+interface ParsedPatchFile {
+	readonly path: string;
+	readonly isNewFile: boolean;
+	readonly isDeletion: boolean;
+	readonly hunks: readonly ParsedPatchHunk[];
+}
+
+function parseUnifiedPatch(patchText: string, fallbackPath: string | undefined): { readonly ok: true; readonly files: readonly ParsedPatchFile[] } | { readonly ok: false; readonly reason: string } {
+	const lines = patchText.replace(/\r\n/g, '\n').replace(/\r/g, '\n').split('\n');
+	const files: ParsedPatchFile[] = [];
+	let oldPath: string | undefined;
+	let newPath: string | undefined;
+	let current: { path: string; isNewFile: boolean; isDeletion: boolean; hunks: ParsedPatchHunk[] } | undefined;
+
+	function ensureCurrent(): typeof current {
+		const path = newPath && newPath !== '/dev/null' ? newPath : fallbackPath;
+		if (!current) {
+			if (!path) {
+				return undefined;
+			}
+			current = {
+				path,
+				isNewFile: oldPath === '/dev/null',
+				isDeletion: newPath === '/dev/null',
+				hunks: [],
+			};
+		}
+		return current;
+	}
+
+	for (let index = 0; index < lines.length; index++) {
+		const line = lines[index];
+		if (line.startsWith('diff --git ')) {
+			if (current) {
+				files.push(current);
+			}
+			current = undefined;
+			oldPath = undefined;
+			newPath = undefined;
+			continue;
+		}
+		if (line.startsWith('--- ')) {
+			oldPath = cleanPatchPath(line.slice(4));
+			continue;
+		}
+		if (line.startsWith('+++ ')) {
+			newPath = cleanPatchPath(line.slice(4));
+			current = undefined;
+			continue;
+		}
+		if (!line.startsWith('@@ ')) {
+			continue;
+		}
+
+		const header = /^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@/.exec(line);
+		if (!header) {
+			return { ok: false, reason: `Unsupported unified diff hunk header: ${line}` };
+		}
+
+		const file = ensureCurrent();
+		if (!file) {
+			return { ok: false, reason: 'Patch hunk is missing a target path.' };
+		}
+
+		const hunkLines: ParsedPatchLine[] = [];
+		index++;
+		for (; index < lines.length; index++) {
+			const hunkLine = lines[index];
+			if (hunkLine.startsWith('diff --git ') || hunkLine.startsWith('--- ') || hunkLine.startsWith('@@ ')) {
+				index--;
+				break;
+			}
+			if (hunkLine.startsWith('\\ No newline')) {
+				continue;
+			}
+			if (hunkLine.startsWith('+')) {
+				hunkLines.push({ kind: 'add', text: hunkLine.slice(1) });
+			} else if (hunkLine.startsWith('-')) {
+				hunkLines.push({ kind: 'remove', text: hunkLine.slice(1) });
+			} else if (hunkLine.startsWith(' ')) {
+				hunkLines.push({ kind: 'context', text: hunkLine.slice(1) });
+			} else if (hunkLine === '') {
+				break;
+			} else {
+				return { ok: false, reason: `Unsupported unified diff line: ${hunkLine}` };
+			}
+		}
+
+		file.hunks.push({
+			oldStart: Number(header[1]),
+			oldLength: header[2] === undefined ? 1 : Number(header[2]),
+			lines: hunkLines,
+		});
+	}
+
+	if (current) {
+		files.push(current);
+	}
+
+	if (!files.length) {
+		return { ok: false, reason: 'Patch did not contain any supported file hunks.' };
+	}
+
+	return { ok: true, files };
+}
+
+function cleanPatchPath(raw: string): string {
+	const path = raw.trim().split(/\s+/)[0].replace(/^"|"$/g, '');
+	if (path === '/dev/null') {
+		return path;
+	}
+	return path.replace(/^[ab]\//, '');
+}
+
+function textForNewFilePatch(filePatch: ParsedPatchFile): string {
+	const eol = '\n';
+	const lines: string[] = [];
+	for (const hunk of filePatch.hunks) {
+		lines.push(...hunk.lines.filter(line => line.kind !== 'remove').map(line => line.text));
+	}
+	return lines.length ? `${lines.join(eol)}${eol}` : '';
+}
+
+function textEditsForPatch(text: string, filePatch: ParsedPatchFile): { readonly ok: true; readonly edits: readonly TextEdit[] } | { readonly ok: false; readonly reason: string } {
+	const eol = text.includes('\r\n') ? '\r\n' : '\n';
+	const edits: Array<TextEdit & { readonly start: number; readonly end: number }> = [];
+	for (const hunk of filePatch.hunks) {
+		const oldLines = hunk.lines.filter(line => line.kind !== 'add').map(line => line.text);
+		const newLines = hunk.lines.filter(line => line.kind !== 'remove').map(line => line.text);
+		const startLine = hunk.oldLength === 0 ? hunk.oldStart + 1 : hunk.oldStart;
+		const startOffset = offsetAtLine(text, startLine);
+		const endOffset = hunk.oldLength === 0 ? startOffset : offsetAtLine(text, hunk.oldStart + hunk.oldLength);
+		const actual = text.slice(startOffset, endOffset).replace(/\r\n/g, '\n').replace(/\r/g, '\n');
+		const expected = oldLines.join('\n');
+		if (actual !== expected && actual !== `${expected}\n`) {
+			return { ok: false, reason: `Patch hunk does not match the current file at line ${hunk.oldStart}.` };
+		}
+		const textEndsWithNewLine = actual.endsWith('\n') || hunk.oldLength === 0;
+		const replacement = newLines.length ? `${newLines.join(eol)}${textEndsWithNewLine ? eol : ''}` : '';
+		edits.push({
+			start: startOffset,
+			end: endOffset,
+			range: rangeFromOffsets(text, startOffset, endOffset),
+			text: replacement,
+		});
+	}
+
+	if (firstOverlap(edits)) {
+		return { ok: false, reason: 'Patch hunks overlap.' };
+	}
+
+	return { ok: true, edits };
+}
+
+function offsetAtLine(text: string, lineNumber: number): number {
+	if (lineNumber <= 1) {
+		return 0;
+	}
+	const starts = computeLineStarts(text);
+	if (lineNumber > starts.length) {
+		return text.length;
+	}
+	return starts[lineNumber - 1];
+}

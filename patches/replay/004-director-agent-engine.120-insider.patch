+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Director-Code Contributors. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { CancellationTokenSource } from '../../../../../base/common/cancellation.js';
+import { IHeaders } from '../../../../../base/parts/request/common/request.js';
+import { ISharedProcessService } from '../../../../../platform/ipc/electron-browser/services.js';
+import { asText, IRequestService } from '../../../../../platform/request/common/request.js';
+import { RequestChannelClient } from '../../../../../platform/request/common/requestIpc.js';
+
+export const DIRECTOR_NETWORK_REQUEST_CHANNEL = 'directorNetworkRequest';
+
+export interface IDirectorFetchOptions {
+	readonly timeoutMs?: number;
+	readonly callSite?: string;
+}
+
+export type DirectorFetch = (input: RequestInfo | URL, init?: RequestInit, options?: IDirectorFetchOptions) => Promise<Response>;
+
+export function createDirectorFetch(
+	sharedProcessService?: ISharedProcessService,
+	fallbackRequestService?: IRequestService,
+): DirectorFetch | undefined {
+	const requestService = sharedProcessService
+		? new RequestChannelClient(sharedProcessService.getChannel(DIRECTOR_NETWORK_REQUEST_CHANNEL))
+		: fallbackRequestService;
+	return requestService ? createDirectorFetchFromRequestService(requestService) : undefined;
+}
+
+export function createDirectorFetchFromRequestService(requestService: IRequestService): DirectorFetch {
+	return async (input: RequestInfo | URL, init: RequestInit = {}, options: IDirectorFetchOptions = {}) => {
+		const cts = new CancellationTokenSource();
+		const abort = () => cts.cancel();
+		if (init.signal?.aborted) {
+			abort();
+		} else {
+			init.signal?.addEventListener('abort', abort, { once: true });
+		}
+
+		try {
+			const context = await requestService.request({
+				type: init.method ?? requestMethodFromInput(input) ?? 'GET',
+				url: requestUrl(input),
+				headers: requestHeaders(input, init.headers),
+				data: requestBodyToString(init.body),
+				timeout: options.timeoutMs,
+				callSite: options.callSite ?? 'directorCode.network.fetch',
+			}, cts.token);
+
+			const body = await asText(context) ?? '';
+			const status = normalizeResponseStatus(context.res.statusCode);
+			return new Response(body, {
+				status,
+				statusText: '',
+				headers: responseHeaders(context.res.headers),
+			});
+		} finally {
+			init.signal?.removeEventListener('abort', abort);
+			cts.dispose(true);
+		}
+	};
+}
+
+function requestUrl(input: RequestInfo | URL): string {
+	if (typeof input === 'string') {
+		return input;
+	}
+	if (input instanceof URL) {
+		return input.toString();
+	}
+	return input.url;
+}
+
+function requestMethodFromInput(input: RequestInfo | URL): string | undefined {
+	return typeof Request !== 'undefined' && input instanceof Request ? input.method : undefined;
+}
+
+function requestHeaders(input: RequestInfo | URL, initHeaders: HeadersInit | undefined): IHeaders {
+	const headers: IHeaders = {};
+	appendHeaders(headers, typeof Request !== 'undefined' && input instanceof Request ? input.headers : undefined);
+	appendHeaders(headers, initHeaders);
+	return headers;
+}
+
+function appendHeaders(target: IHeaders, headers: HeadersInit | undefined): void {
+	if (!headers) {
+		return;
+	}
+	if (typeof Headers !== 'undefined' && headers instanceof Headers) {
+		headers.forEach((value, key) => target[key] = value);
+		return;
+	}
+	if (Array.isArray(headers)) {
+		for (const [key, value] of headers) {
+			target[key] = value;
+		}
+		return;
+	}
+	for (const [key, value] of Object.entries(headers)) {
+		if (typeof value === 'string') {
+			target[key] = value;
+		}
+	}
+}
+
+function requestBodyToString(body: BodyInit | null | undefined): string | undefined {
+	if (body === undefined || body === null) {
+		return undefined;
+	}
+	if (typeof body === 'string') {
+		return body;
+	}
+	if (typeof URLSearchParams !== 'undefined' && body instanceof URLSearchParams) {
+		return body.toString();
+	}
+	if (body instanceof ArrayBuffer) {
+		return new TextDecoder().decode(body);
+	}
+	throw new Error('Director network request only supports string, URLSearchParams, and ArrayBuffer request bodies.');
+}
+
+function responseHeaders(headers: IHeaders): Headers {
+	const result = new Headers();
+	for (const [key, value] of Object.entries(headers)) {
+		if (value === undefined) {
+			continue;
+		}
+		if (Array.isArray(value)) {
+			for (const entry of value) {
+				result.append(key, entry);
+			}
+		} else {
+			result.append(key, value);
+		}
+	}
+	return result;
+}
+
+function normalizeResponseStatus(status: number | undefined): number {
+	if (status && status >= 200 && status <= 599) {
+		return status;
+	}
+	return 200;
+}

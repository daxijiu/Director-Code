+import assert from 'assert';
+import { CancellationToken } from '../../../../../../base/common/cancellation.js';
+import { URI } from '../../../../../../base/common/uri.js';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../../base/test/common/utils.js';
+import { VSCodeToolBridge } from '../../../../directorCode/browser/agentEngine/toolBridge.js';
+import { ToolDataSource, type CountTokensCallback, type IToolData, type IToolInvocation, type IToolResult } from '../../../common/tools/languageModelToolsService.js';
+import { MockLanguageModelToolsService } from '../../common/tools/mockLanguageModelToolsService.js';
+
+suite('Director VSCodeToolBridge', () => {
+
+	const store = ensureNoDisposablesAreLeakedInTestSuite();
+
+	function tool(id: string, referenceName: string): IToolData {
+		return {
+			id,
+			toolReferenceName: referenceName,
+			displayName: referenceName,
+			modelDescription: `${referenceName} description`,
+			source: ToolDataSource.Internal,
+			inputSchema: {
+				type: 'object',
+				properties: {},
+			},
+		};
+	}
+
+	class CapturingToolsService extends MockLanguageModelToolsService {
+		public lastInvocation: IToolInvocation | undefined;
+
+		constructor(private readonly rawTools: IToolData[]) {
+			super();
+		}
+
+		override getTools(): Iterable<IToolData> {
+			return this.rawTools;
+		}
+
+		override async invokeTool(dto: IToolInvocation, _countTokens: CountTokensCallback, _token: CancellationToken): Promise<IToolResult> {
+			this.lastInvocation = dto;
+			return {
+				content: [{ kind: 'text', value: 'ok' }],
+			};
+		}
+	}
+
+	test('injects non-bypassable Director pre-approval for browser mutation tools', async () => {
+		const service = store.add(new CapturingToolsService([
+			tool('click_element', 'clickElement'),
+		]));
+		const bridge = new VSCodeToolBridge(service, URI.parse('chat-session://director/test'), 'request-1', CancellationToken.None);
+
+		const result = await bridge.invokeTool('clickElement', { pageId: 'page-1', element: 'button', ref: 'r1' });
+
+		assert.strictEqual(result, 'ok');
+		assert.strictEqual(service.lastInvocation?.toolId, 'click_element');
+		assert.strictEqual(service.lastInvocation?.preToolUseResult?.permissionDecision, 'ask');
+		assert.ok(/Director browser policy/.test(service.lastInvocation?.preToolUseResult?.permissionDecisionReason ?? ''));
+	});
+
+	test('injects Director session approval for browser page reads', async () => {
+		const service = store.add(new CapturingToolsService([
+			tool('read_page', 'readPage'),
+		]));
+		const bridge = new VSCodeToolBridge(service, URI.parse('chat-session://director/test'), 'request-1', CancellationToken.None);
+
+		await bridge.invokeTool('readPage', { pageId: 'page-1' });
+
+		assert.strictEqual(service.lastInvocation?.toolId, 'read_page');
+		assert.strictEqual(service.lastInvocation?.preToolUseResult?.permissionDecision, 'ask');
+		assert.ok(/reads or captures/.test(service.lastInvocation?.preToolUseResult?.permissionDecisionReason ?? ''));
+	});
+
+	test('does not add Director pre-approval to hover or Mermaid direct-reuse tools', async () => {
+		const service = store.add(new CapturingToolsService([
+			tool('hover_element', 'hoverElement'),
+			tool('renderMermaidDiagram', 'renderMermaidDiagram'),
+		]));
+		const bridge = new VSCodeToolBridge(service, URI.parse('chat-session://director/test'), 'request-1', CancellationToken.None);
+
+		assert.strictEqual(bridge.isReadOnlyTool('renderMermaidDiagram'), true);
+		assert.strictEqual(bridge.isReadOnlyTool('hoverElement'), false);
+
+		await bridge.invokeTool('hoverElement', { pageId: 'page-1', element: 'button', ref: 'r1' });
+		assert.strictEqual(service.lastInvocation?.preToolUseResult, undefined);
+
+		await bridge.invokeTool('renderMermaidDiagram', { markup: 'graph TD; A-->B;' });
+		assert.strictEqual(service.lastInvocation?.preToolUseResult, undefined);
+	});
+});

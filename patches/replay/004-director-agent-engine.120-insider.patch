+
+			assert.strictEqual(capturedBody.messages.some((m: any) => m.role === "assistant" && !m.content && !m.tool_calls), false);
+			assert.deepStrictEqual(capturedBody.messages.map((m: any) => m.role), ["system", "user", "user"]);
+		});
+
+		test("does not send reasoning_content by default", async () => {
+			let capturedBody: any = null;
+			mockFetch((_url, init) => {

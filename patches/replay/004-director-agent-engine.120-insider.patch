+
+	const widget = chatWidgetService.getWidgetBySessionResource(sessionResource);
+	widget?.input.setChatMode(ChatModeKind.Agent, false);
+	if (widget && !widget.getInput().trim()) {
+		widget.setInput(localize('directorCode.plan.revise.inputPrefix', "Revise the plan: "));
+	}
+	widget?.focusInput();
+});
+
+function resolvePlanExecutionModelId(chatService: IChatService, fallbackModelId: string | undefined, sessionResource: URI, sourceRequestId: string): string | undefined {
+	const sourceRequest = chatService.getSession(sessionResource)?.getRequests().find(candidate => candidate.id === sourceRequestId);
+	return sourceRequest?.modelId ?? fallbackModelId;
+}

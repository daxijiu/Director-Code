+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Director-Code Contributors. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import assert from 'assert';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../../base/test/common/utils.js';
+import { TestConfigurationService } from '../../../../../../platform/configuration/test/common/testConfigurationService.js';
+import {
+	createLegacyMigratedState,
+	getDefaultSelectionFromProviderRegistryState,
+	makeDirectorModelIdentifier,
+	normalizeDirectorProviderRegistryState,
+	parseDirectorModelIdentifier,
+	sanitizeProviderInstanceId,
+} from '../../../../directorCode/common/agentEngine/providerRegistry.js';
+import { syncDirectorProviderGroupProjection } from '../../../../directorCode/common/agentEngine/providerGroupProjection.js';
+import { OPENAI_CODEX_AUTH_VARIANT } from '../../../../directorCode/common/agentEngine/providers/providerTypes.js';
+import { Event } from '../../../../../../base/common/event.js';
+import { URI } from '../../../../../../base/common/uri.js';
+import type { ILanguageModelsConfigurationService, ILanguageModelsProviderGroup } from '../../../common/languageModelsConfiguration.js';
+
+suite('AgentEngine - ProviderRegistry', () => {
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	test('sanitizes provider instance ids for stable model identifiers', () => {
+		assert.strictEqual(sanitizeProviderInstanceId(' OpenAI Work/Profile '), 'openai-work-profile');
+		assert.strictEqual(makeDirectorModelIdentifier('OpenAI Work', 'gpt-4o'), 'director-code/openai-work/gpt-4o');
+		assert.deepStrictEqual(parseDirectorModelIdentifier('director-code/openai-work/gpt-4o'), {
+			providerInstanceId: 'openai-work',
+			modelId: 'gpt-4o',
+		});
+	});
+
+	test('creates a legacy API-key instance from old global settings', () => {
+		const config = new TestConfigurationService({
+			'directorCode.ai.provider': 'openai-compatible',
+			'directorCode.ai.model': 'deepseek-chat',
+			'directorCode.ai.baseURL': 'https://api.deepseek.com',
+			'directorCode.ai.authVariant': 'default',
+		});
+
+		const state = createLegacyMigratedState(config);
+		assert.strictEqual(state.instances.length, 1);
+		assert.strictEqual(state.instances[0].kind, 'openai-compatible');
+		assert.strictEqual(state.instances[0].authKind, 'api-key');
+		assert.strictEqual(state.instances[0].baseURL, 'https://api.deepseek.com');
+		assert.strictEqual(state.defaultModelId, 'deepseek-chat');
+		assert.ok(JSON.stringify(state).includes('deepseek-chat'));
+		assert.ok(!JSON.stringify(state).includes('sk-'));
+	});
+
+	test('creates a distinct OpenAI OAuth instance from old auth variant', () => {
+		const config = new TestConfigurationService({
+			'directorCode.ai.provider': 'openai',
+			'directorCode.ai.model': 'gpt-4o',
+			'directorCode.ai.authVariant': OPENAI_CODEX_AUTH_VARIANT,
+		});
+
+		const state = createLegacyMigratedState(config);
+		assert.strictEqual(state.instances[0].kind, 'openai');
+		assert.strictEqual(state.instances[0].authKind, 'oauth');
+		assert.strictEqual(state.instances[0].authVariant, OPENAI_CODEX_AUTH_VARIANT);
+		assert.strictEqual(state.defaultProviderId, 'openai-oauth');
+	});
+
+	test('normalizes hidden and disabled model entries without dropping the provider', () => {
+		const state = normalizeDirectorProviderRegistryState({
+			version: 1,
+			defaultProviderId: 'OpenAI Work',
+			instances: [{
+				id: 'OpenAI Work',
+				kind: 'openai',
+				displayName: 'OpenAI Work',
+				enabled: true,
+				authKind: 'api-key',
+				authVariant: 'default',
+				models: [
+					{ id: 'gpt-4o', hidden: true },
+					{ id: 'o3', enabled: false },
+				],
+			}],
+		});
+
+		assert.ok(state);
+		assert.strictEqual(state!.instances[0].id, 'openai-work');
+		assert.strictEqual(state!.instances[0].models[0].hidden, true);
+		assert.strictEqual(state!.instances[0].models[1].enabled, false);
+	});
+
+	test('drops persisted provider instances with unknown provider kind', () => {
+		const state = normalizeDirectorProviderRegistryState({
+			version: 1,
+			defaultProviderId: 'unknown',
+			instances: [{
+				id: 'unknown',
+				kind: 'made-up-provider',
+				displayName: 'Unknown',
+				enabled: true,
+				authKind: 'api-key',
+				authVariant: 'default',
+				models: [{ id: 'model-x' }],
+			}],
+		});
+
+		assert.ok(state);
+		assert.strictEqual(state!.instances.length, 0);
+		assert.strictEqual(state!.defaultProviderId, undefined);
+	});
+
+	test('normalizes empty model lists from catalog and keeps default selection aligned with picker fallback', () => {
+		const state = normalizeDirectorProviderRegistryState({
+			version: 1,
+			defaultProviderId: 'anthropic-api-key',
+			defaultModelId: 'claude-opus-4-6',
+			instances: [{
+				id: 'anthropic-api-key',
+				kind: 'anthropic',
+				displayName: 'Anthropic',
+				enabled: true,
+				authKind: 'api-key',
+				authVariant: 'default',
+				models: [],
+				defaultModelId: 'claude-opus-4-6',
+			}],
+		});
+
+		assert.ok(state);
+		assert.ok(state!.instances[0].models.some(model => model.id === 'claude-opus-4-6'));
+		assert.strictEqual(getDefaultSelectionFromProviderRegistryState(state!)?.modelId, 'claude-opus-4-6');
+	});
+
+	test('logs a warning when chatLanguageModels projection sync fails', async () => {
+		const registry = {
+			getProjectionGroups: async () => [{ name: 'Anthropic', providerInstanceId: 'anthropic-api-key' }],
+		} as any;
+		const languageModels = new class implements ILanguageModelsConfigurationService {
+			declare readonly _serviceBrand: undefined;
+			readonly configurationFile = URI.file('/profile/chatLanguageModels.json');
+			readonly onDidChangeLanguageModelGroups = Event.None;
+			getLanguageModelsProviderGroups(): readonly ILanguageModelsProviderGroup[] { return []; }
+			async addLanguageModelsProviderGroup(_languageModelsProviderGroup: ILanguageModelsProviderGroup): Promise<ILanguageModelsProviderGroup> { throw new Error('write failed'); }
+			async updateLanguageModelsProviderGroup(_from: ILanguageModelsProviderGroup, to: ILanguageModelsProviderGroup): Promise<ILanguageModelsProviderGroup> { return to; }
+			async removeLanguageModelsProviderGroup(_languageModelGroup: ILanguageModelsProviderGroup): Promise<void> { }
+			async configureLanguageModels(): Promise<void> { }
+		}();
+		const warnings: string[] = [];
+
+		const ok = await syncDirectorProviderGroupProjection(registry, languageModels, { warn: message => warnings.push(message) });
+
+		assert.strictEqual(ok, false);
+		assert.ok(warnings.some(message => message.includes('Failed to sync chatLanguageModels.json')));
+	});
+});

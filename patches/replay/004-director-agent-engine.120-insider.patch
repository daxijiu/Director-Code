+import { CountTokensCallback, IPreparedToolInvocation, IToolData, IToolImpl, IToolInvocation, IToolInvocationPreparationContext, IToolResult, ToolDataSource, ToolProgress } from '../../../chat/common/tools/languageModelToolsService.js';
+import { DIRECTOR_PRESENT_PLAN_TOOL_NAME, IDirectorPlanModeService } from './directorPlanMode.js';
+
+export const DirectorPresentPlanToolId = DIRECTOR_PRESENT_PLAN_TOOL_NAME;
+
+export const DirectorPresentPlanToolData: IToolData = {
+	id: DirectorPresentPlanToolId,
+	toolReferenceName: DIRECTOR_PRESENT_PLAN_TOOL_NAME,
+	displayName: 'Present Plan',
+	userDescription: 'Present a Director plan for user review.',
+	modelDescription: 'Present the completed Plan Mode proposal to the user. This is the only Plan Mode write path. It writes a workspace-local .director/plans/*.md file and returns review metadata. Keep planMarkdown to proposed steps only; do not include YAML frontmatter, Director plan metadata, or .director/plans targets.',
+	source: ToolDataSource.Internal,
+	runsInWorkspace: true,
+	canRequestPreApproval: false,
+	canRequestPostApproval: false,
+	inputSchema: {
+		type: 'object',
+		additionalProperties: false,
+		properties: {
+			title: { type: 'string', description: 'Short human-readable plan title.' },
+			summary: { type: 'string', description: 'Concise summary of the plan.' },
+			planMarkdown: { type: 'string', description: 'Markdown body for the Proposed Steps section only. Do not include frontmatter, Director plan metadata, or .director/plans targets.' },
+			feedbackSummary: { type: 'string', description: 'Optional summary of user feedback incorporated in this revision.' },
+			assumptions: { type: 'array', items: { type: 'string' }, description: 'Assumptions the plan depends on.' },
+			validation: { type: 'array', items: { type: 'string' }, description: 'Validation or test steps expected after execution.' },
+			risks: { type: 'array', items: { type: 'string' }, description: 'Risks or known tradeoffs.' },
+			openQuestions: { type: 'array', items: { type: 'string' }, description: 'Open questions for the user to answer through the review UI.' },
+		},
+		required: ['title', 'summary', 'planMarkdown'],
+	},
+};
+
+export class DirectorPresentPlanTool implements IToolImpl {
+	constructor(
+		@IDirectorPlanModeService private readonly planModeService: IDirectorPlanModeService,
+	) { }
+
+	async invoke(invocation: IToolInvocation, _countTokens: CountTokensCallback, _progress: ToolProgress, token: CancellationToken): Promise<IToolResult> {
+		if (!invocation.context?.sessionResource) {
+			return {
+				content: [{ kind: 'text', value: JSON.stringify({ ok: false, fatal: true, message: 'director_present_plan requires chat session context.' }) }],
+			};
+		}
+		const result = await this.planModeService.presentPlan(
+			invocation.context.sessionResource,
+			invocation.chatRequestId ?? '',
+			invocation.parameters,
+			token,
+		);
+		return {
+			content: [{ kind: 'text', value: JSON.stringify(result) }],
+		};
+	}
+
+	async prepareToolInvocation(_context: IToolInvocationPreparationContext, _token: CancellationToken): Promise<IPreparedToolInvocation | undefined> {
+		return {
+			invocationMessage: new MarkdownString('Presenting the plan for review'),
+			pastTenseMessage: new MarkdownString('Presented the plan for review'),
+		};
+	}
+}
+
+export const DirectorPlanToolData = [
+	DirectorPresentPlanToolData,
+] as const;

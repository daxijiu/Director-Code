+function makeTokenResponse(overrides: Record<string, any> = {}): object {
+	return {
+		access_token: 'at-test-token',
+		refresh_token: 'rt-test-token',
+		expires_in: 3600,
+		token_type: 'Bearer',
+		scope: 'api:read api:write',
+		...overrides,
+	};
+}
+
+function base64UrlJson(value: object): string {
+	const bytes = new TextEncoder().encode(JSON.stringify(value));
+	let binary = '';
+	for (const byte of bytes) {
+		binary += String.fromCharCode(byte);
+	}
+	return btoa(binary)
+		.replace(/\+/g, '-')
+		.replace(/\//g, '_')
+		.replace(/=+$/, '');
+}
+
+function makeJwt(payload: object): string {
+	return `${base64UrlJson({ alg: 'none', typ: 'JWT' })}.${base64UrlJson(payload)}.signature`;
+}
+
+function jsonResponse(body: object, status = 200): Response {
+	return new Response(JSON.stringify(body), {
+		status,
+		headers: { 'Content-Type': 'application/json' },
+	});
+}
+
+class MockOAuthCallbackChannel {
+	readonly startCalls: any[] = [];
+	readonly cancelCalls: any[] = [];
+	consumeResult: { readonly code?: string; readonly state?: string; readonly error?: string } | undefined;
+
+	async call<T>(command: string, arg?: any): Promise<T> {
+		switch (command) {
+			case 'start':
+				this.startCalls.push(arg);
+				return { redirectUri: 'http://localhost:1455/auth/callback' } as T;
+			case 'consume':
+				return this.consumeResult as T;
+			case 'cancel':
+				this.cancelCalls.push(arg);
+				return undefined as T;
+		}
+		throw new Error(`Unexpected OAuth callback command: ${command}`);
+	}
+}
+
+class MockNetworkRequestChannel {
+	readonly requests: any[] = [];
+	responses: Array<Response | Error> = [];
+
+	async call<T>(command: string, args?: any[]): Promise<T> {
+		if (command !== 'request') {
+			throw new Error(`Unexpected network command: ${command}`);
+		}
+		const options = args?.[0];
+		this.requests.push(options);
+		const next = this.responses.shift() ?? jsonResponse(makeTokenResponse());
+		if (next instanceof Error) {
+			throw next;
+		}
+		const text = await next.text();
+		const headers: Record<string, string> = {};
+		next.headers.forEach((value, key) => headers[key] = value);
+		return [{ statusCode: next.status, headers }, VSBuffer.fromString(text)] as T;
+	}
+}

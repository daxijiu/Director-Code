+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Director-Code Contributors. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { VSBuffer } from '../../../../../base/common/buffer.js';
+import { Emitter, Event } from '../../../../../base/common/event.js';
+import { Disposable } from '../../../../../base/common/lifecycle.js';
+import { createDecorator } from '../../../../../platform/instantiation/common/instantiation.js';
+import { IConfigurationService } from '../../../../../platform/configuration/common/configuration.js';
+import { IFileService } from '../../../../../platform/files/common/files.js';
+import { IUriIdentityService } from '../../../../../platform/uriIdentity/common/uriIdentity.js';
+import { IUserDataProfileService } from '../../../../services/userDataProfile/common/userDataProfile.js';
+import { DEFAULT_AUTH_VARIANT, OPENAI_CODEX_AUTH_VARIANT, type AuthVariantName, type ProviderCapabilities } from './providers/providerTypes.js';
+import { getDefaultModelForAuthVariant, getModelsForProviderAndAuthVariant, type IModelDefinition } from './modelCatalog.js';
+import { PROVIDER_DISPLAY_NAMES, SUPPORTED_PROVIDERS, type ProviderName } from './apiKeyService.js';
+
+export const DIRECTOR_PROVIDER_REGISTRY_FILE = 'directorCodeProviders.json';
+export const DIRECTOR_LANGUAGE_MODEL_VENDOR = 'director-code';
+
+const CONFIG_PROVIDER = 'directorCode.ai.provider';
+const CONFIG_MODEL = 'directorCode.ai.model';
+const CONFIG_BASE_URL = 'directorCode.ai.baseURL';
+const CONFIG_AUTH_VARIANT = 'directorCode.ai.authVariant';
+
+export type DirectorProviderAuthKind = 'api-key' | 'oauth';
+
+export interface IDirectorApiKeySource {
+	readonly kind: 'secret' | 'env';
+	readonly envVar?: string;
+}
+
+export interface IDirectorProviderModelEntry {
+	readonly id: string;
+	readonly displayName?: string;
+	readonly enabled?: boolean;
+	readonly hidden?: boolean;
+	readonly family?: string;
+	readonly maxInputTokens?: number;
+	readonly maxOutputTokens?: number;
+	readonly capabilities?: ProviderCapabilities;
+}
+
+export interface IDirectorProviderInstance {
+	readonly id: string;
+	readonly kind: ProviderName;
+	readonly displayName: string;
+	readonly enabled: boolean;
+	readonly authKind: DirectorProviderAuthKind;
+	readonly authVariant: AuthVariantName;
+	readonly baseURL?: string;
+	readonly headers?: Record<string, string>;
+	readonly apiKeySource?: IDirectorApiKeySource;
+	readonly models: readonly IDirectorProviderModelEntry[];
+	readonly defaultModelId?: string;
+	readonly createdAt: number;
+	readonly updatedAt: number;
+}
+
+export interface IDirectorProviderRegistryState {
+	readonly version: 1;
+	readonly instances: readonly IDirectorProviderInstance[];
+	readonly defaultProviderId?: string;
+	readonly defaultModelId?: string;
+	readonly migratedLegacy?: boolean;
+}
+
+export interface IDirectorProviderSelection {
+	readonly instance: IDirectorProviderInstance;
+	readonly modelId: string;
+}
+
+export interface IDirectorProviderProjectionGroup {
+	readonly name: string;
+	readonly providerInstanceId: string;
+}
+
+export const IDirectorProviderRegistryService = createDecorator<IDirectorProviderRegistryService>('directorCodeProviderRegistryService');
+
+export interface IDirectorProviderRegistryService {
+	readonly _serviceBrand: undefined;
+
+	readonly onDidChangeProviderRegistry: Event<IDirectorProviderRegistryState>;
+
+	getState(): Promise<IDirectorProviderRegistryState>;
+	saveState(state: IDirectorProviderRegistryState): Promise<void>;
+	upsertInstance(instance: IDirectorProviderInstance, defaultModelId?: string): Promise<IDirectorProviderRegistryState>;
+	removeInstance(instanceId: string): Promise<IDirectorProviderRegistryState>;
+	setDefault(instanceId: string, modelId: string): Promise<IDirectorProviderRegistryState>;
+	getDefaultSelection(): Promise<IDirectorProviderSelection | undefined>;
+	getInstance(instanceId: string): Promise<IDirectorProviderInstance | undefined>;
+	getProjectionGroups(): Promise<readonly IDirectorProviderProjectionGroup[]>;
+}
+
+export function sanitizeProviderInstanceId(value: string): string {
+	const sanitized = value
+		.trim()
+		.toLowerCase()
+		.replace(/[^a-z0-9._-]+/g, '-')
+		.replace(/^-+|-+$/g, '')
+		.slice(0, 80);
+	return sanitized || 'provider';
+}
+
+export function makeDirectorModelIdentifier(instanceId: string, modelId: string): string {
+	return `${DIRECTOR_LANGUAGE_MODEL_VENDOR}/${sanitizeProviderInstanceId(instanceId)}/${modelId}`;
+}
+
+export function parseDirectorModelIdentifier(identifier: string): { providerInstanceId: string; modelId: string } | undefined {
+	const prefix = `${DIRECTOR_LANGUAGE_MODEL_VENDOR}/`;
+	if (!identifier.startsWith(prefix)) {
+		return undefined;
+	}
+	const rest = identifier.slice(prefix.length);
+	const slash = rest.indexOf('/');
+	if (slash < 1) {
+		return undefined;
+	}
+	return {
+		providerInstanceId: rest.slice(0, slash),
+		modelId: rest.slice(slash + 1),
+	};
+}
+
+export function normalizeDirectorProviderRegistryState(value: unknown): IDirectorProviderRegistryState | undefined {
+	if (!value || typeof value !== 'object') {
+		return undefined;
+	}
+	const raw = value as Partial<IDirectorProviderRegistryState>;
+	if (raw.version !== 1 || !Array.isArray(raw.instances)) {
+		return undefined;
+	}
+
+	const instances = raw.instances
+		.map(normalizeInstance)
+		.filter((instance): instance is IDirectorProviderInstance => !!instance);
+	const defaultProviderId = typeof raw.defaultProviderId === 'string'
+		? sanitizeProviderInstanceId(raw.defaultProviderId)
+		: undefined;
+	const defaultInstance = instances.find(instance => instance.id === defaultProviderId) ?? instances[0];
+
+	return {
+		version: 1,
+		instances,
+		defaultProviderId: defaultInstance?.id,
+		defaultModelId: typeof raw.defaultModelId === 'string' ? raw.defaultModelId : defaultInstance?.defaultModelId,
+		migratedLegacy: raw.migratedLegacy === true,
+	};
+}
+
+function normalizeInstance(value: unknown): IDirectorProviderInstance | undefined {
+	if (!value || typeof value !== 'object') {
+		return undefined;
+	}
+	const raw = value as Partial<IDirectorProviderInstance>;
+	if (typeof raw.id !== 'string' || typeof raw.kind !== 'string') {
+		return undefined;
+	}
+	const id = sanitizeProviderInstanceId(raw.id);
+	const kind = normalizeProviderName(raw.kind);
+	if (!kind) {
+		return undefined;
+	}
+	const authVariant = normalizeRegistryAuthVariant(kind, raw.authVariant);
+	const authKind = raw.authKind === 'oauth' ? 'oauth' : 'api-key';
+	const normalizedModels = Array.isArray(raw.models)
+		? raw.models
+			.map(normalizeModelEntry)
+			.filter((model): model is IDirectorProviderModelEntry => !!model)
+		: [];
+	const defaultModelId = typeof raw.defaultModelId === 'string' && raw.defaultModelId.trim() ? raw.defaultModelId.trim() : normalizedModels[0]?.id;
+	const models = normalizedModels.length
+		? normalizedModels
+		: modelEntriesFromCatalog(kind, authVariant, defaultModelId);
+	const now = Date.now();
+	return {
+		id,
+		kind,
+		displayName: typeof raw.displayName === 'string' && raw.displayName.trim() ? raw.displayName.trim() : PROVIDER_DISPLAY_NAMES[kind] || id,
+		enabled: raw.enabled !== false,
+		authKind,
+		authVariant,
+		baseURL: typeof raw.baseURL === 'string' && raw.baseURL.trim() ? raw.baseURL.trim() : undefined,
+		headers: normalizeHeaders(raw.headers),
+		apiKeySource: normalizeApiKeySource(raw.apiKeySource),
+		models,
+		defaultModelId: defaultModelId ?? models[0]?.id,
+		createdAt: typeof raw.createdAt === 'number' ? raw.createdAt : now,
+		updatedAt: typeof raw.updatedAt === 'number' ? raw.updatedAt : now,
+	};
+}
+
+function normalizeProviderName(value: string): ProviderName | undefined {
+	return SUPPORTED_PROVIDERS.find(candidate => candidate === value);
+}
+
+function normalizeHeaders(value: unknown): Record<string, string> | undefined {
+	if (!value || typeof value !== 'object') {
+		return undefined;
+	}
+	const result: Record<string, string> = {};
+	for (const [key, rawValue] of Object.entries(value as Record<string, unknown>)) {
+		if (typeof rawValue === 'string' && key.trim() && rawValue.trim()) {
+			result[key.trim()] = rawValue.trim();
+		}
+	}
+	return Object.keys(result).length ? result : undefined;
+}
+
+function normalizeModelEntry(value: unknown): IDirectorProviderModelEntry | undefined {
+	if (!value || typeof value !== 'object') {
+		return undefined;
+	}
+	const raw = value as Partial<IDirectorProviderModelEntry>;
+	if (typeof raw.id !== 'string' || !raw.id.trim()) {
+		return undefined;
+	}
+	return {
+		id: raw.id.trim(),
+		displayName: typeof raw.displayName === 'string' && raw.displayName.trim() ? raw.displayName.trim() : undefined,
+		enabled: raw.enabled !== false,
+		hidden: raw.hidden === true,
+		family: typeof raw.family === 'string' && raw.family.trim() ? raw.family.trim() : undefined,
+		maxInputTokens: typeof raw.maxInputTokens === 'number' ? raw.maxInputTokens : undefined,
+		maxOutputTokens: typeof raw.maxOutputTokens === 'number' ? raw.maxOutputTokens : undefined,
+		capabilities: raw.capabilities,
+	};
+}
+
+function normalizeApiKeySource(value: unknown): IDirectorApiKeySource | undefined {
+	if (!value || typeof value !== 'object') {
+		return { kind: 'secret' };
+	}
+	const raw = value as Partial<IDirectorApiKeySource>;
+	if (raw.kind === 'env') {
+		return {
+			kind: 'env',
+			envVar: typeof raw.envVar === 'string' ? raw.envVar.trim() : '',
+		};
+	}
+	return { kind: 'secret' };
+}
+
+export function normalizeRegistryAuthVariant(provider: ProviderName, value: string | undefined): AuthVariantName {
+	return provider === 'openai' && value === OPENAI_CODEX_AUTH_VARIANT
+		? OPENAI_CODEX_AUTH_VARIANT
+		: DEFAULT_AUTH_VARIANT;
+}
+
+export function providerInstanceToProjectionGroup(instance: IDirectorProviderInstance, usedNames: Set<string>): IDirectorProviderProjectionGroup {
+	let name = instance.displayName || instance.id;
+	if (usedNames.has(name)) {
+		name = `${name} (${instance.id})`;
+	}
+	usedNames.add(name);
+	return {
+		name,
+		providerInstanceId: instance.id,
+	};
+}
+
+export function getDefaultSelectionFromProviderRegistryState(state: IDirectorProviderRegistryState): IDirectorProviderSelection | undefined {
+	const enabled = state.instances.filter(instance => instance.enabled);
+	const instance = enabled.find(candidate => candidate.id === state.defaultProviderId) ?? enabled[0];
+	if (!instance) {
+		return undefined;
+	}
+	const preferredModelId = state.defaultProviderId === instance.id && state.defaultModelId
+		? state.defaultModelId
+		: instance.defaultModelId;
+	const models = instance.models.length
+		? instance.models
+		: modelEntriesFromCatalog(instance.kind, instance.authVariant, preferredModelId);
+	const model = preferredModelId && models.some(candidate => candidate.id === preferredModelId && candidate.enabled !== false)
+		? preferredModelId
+		: models.find(candidate => candidate.enabled !== false)?.id;
+	if (!model) {
+		return undefined;
+	}
+	return { instance, modelId: model };
+}
+
+export function modelEntriesFromCatalog(provider: ProviderName, authVariant: AuthVariantName, extraModelId?: string): readonly IDirectorProviderModelEntry[] {
+	const models = new Map<string, IDirectorProviderModelEntry>();
+	for (const model of getModelsForProviderAndAuthVariant(provider, authVariant)) {
+		models.set(model.id, modelDefinitionToRegistryModel(model));
+	}
+	if (extraModelId && !models.has(extraModelId)) {
+		models.set(extraModelId, {
+			id: extraModelId,
+			displayName: extraModelId,
+			enabled: true,
+			hidden: false,
+			family: 'custom',
+			maxInputTokens: 0,
+			maxOutputTokens: 0,
+		});
+	}
+	return Array.from(models.values());
+}
+
+export function modelDefinitionToRegistryModel(model: IModelDefinition): IDirectorProviderModelEntry {
+	return {
+		id: model.id,
+		displayName: model.name,
+		enabled: true,
+		hidden: false,
+		family: model.family,
+		maxInputTokens: model.maxInputTokens,
+		maxOutputTokens: model.maxOutputTokens,
+		capabilities: model.capabilities,
+	};
+}
+
+export class DirectorProviderRegistryService extends Disposable implements IDirectorProviderRegistryService {
+	declare readonly _serviceBrand: undefined;
+
+	private readonly registryFile;
+	private readonly _onDidChangeProviderRegistry = this._register(new Emitter<IDirectorProviderRegistryState>());
+	readonly onDidChangeProviderRegistry: Event<IDirectorProviderRegistryState> = this._onDidChangeProviderRegistry.event;
+
+	private statePromise: Promise<IDirectorProviderRegistryState> | undefined;
+
+	constructor(
+		@IFileService private readonly fileService: IFileService,
+		@IUserDataProfileService userDataProfileService: IUserDataProfileService,
+		@IUriIdentityService uriIdentityService: IUriIdentityService,
+		@IConfigurationService private readonly configurationService: IConfigurationService,
+	) {
+		super();
+		this.registryFile = uriIdentityService.extUri.joinPath(userDataProfileService.currentProfile.location, DIRECTOR_PROVIDER_REGISTRY_FILE);
+		this._register(this.fileService.watch(this.registryFile));
+		this._register(this.fileService.onDidFilesChange(e => {
+			if (e.contains(this.registryFile)) {
+				this.statePromise = undefined;
+				void this.getState().then(state => this._onDidChangeProviderRegistry.fire(state));
+			}
+		}));
+	}
+
+	async getState(): Promise<IDirectorProviderRegistryState> {
+		if (!this.statePromise) {
+			this.statePromise = this.readState();
+		}
+		return this.statePromise;
+	}
+
+	async saveState(state: IDirectorProviderRegistryState): Promise<void> {
+		const normalized = normalizeDirectorProviderRegistryState(state) ?? createEmptyState();
+		this.statePromise = Promise.resolve(normalized);
+		await this.fileService.writeFile(this.registryFile, VSBuffer.fromString(JSON.stringify(normalized, undefined, '\t')));
+		this._onDidChangeProviderRegistry.fire(normalized);
+	}
+
+	async upsertInstance(instance: IDirectorProviderInstance, defaultModelId?: string): Promise<IDirectorProviderRegistryState> {
+		const state = await this.getState();
+		const normalizedInstance = normalizeInstance({ ...instance, updatedAt: Date.now() });
+		if (!normalizedInstance) {
+			throw new Error('Invalid Director provider instance.');
+		}
+		const instances = state.instances.filter(existing => existing.id !== normalizedInstance.id);
+		instances.push(normalizedInstance);
+		const next: IDirectorProviderRegistryState = {
+			version: 1,
+			instances,
+			defaultProviderId: state.defaultProviderId ?? normalizedInstance.id,
+			defaultModelId: defaultModelId ?? state.defaultModelId ?? normalizedInstance.defaultModelId,
+			migratedLegacy: state.migratedLegacy,
+		};
+		await this.saveState(next);
+		return next;
+	}
+
+	async removeInstance(instanceId: string): Promise<IDirectorProviderRegistryState> {
+		const state = await this.getState();
+		const sanitizedId = sanitizeProviderInstanceId(instanceId);
+		const instances = state.instances.filter(instance => instance.id !== sanitizedId);
+		const fallback = instances[0];
+		const next: IDirectorProviderRegistryState = {
+			version: 1,
+			instances,
+			defaultProviderId: state.defaultProviderId === sanitizedId ? fallback?.id : state.defaultProviderId,
+			defaultModelId: state.defaultProviderId === sanitizedId ? fallback?.defaultModelId : state.defaultModelId,
+			migratedLegacy: state.migratedLegacy,
+		};
+		await this.saveState(next);
+		return next;
+	}
+
+	async setDefault(instanceId: string, modelId: string): Promise<IDirectorProviderRegistryState> {
+		const state = await this.getState();
+		const sanitizedId = sanitizeProviderInstanceId(instanceId);
+		if (!state.instances.some(instance => instance.id === sanitizedId)) {
+			throw new Error(`Director provider instance "${sanitizedId}" does not exist.`);
+		}
+		const next: IDirectorProviderRegistryState = {
+			...state,
+			defaultProviderId: sanitizedId,
+			defaultModelId: modelId,
+		};
+		await this.saveState(next);
+		return next;
+	}
+
+	async getDefaultSelection(): Promise<IDirectorProviderSelection | undefined> {
+		const state = await this.getState();
+		return getDefaultSelectionFromProviderRegistryState(state);
+	}
+
+	async getInstance(instanceId: string): Promise<IDirectorProviderInstance | undefined> {
+		const state = await this.getState();
+		const sanitizedId = sanitizeProviderInstanceId(instanceId);
+		return state.instances.find(instance => instance.id === sanitizedId);
+	}
+
+	async getProjectionGroups(): Promise<readonly IDirectorProviderProjectionGroup[]> {
+		const state = await this.getState();
+		const usedNames = new Set<string>();
+		return state.instances
+			.filter(instance => instance.enabled)
+			.map(instance => providerInstanceToProjectionGroup(instance, usedNames));
+	}
+
+	private async readState(): Promise<IDirectorProviderRegistryState> {
+		const exists = await this.fileService.exists(this.registryFile);
+		if (exists) {
+			const content = await this.fileService.readFile(this.registryFile);
+			const raw = content.value.toString();
+			try {
+				const state = normalizeDirectorProviderRegistryState(JSON.parse(raw));
+				if (state) {
+					return state.instances.length ? state : await this.ensureLegacyState(state);
+				}
+			} catch {
+				// Fall through to a legacy/default migration rather than blocking startup.
+			}
+		}
+		return this.ensureLegacyState(createEmptyState());
+	}
+
+	private async ensureLegacyState(existing: IDirectorProviderRegistryState): Promise<IDirectorProviderRegistryState> {
+		if (existing.instances.length) {
+			return existing;
+		}
+		const migrated = createLegacyMigratedState(this.configurationService);
+		await this.fileService.writeFile(this.registryFile, VSBuffer.fromString(JSON.stringify(migrated, undefined, '\t')));
+		return migrated;
+	}
+}
+
+function createEmptyState(): IDirectorProviderRegistryState {
+	return {
+		version: 1,
+		instances: [],
+	};
+}
+
+export function createLegacyMigratedState(configurationService: IConfigurationService): IDirectorProviderRegistryState {
+	const provider = normalizeProviderName(configurationService.getValue<string>(CONFIG_PROVIDER) || '') ?? 'anthropic';
+	const authVariant = normalizeRegistryAuthVariant(provider, configurationService.getValue<string>(CONFIG_AUTH_VARIANT));
+	const configuredModel = configurationService.getValue<string>(CONFIG_MODEL) || getDefaultModelForAuthVariant(provider, authVariant);
+	const defaultModelId = provider === 'openai' && authVariant === OPENAI_CODEX_AUTH_VARIANT
+		? getDefaultModelForAuthVariant(provider, OPENAI_CODEX_AUTH_VARIANT)
+		: configuredModel;
+	const now = Date.now();
+	const id = sanitizeProviderInstanceId(`${provider}-${authVariant === OPENAI_CODEX_AUTH_VARIANT ? 'oauth' : 'api-key'}`);
+	const instance: IDirectorProviderInstance = {
+		id,
+		kind: provider,
+		displayName: authVariant === OPENAI_CODEX_AUTH_VARIANT ? 'OpenAI OAuth' : PROVIDER_DISPLAY_NAMES[provider] || provider,
+		enabled: true,
+		authKind: authVariant === OPENAI_CODEX_AUTH_VARIANT ? 'oauth' : 'api-key',
+		authVariant,
+		baseURL: configurationService.getValue<string>(CONFIG_BASE_URL) || undefined,
+		headers: undefined,
+		apiKeySource: authVariant === OPENAI_CODEX_AUTH_VARIANT ? undefined : { kind: 'secret' },
+		models: modelEntriesFromCatalog(provider, authVariant, defaultModelId),
+		defaultModelId,
+		createdAt: now,
+		updatedAt: now,
+	};
+	return {
+		version: 1,
+		instances: [instance],
+		defaultProviderId: instance.id,
+		defaultModelId,
+		migratedLegacy: true,
+	};
+}

+
+	suite("Assistant History Persistence", () => {
+
+		test("thinking-only final turn is not persisted as assistant history", async () => {
+			const provider: LLMProvider = {
+				apiType: 'openai-completions',
+				capabilities: { streaming: true, thinking: true },
+				async createMessage() {
+					return {
+						content: [],
+						stopReason: 'end_turn',
+						usage: { input_tokens: 1, output_tokens: 1 },
+					};
+				},
+				async *createMessageStream() {
+					yield { type: 'thinking', thinking: 'hidden only' };
+					yield {
+						type: 'message_complete',
+						usage: { input_tokens: 1, output_tokens: 1 },
+						stopReason: 'end_turn',
+					};
+				},
+			};
+
+			const engine = new AgentEngine({
+				cwd: '.',
+				model: 'gpt-test',

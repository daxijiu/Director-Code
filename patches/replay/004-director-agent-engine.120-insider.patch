new file mode 100644
index 0000000000000000000000000000000000000000..14dab493a60b1b32748b2aa413dfd858566a0b20
--- /dev/null
+++ b/src/vs/workbench/contrib/directorCode/common/agentEngine/directorPlanMode.ts
@@ -0,0 +1,684 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Director-Code Contributors. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { VSBuffer } from '../../../../../base/common/buffer.js';
+import { CancellationToken } from '../../../../../base/common/cancellation.js';
+import { Emitter, Event } from '../../../../../base/common/event.js';
+import { MarkdownString } from '../../../../../base/common/htmlContent.js';
+import { Disposable } from '../../../../../base/common/lifecycle.js';
+import { dirname, joinPath, relativePath } from '../../../../../base/common/resources.js';
+import { URI } from '../../../../../base/common/uri.js';
+import { generateUuid } from '../../../../../base/common/uuid.js';
+import { IFileService } from '../../../../../platform/files/common/files.js';
+import { createDecorator } from '../../../../../platform/instantiation/common/instantiation.js';
+import { IWorkspaceContextService } from '../../../../../platform/workspace/common/workspace.js';
+
+export const DIRECTOR_PRESENT_PLAN_TOOL_NAME = 'director_present_plan';
+export const DIRECTOR_PLAN_EXECUTE_COMMAND_ID = 'director.plan.execute';
+export const DIRECTOR_PLAN_REJECT_COMMAND_ID = 'director.plan.reject';
+export const DIRECTOR_PLAN_REVISE_COMMAND_ID = 'director.plan.revise';
+export const DIRECTOR_PLAN_TOGGLE_COMMAND_ID = 'director.plan.toggleMode';
+
+export type DirectorPlanSessionPhase = 'inactive' | 'planning' | 'awaitingDecision' | 'executing' | 'rejected' | 'cancelled';
+export type DirectorPlanFileStatus = 'Draft' | 'Approved' | 'Rejected' | 'Cancelled';
+
+export interface DirectorPresentPlanInput {
+	readonly title: string;
+	readonly summary: string;
+	readonly planMarkdown: string;
+	readonly feedbackSummary?: string;
+	readonly assumptions: readonly string[];
+	readonly validation: readonly string[];
+	readonly risks: readonly string[];
+	readonly openQuestions: readonly string[];
+}
+
+export interface DirectorPlanRecord {
+	readonly planId: string;
+	readonly title: string;
+	readonly summary: string;
+	readonly planMarkdown: string;
+	readonly assumptions: readonly string[];
+	readonly validation: readonly string[];
+	readonly risks: readonly string[];
+	readonly openQuestions: readonly string[];
+	readonly feedbackHistory: readonly string[];
+	readonly created: string;
+	readonly updated: string;
+	readonly sourceSession: string;
+	readonly sourceRequest: string;
+	readonly workspaceRoot: string;
+	readonly planFile: string;
+	readonly planUri: URI;
+	readonly nonce: string;
+	readonly status: DirectorPlanFileStatus;
+	readonly statusReason: string;
+}
+
+export interface DirectorPlanSessionState {
+	readonly mode: 'agent' | 'plan';
+	readonly phase: DirectorPlanSessionPhase;
+	readonly activeRequestId?: string;
+	readonly activePlan?: DirectorPlanRecord;
+	readonly missingPresentPlanCorrections: number;
+	readonly invalidPresentPlanCorrections: number;
+}
+
+export interface DirectorPlanRequestContext {
+	readonly revisionOf?: DirectorPlanRecord;
+	readonly feedback?: string;
+}
+
+export interface DirectorPresentPlanResult {
+	readonly ok: boolean;
+	readonly plan?: DirectorPlanRecord;
+	readonly message: string;
+	readonly fatal?: boolean;
+}
+
+export const IDirectorPlanModeService = createDecorator<IDirectorPlanModeService>('directorPlanModeService');
+
+export interface IDirectorPlanModeService {
+	readonly _serviceBrand: undefined;
+	readonly onDidChangeSessionState: Event<URI>;
+
+	getSessionState(sessionResource: URI): DirectorPlanSessionState;
+	canUsePlanMode(): { readonly ok: true } | { readonly ok: false; readonly message: string };
+	enterPlanMode(sessionResource: URI): { readonly ok: true } | { readonly ok: false; readonly message: string };
+	cancelPlanMode(sessionResource: URI, reason: string, token?: CancellationToken): Promise<void>;
+	beginPlanRequest(sessionResource: URI, requestId: string, feedback?: string): DirectorPlanRequestContext | undefined;
+	recordMissingPresentPlan(sessionResource: URI): { readonly fatal: boolean; readonly message: string };
+	presentPlan(sessionResource: URI, requestId: string, input: unknown, token: CancellationToken): Promise<DirectorPresentPlanResult>;
+	getPlanForReview(sessionResource: URI, planId: string, nonce: string): DirectorPlanRecord | undefined;
+	prepareExecution(sessionResource: URI, planId: string, nonce: string): DirectorPlanRecord | undefined;
+	approvePlanForExecution(sessionResource: URI, planId: string, nonce: string, token?: CancellationToken): Promise<DirectorPlanRecord | undefined>;
+	restorePlanReview(sessionResource: URI, plan: DirectorPlanRecord, reason: string, token?: CancellationToken): Promise<DirectorPlanRecord | undefined>;
+	rejectPlan(sessionResource: URI, planId: string, nonce: string, reason: string, token?: CancellationToken): Promise<DirectorPlanRecord | undefined>;
+	beginRevision(sessionResource: URI, planId: string, nonce: string, feedback: string, token?: CancellationToken): Promise<DirectorPlanRecord | undefined>;
+}
+
+const DEFAULT_STATE: DirectorPlanSessionState = {
+	mode: 'agent',
+	phase: 'inactive',
+	missingPresentPlanCorrections: 0,
+	invalidPresentPlanCorrections: 0,
+};
+
+const ALLOWED_PRESENT_PLAN_KEYS = new Set([
+	'title',
+	'summary',
+	'planMarkdown',
+	'feedbackSummary',
+	'assumptions',
+	'validation',
+	'risks',
+	'openQuestions',
+]);
+
+const FORBIDDEN_PLAN_METADATA_KEYS = new Set([
+	'status',
+	'planid',
+	'created',
+	'updated',
+	'sourcesession',
+	'sourcerequest',
+	'workspaceroot',
+	'planfile',
+	'statusreason',
+	'cwd',
+	'targetpath',
+]);
+
+export class DirectorPlanModeService extends Disposable implements IDirectorPlanModeService {
+	declare readonly _serviceBrand: undefined;
+
+	private readonly sessions = new Map<string, DirectorPlanSessionState>();
+
+	private readonly _onDidChangeSessionState = this._register(new Emitter<URI>());
+	readonly onDidChangeSessionState: Event<URI> = this._onDidChangeSessionState.event;
+
+	constructor(
+		@IWorkspaceContextService private readonly workspaceContextService: IWorkspaceContextService,
+		@IFileService private readonly fileService: IFileService,
+	) {
+		super();
+	}
+
+	getSessionState(sessionResource: URI): DirectorPlanSessionState {
+		return this.sessions.get(sessionResource.toString()) ?? DEFAULT_STATE;
+	}
+
+	canUsePlanMode(): { readonly ok: true } | { readonly ok: false; readonly message: string } {
+		const workspace = this.workspaceContextService.getWorkspace();
+		if (workspace.folders.length === 0) {
+			return { ok: false, message: 'Plan Mode requires an open workspace folder.' };
+		}
+		return { ok: true };
+	}
+
+	enterPlanMode(sessionResource: URI): { readonly ok: true } | { readonly ok: false; readonly message: string } {
+		const readiness = this.canUsePlanMode();
+		if (!readiness.ok) {
+			return readiness;
+		}
+
+		this.setSessionState(sessionResource, {
+			...this.getSessionState(sessionResource),
+			mode: 'plan',
+			phase: this.getSessionState(sessionResource).phase === 'inactive' ? 'planning' : this.getSessionState(sessionResource).phase,
+		});
+		return { ok: true };
+	}
+
+	async cancelPlanMode(sessionResource: URI, reason: string, token: CancellationToken = CancellationToken.None): Promise<void> {
+		const state = this.getSessionState(sessionResource);
+		let activePlan = state.activePlan;
+		if (activePlan && activePlan.status === 'Draft') {
+			activePlan = await this.writePlanWithStatus(activePlan, 'Cancelled', reason, token);
+		}
+		this.setSessionState(sessionResource, {
+			mode: 'agent',
+			phase: 'cancelled',
+			activePlan,
+			missingPresentPlanCorrections: 0,
+			invalidPresentPlanCorrections: 0,
+		});
+	}
+
+	beginPlanRequest(sessionResource: URI, requestId: string, feedback?: string): DirectorPlanRequestContext | undefined {
+		const previous = this.getSessionState(sessionResource);
+		const revisionOf = previous.phase === 'awaitingDecision' ? previous.activePlan : undefined;
+		const revisionFeedback = revisionOf ? feedback : undefined;
+		const feedbackHistory = revisionFeedback ? [...(revisionOf?.feedbackHistory ?? []), revisionFeedback] : revisionOf?.feedbackHistory;
+		const activePlan = feedbackHistory && revisionOf
+			? { ...revisionOf, feedbackHistory, status: 'Draft' as const, statusReason: '' }
+			: revisionOf;
+
+		this.setSessionState(sessionResource, {
+			...previous,
+			mode: 'plan',
+			phase: 'planning',
+			activeRequestId: requestId,
+			activePlan,
+			missingPresentPlanCorrections: 0,
+			invalidPresentPlanCorrections: 0,
+		});
+
+		if (revisionOf || revisionFeedback) {
+			return { revisionOf, feedback: revisionFeedback };
+		}
+		return undefined;
+	}
+
+	recordMissingPresentPlan(sessionResource: URI): { readonly fatal: boolean; readonly message: string } {
+		const state = this.getSessionState(sessionResource);
+		const nextCount = state.missingPresentPlanCorrections + 1;
+		this.setSessionState(sessionResource, {
+			...state,
+			missingPresentPlanCorrections: nextCount,
+		});
+		if (nextCount > 1) {
+			return {
+				fatal: true,
+				message: 'Plan Mode ended without calling director_present_plan after one correction attempt.',
+			};
+		}
+		return {
+			fatal: false,
+			message: 'You are in Plan Mode. Update the plan and call director_present_plan before ending this turn. Do not answer with final markdown only.',
+		};
+	}
+
+	async presentPlan(sessionResource: URI, requestId: string, input: unknown, token: CancellationToken): Promise<DirectorPresentPlanResult> {
+		const state = this.getSessionState(sessionResource);
+		if (state.mode !== 'plan' || state.phase !== 'planning' || state.activeRequestId !== requestId) {
+			return {
+				ok: false,
+				fatal: true,
+				message: 'director_present_plan can only be used by the active Plan Mode request.',
+			};
+		}
+
+		const validation = validateDirectorPresentPlanInput(input);
+		if (!validation.ok) {
+			const nextCount = state.invalidPresentPlanCorrections + 1;
+			this.setSessionState(sessionResource, {
+				...state,
+				invalidPresentPlanCorrections: nextCount,
+			});
+			return {
+				ok: false,
+				fatal: false,
+				message: `Invalid director_present_plan input: ${validation.message}. Re-submit with the exact schema. Keep planMarkdown to the proposed steps only; do not include YAML frontmatter, Director plan metadata, or .director/plans targets.`,
+			};
+		}
+
+		const workspaceFolder = this.workspaceContextService.getWorkspace().folders[0];
+		if (!workspaceFolder) {
+			return {
+				ok: false,
+				fatal: true,
+				message: 'Plan Mode requires an open workspace folder.',
+			};
+		}
+
+		const previous = state.activePlan;
+		const now = new Date().toISOString();
+		const planId = previous?.planId ?? createPlanId(now);
+		const planFile = previous?.planFile ?? `.director/plans/${planId}-${slugify(validation.value.title)}.md`;
+		const planUri = previous?.planUri ?? joinPath(workspaceFolder.uri, planFile);
+		const plan: DirectorPlanRecord = {
+			planId,
+			title: validation.value.title,
+			summary: validation.value.summary,
+			planMarkdown: validation.value.planMarkdown,
+			assumptions: validation.value.assumptions,
+			validation: validation.value.validation,
+			risks: validation.value.risks,
+			openQuestions: validation.value.openQuestions,
+			feedbackHistory: validation.value.feedbackSummary
+				? [...(previous?.feedbackHistory ?? []), validation.value.feedbackSummary]
+				: previous?.feedbackHistory ?? [],
+			created: previous?.created ?? now,
+			updated: now,
+			sourceSession: sessionResource.toString(),
+			sourceRequest: requestId,
+			workspaceRoot: workspaceFolder.uri.fsPath,
+			planFile,
+			planUri,
+			nonce: generateUuid(),
+			status: 'Draft',
+			statusReason: '',
+		};
+
+		await this.writePlan(plan, token);
+		this.setSessionState(sessionResource, {
+			mode: 'plan',
+			phase: 'awaitingDecision',
+			activePlan: plan,
+			missingPresentPlanCorrections: 0,
+			invalidPresentPlanCorrections: 0,
+		});
+
+		return {
+			ok: true,
+			plan,
+			message: `Plan ${plan.planId} written to ${plan.planFile}.`,
+		};
+	}
+
+	getPlanForReview(sessionResource: URI, planId: string, nonce: string): DirectorPlanRecord | undefined {
+		const plan = this.getSessionState(sessionResource).activePlan;
+		if (!plan || plan.planId !== planId || plan.nonce !== nonce) {
+			return undefined;
+		}
+		return plan;
+	}
+
+	prepareExecution(sessionResource: URI, planId: string, nonce: string): DirectorPlanRecord | undefined {
+		const state = this.getSessionState(sessionResource);
+		if (state.phase !== 'awaitingDecision') {
+			return undefined;
+		}
+		return this.getPlanForReview(sessionResource, planId, nonce);
+	}
+
+	async approvePlanForExecution(sessionResource: URI, planId: string, nonce: string, token: CancellationToken = CancellationToken.None): Promise<DirectorPlanRecord | undefined> {
+		const plan = this.getPlanForReview(sessionResource, planId, nonce);
+		if (!plan) {
+			return undefined;
+		}
+		const updated = {
+			...plan,
+			status: 'Approved' as const,
+			statusReason: 'User approved execution.',
+			updated: new Date().toISOString(),
+		};
+		this.setSessionState(sessionResource, {
+			mode: 'agent',
+			phase: 'executing',
+			activePlan: updated,
+			missingPresentPlanCorrections: 0,
+			invalidPresentPlanCorrections: 0,
+		});
+		try {
+			await this.writePlan(updated, token);
+		} catch (error) {
+			this.setSessionState(sessionResource, {
+				mode: 'plan',
+				phase: 'awaitingDecision',
+				activePlan: plan,
+				missingPresentPlanCorrections: 0,
+				invalidPresentPlanCorrections: 0,
+			});
+			throw error;
+		}
+		return updated;
+	}
+
+	async restorePlanReview(sessionResource: URI, plan: DirectorPlanRecord, reason: string, token: CancellationToken = CancellationToken.None): Promise<DirectorPlanRecord | undefined> {
+		const state = this.getSessionState(sessionResource);
+		if (state.activePlan?.planId !== plan.planId || state.activePlan?.nonce !== plan.nonce) {
+			return undefined;
+		}
+		const updated = await this.writePlanWithStatus(plan, 'Draft', reason, token);
+		this.setSessionState(sessionResource, {
+			mode: 'plan',
+			phase: 'awaitingDecision',
+			activePlan: updated,
+			missingPresentPlanCorrections: 0,
+			invalidPresentPlanCorrections: 0,
+		});
+		return updated;
+	}
+
+	async rejectPlan(sessionResource: URI, planId: string, nonce: string, reason: string, token: CancellationToken = CancellationToken.None): Promise<DirectorPlanRecord | undefined> {
+		const plan = this.getPlanForReview(sessionResource, planId, nonce);
+		if (!plan) {
+			return undefined;
+		}
+		const updated = await this.writePlanWithStatus(plan, 'Rejected', reason, token);
+		this.setSessionState(sessionResource, {
+			mode: 'agent',
+			phase: 'rejected',
+			activePlan: updated,
+			missingPresentPlanCorrections: 0,
+			invalidPresentPlanCorrections: 0,
+		});
+		return updated;
+	}
+
+	async beginRevision(sessionResource: URI, planId: string, nonce: string, feedback: string, token: CancellationToken = CancellationToken.None): Promise<DirectorPlanRecord | undefined> {
+		const plan = this.getPlanForReview(sessionResource, planId, nonce);
+		if (!plan) {
+			return undefined;
+		}
+		const updated = await this.writePlanWithStatus({
+			...plan,
+			feedbackHistory: [...plan.feedbackHistory, feedback],
+			updated: new Date().toISOString(),
+		}, 'Draft', '', token);
+		this.setSessionState(sessionResource, {
+			mode: 'plan',
+			phase: 'planning',
+			activePlan: updated,
+			missingPresentPlanCorrections: 0,
+			invalidPresentPlanCorrections: 0,
+		});
+		return updated;
+	}
+
+	private async writePlanWithStatus(plan: DirectorPlanRecord, status: DirectorPlanFileStatus, statusReason: string, token: CancellationToken): Promise<DirectorPlanRecord> {
+		const updated = {
+			...plan,
+			status,
+			statusReason,
+			updated: new Date().toISOString(),
+		};
+		await this.writePlan(updated, token);
+		return updated;
+	}
+
+	private async writePlan(plan: DirectorPlanRecord, token: CancellationToken): Promise<void> {
+		const folder = dirname(plan.planUri);
+		await this.fileService.createFolder(folder);
+		await this.fileService.writeFile(plan.planUri, VSBuffer.fromString(renderDirectorPlanFile(plan)));
+		if (token.isCancellationRequested) {
+			throw new Error('Plan write was cancelled.');
+		}
+	}
+
+	private setSessionState(sessionResource: URI, state: DirectorPlanSessionState): void {
+		this.sessions.set(sessionResource.toString(), state);
+		this._onDidChangeSessionState.fire(sessionResource);
+	}
+}
+
+export function validateDirectorPresentPlanInput(input: unknown): { readonly ok: true; readonly value: DirectorPresentPlanInput } | { readonly ok: false; readonly message: string } {
+	if (!input || typeof input !== 'object' || Array.isArray(input)) {
+		return { ok: false, message: 'input must be an object' };
+	}
+	const value = input as Record<string, unknown>;
+	for (const key of Object.keys(value)) {
+		if (!ALLOWED_PRESENT_PLAN_KEYS.has(key)) {
+			return { ok: false, message: `unexpected field "${key}"` };
+		}
+	}
+
+	const title = stringField(value, 'title');
+	const summary = stringField(value, 'summary');
+	const planMarkdown = stringField(value, 'planMarkdown');
+	if (!title || !summary || !planMarkdown) {
+		return { ok: false, message: 'title, summary, and planMarkdown are required strings' };
+	}
+	if (hasForbiddenPlanMarkdownMetadata(planMarkdown)) {
+		return { ok: false, message: 'planMarkdown must not include frontmatter, Director plan metadata, or plan file targets' };
+	}
+
+	const assumptions = stringArrayField(value, 'assumptions');
+	const validation = stringArrayField(value, 'validation');
+	const risks = stringArrayField(value, 'risks');
+	const openQuestions = stringArrayField(value, 'openQuestions');
+	if (!assumptions.ok) { return assumptions; }
+	if (!validation.ok) { return validation; }
+	if (!risks.ok) { return risks; }
+	if (!openQuestions.ok) { return openQuestions; }
+
+	const feedbackSummary = value.feedbackSummary === undefined ? undefined : stringField(value, 'feedbackSummary');
+	if (value.feedbackSummary !== undefined && feedbackSummary === undefined) {
+		return { ok: false, message: 'feedbackSummary must be a string' };
+	}
+
+	return {
+		ok: true,
+		value: {
+			title,
+			summary,
+			planMarkdown,
+			feedbackSummary,
+			assumptions: assumptions.value,
+			validation: validation.value,
+			risks: risks.value,
+			openQuestions: openQuestions.value,
+		},
+	};
+}
+
+export function renderDirectorPlanFile(plan: DirectorPlanRecord): string {
+	const frontmatter = [
+		'---',
+		`status: ${plan.status}`,
+		`planId: ${yamlString(plan.planId)}`,
+		`created: ${yamlString(plan.created)}`,
+		`updated: ${yamlString(plan.updated)}`,
+		`sourceSession: ${yamlString(plan.sourceSession)}`,
+		`sourceRequest: ${yamlString(plan.sourceRequest)}`,
+		`workspaceRoot: ${yamlString(plan.workspaceRoot)}`,
+		`planFile: ${yamlString(plan.planFile)}`,
+		`statusReason: ${yamlString(plan.statusReason)}`,
+		'---',
+		'',
+	].join('\n');
+
+	return frontmatter + [
+		`# ${plan.title}`,
+		'',
+		'## Request',
+		`Source request: ${plan.sourceRequest}`,
+		'',
+		'## Summary',
+		plan.summary,
+		'',
+		'## Current Understanding',
+		'See the structured assumptions and proposed steps below.',
+		'',
+		'## Assumptions',
+		renderList(plan.assumptions),
+		'',
+		'## Open Questions',
+		renderList(plan.openQuestions),
+		'',
+		'## Proposed Steps',
+		plan.planMarkdown,
+		'',
+		'## Validation',
+		renderList(plan.validation),
+		'',
+		'## Risks',
+		renderList(plan.risks),
+		'',
+		'## Feedback History',
+		renderList(plan.feedbackHistory),
+		'',
+	].join('\n');
+}
+
+export function createDirectorPlanReviewMarkdown(plan: DirectorPlanRecord): MarkdownString {
+	const md = new MarkdownString(undefined, { isTrusted: false });
+	md.appendMarkdown([
+		`### ${escapeMarkdown(plan.title)}`,
+		'',
+		plan.summary,
+		'',
+		`Plan file: \`${plan.planFile}\``,
+		'',
+		plan.openQuestions.length > 0
+			? `Open questions:\n${plan.openQuestions.map(item => `- ${item}`).join('\n')}`
+			: '',
+	].filter(Boolean).join('\n'));
+	return md;
+}
+
+export function createDirectorPlanReviewContent(plan: DirectorPlanRecord): string {
+	return [
+		plan.summary,
+		'',
+		`Plan file: \`${plan.planFile}\``,
+		'',
+		'## Proposed Steps',
+		plan.planMarkdown,
+		'',
+		'## Assumptions',
+		renderList(plan.assumptions),
+		'',
+		'## Open Questions',
+		renderList(plan.openQuestions),
+		'',
+		'## Validation',
+		renderList(plan.validation),
+		'',
+		'## Risks',
+		renderList(plan.risks),
+	].join('\n');
+}
+
+export function createApprovedPlanExecutionPrompt(plan: DirectorPlanRecord): string {
+	return [
+		'Execute the approved Director plan below.',
+		'',
+		'Continue in full Agent mode. Use the existing conversation context, but do not expose Plan Mode restrictions.',
+		'Read or verify relevant files before editing, then implement the approved plan with normal Agent tools.',
+		'',
+		`Plan ID: ${plan.planId}`,
+		`Plan file: ${plan.planFile}`,
+		'',
+		renderDirectorPlanFile(plan),
+	].join('\n');
+}
+
+export function createPlanRevisionPrompt(plan: DirectorPlanRecord, feedback: string): string {
+	return [
+		'Revise the current Director plan using the feedback below.',
+		'',
+		`Plan ID: ${plan.planId}`,
+		`Plan file: ${plan.planFile}`,
+		'',
+		'Feedback:',
+		feedback,
+		'',
+		'Update the plan and call director_present_plan again. Do not edit project files.',
+	].join('\n');
+}
+
+export function createPlanModeUserPrompt(userMessage: string, context: DirectorPlanRequestContext | undefined): string {
+	if (!context?.revisionOf && !context?.feedback) {
+		return userMessage;
+	}
+	const parts = [
+		context.revisionOf
+			? `You are revising Director plan ${context.revisionOf.planId} at ${context.revisionOf.planFile}.`
+			: 'You are revising the active Director plan.',
+		context.feedback ? `User feedback:\n${context.feedback}` : undefined,
+		'Update the plan and call director_present_plan again. Do not edit project files.',
+		'',
+		`User request:\n${userMessage}`,
+	];
+	return parts.filter(Boolean).join('\n');
+}
+
+function hasForbiddenPlanMarkdownMetadata(planMarkdown: string): boolean {
+	const trimmed = planMarkdown.trimStart();
+	if (trimmed.startsWith('---')) {
+		return true;
+	}
+	if (/\.director[\\/]+plans[\\/]/i.test(planMarkdown)) {
+		return true;
+	}
+	const metadataLines = planMarkdown
+		.split(/\r?\n/)
+		.map(line => line.trim())
+		.filter(Boolean)
+		.slice(0, 12);
+	return metadataLines.some(line => {
+		const match = /^([A-Za-z][A-Za-z0-9_-]*)\s*:/.exec(line);
+		return !!match && FORBIDDEN_PLAN_METADATA_KEYS.has(match[1].toLowerCase());
+	});
+}
+
+function stringField(value: Record<string, unknown>, key: string): string | undefined {
+	const raw = value[key];
+	return typeof raw === 'string' && raw.trim() ? raw.trim() : undefined;
+}
+
+function stringArrayField(value: Record<string, unknown>, key: string): { readonly ok: true; readonly value: readonly string[] } | { readonly ok: false; readonly message: string } {
+	const raw = value[key];
+	if (raw === undefined) {
+		return { ok: true, value: [] };
+	}
+	if (!Array.isArray(raw) || !raw.every(item => typeof item === 'string')) {
+		return { ok: false, message: `${key} must be an array of strings` };
+	}
+	return { ok: true, value: raw.map(item => item.trim()).filter(Boolean) };
+}
+
+function createPlanId(nowIso: string): string {
+	const stamp = nowIso.replace(/[-:]/g, '').replace(/\.\d{3}Z$/, 'Z').replace('T', '-').replace('Z', '');
+	const short = generateUuid().replace(/-/g, '').slice(0, 8);
+	return `${stamp}-${short}`;
+}
+
+function slugify(title: string): string {
+	const slug = title.toLowerCase()
+		.replace(/[^a-z0-9]+/g, '-')
+		.replace(/^-+|-+$/g, '')
+		.slice(0, 48);
+	return slug || 'plan';
+}
+
+function yamlString(value: string): string {
+	return `"${value.replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"`;
+}
+
+function renderList(items: readonly string[]): string {
+	return items.length > 0 ? items.map(item => `- ${item}`).join('\n') : '- None';
+}
+
+function escapeMarkdown(value: string): string {
+	return value.replace(/([\\`*_{}[\]()#+\-.!|>])/g, '\\$1');
+}
+
+export function relativePlanFile(workspaceRoot: URI, planUri: URI): string {
+	return relativePath(workspaceRoot, planUri) ?? planUri.fsPath;
+}

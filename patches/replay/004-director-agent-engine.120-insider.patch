+async function toggleDirectorPlanMode(accessor: ServicesAccessor): Promise<void> {
+	const chatWidgetService = accessor.get(IChatWidgetService);
+	const planModeService = accessor.get(IDirectorPlanModeService);
+	const chatService = accessor.get(IChatService);
+	const notificationService = accessor.get(INotificationService);
+	const widget = chatWidgetService.lastFocusedWidget;
+	const sessionResource = widget?.viewModel?.sessionResource;
+	if (!sessionResource) {
+		return;
+	}
+
+	const state = planModeService.getSessionState(sessionResource);
+	if (state.mode === 'plan') {
+		await chatService.cancelCurrentRequestForSession(sessionResource, 'director-plan-mode-toggle');
+		await planModeService.cancelPlanMode(sessionResource, 'User switched back to Agent mode.');
+		notificationService.info(localize('directorCode.planMode.exited', "Director Plan Mode is off."));
+		return;
+	}
+
+	const entered = planModeService.enterPlanMode(sessionResource);
+	if (!entered.ok) {
+		notificationService.warn(entered.message);
+		return;
+	}
+	widget.input.setChatMode(ChatModeKind.Agent, false);
+	notificationService.info(localize('directorCode.planMode.entered', "Director Plan Mode is on. Send your next Agent message to produce a reviewable plan."));
+}

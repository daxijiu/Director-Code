+			}
+
+			assert.ok(secondCallMessages);
+			const assistant = secondCallMessages.find(message => message.role === 'assistant')!;
+			const toolUse = (assistant.content as any[]).find(block => block.type === 'tool_use');
+			assert.strictEqual(toolUse.thoughtSignature, 'gemini-signature-1');
+		});

+	const plan = await planModeService.rejectPlan(sessionResource, planId, nonce, 'User rejected the plan.');
+	if (!plan) {
+		notificationService.warn(localize('directorCode.plan.reject.missing', "This plan review is no longer active."));
+		return;
+	}
+	notificationService.info(localize('directorCode.plan.reject.done', "Plan rejected."));
+});

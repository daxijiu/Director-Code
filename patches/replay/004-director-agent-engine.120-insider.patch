+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Director-Code Contributors. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import assert from 'assert';
+import { URI } from '../../../../../../base/common/uri.js';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../../base/test/common/utils.js';
+import { Selection } from '../../../../../../editor/common/core/selection.js';
+import { ChatAgentLocation, ChatModeKind } from '../../../common/constants.js';
+import { DirectorToolMode } from '../../../../directorCode/common/agentEngine/directorToolRegistry.js';
+import { getDirectorModeMaxTurns, getDirectorModeSystemPrompt, getDirectorToolModeForRequest } from '../../../../directorCode/common/agentEngine/directorChatModeRouting.js';
+
+suite('Director Chat Mode Routing', () => {
+
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	test('maps chat modes to Director tool modes', () => {
+		assert.strictEqual(getDirectorToolModeForRequest({ location: ChatAgentLocation.Chat, modeKind: ChatModeKind.Ask }), DirectorToolMode.Ask);
+		assert.strictEqual(getDirectorToolModeForRequest({ location: ChatAgentLocation.Chat, modeKind: ChatModeKind.Edit }), DirectorToolMode.Edit);
+		assert.strictEqual(getDirectorToolModeForRequest({ location: ChatAgentLocation.Chat, modeKind: ChatModeKind.Agent }), DirectorToolMode.Agent);
+		assert.strictEqual(getDirectorToolModeForRequest({ location: ChatAgentLocation.Chat }), DirectorToolMode.Agent);
+	});
+
+	test('routes EditorInline requests to Inline even when the UI sends Ask mode', () => {
+		const mode = getDirectorToolModeForRequest({
+			location: ChatAgentLocation.EditorInline,
+			modeKind: ChatModeKind.Ask,
+			locationData: {
+				type: ChatAgentLocation.EditorInline,
+				id: 'editor',
+				document: URI.file('/workspace/file.ts'),
+				selection: new Selection(1, 1, 1, 5),
+				wholeRange: { startLineNumber: 1, startColumn: 1, endLineNumber: 1, endColumn: 5 },
+			},
+		});
+
+		assert.strictEqual(mode, DirectorToolMode.Inline);
+	});
+
+	test('uses bounded turns and mode-specific prompt guardrails', () => {
+		assert.strictEqual(getDirectorModeMaxTurns(25, DirectorToolMode.Inline), 1);
+		assert.strictEqual(getDirectorModeMaxTurns(25, DirectorToolMode.Ask), 6);
+		assert.strictEqual(getDirectorModeMaxTurns(25, DirectorToolMode.Agent), 25);
+		assert.strictEqual(getDirectorModeMaxTurns(25, DirectorToolMode.Plan), 25);
+		assert.ok(/Do not edit files/.test(getDirectorModeSystemPrompt(DirectorToolMode.Ask) ?? ''));
+		assert.ok(/reviewable edit tools/.test(getDirectorModeSystemPrompt(DirectorToolMode.Edit) ?? ''));
+		assert.ok(/exact replacement text/.test(getDirectorModeSystemPrompt(DirectorToolMode.Inline) ?? ''));
+		assert.ok(/director_present_plan/.test(getDirectorModeSystemPrompt(DirectorToolMode.Plan) ?? ''));
+		assert.strictEqual(getDirectorModeSystemPrompt(DirectorToolMode.Agent), undefined);
+	});
+});

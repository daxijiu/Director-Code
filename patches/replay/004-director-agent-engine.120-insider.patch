+
+import assert from 'assert';
+import { URI } from '../../../../../../base/common/uri.js';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../../base/test/common/utils.js';
+import { createApprovedPlanExecutionPrompt, createDirectorPlanReviewContent, renderDirectorPlanFile, validateDirectorPresentPlanInput, type DirectorPlanRecord } from '../../../../directorCode/common/agentEngine/directorPlanMode.js';
+
+suite('Director Plan Mode', () => {
+
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	test('validates director_present_plan input shape', () => {
+		const valid = validateDirectorPresentPlanInput({
+			title: 'Add plan mode',
+			summary: 'Implement the planning flow.',
+			planMarkdown: '1. Read files\n2. Implement changes',
+			assumptions: ['Workspace is open'],
+			validation: ['Run tests'],
+			risks: ['UI may need polish'],
+			openQuestions: ['None'],
+		});
+		assert.strictEqual(valid.ok, true);
+		if (valid.ok) {
+			assert.deepStrictEqual(valid.value.assumptions, ['Workspace is open']);
+		}
+
+		assert.strictEqual(validateDirectorPresentPlanInput({
+			title: 'Bad',
+			summary: 'Bad',
+			planMarkdown: '---\nstatus: Draft\n---\nDo work',
+		}).ok, false);
+		assert.strictEqual(validateDirectorPresentPlanInput({
+			title: 'Bad',
+			summary: 'Bad',
+			planMarkdown: 'Do work',
+			path: '.director/plans/foo.md',
+		}).ok, false);
+		assert.strictEqual(validateDirectorPresentPlanInput({
+			title: 'Specific files',
+			summary: 'Plan with ordinary prose labels.',
+			planMarkdown: '1. Inspect the failing path handling\n2. Root cause: keep metadata out of frontmatter only\n3. Update src/example.ts',
+		}).ok, true);
+	});
+
+	test('renders stable workspace-local plan file sections', () => {
+		const plan = samplePlan();
+		const content = renderDirectorPlanFile(plan);
+
+		assert.ok(content.startsWith('---\nstatus: Draft\n'));
+		assert.ok(content.includes('planId: "20260516-120000-abcd1234"'));
+		assert.ok(content.includes('workspaceRoot: "E:\\\\Projects\\\\Example"'));
+		assert.ok(content.includes('planFile: ".director/plans/20260516-120000-abcd1234-plan.md"'));
+		assert.ok(content.includes('## Proposed Steps\n1. Inspect files\n2. Implement'));
+		assert.ok(content.includes('## Feedback History\n- Use a smaller UI'));
+	});
+
+	test('approved execution prompt carries plan context into Agent mode', () => {
+		const prompt = createApprovedPlanExecutionPrompt(samplePlan());
+
+		assert.ok(prompt.includes('Execute the approved Director plan below.'));
+		assert.ok(prompt.includes('Continue in full Agent mode.'));
+		assert.ok(prompt.includes('Plan file: .director/plans/20260516-120000-abcd1234-plan.md'));
+		assert.ok(prompt.includes('## Proposed Steps'));
+	});
+
+	test('120 review content exposes plan sections without frontmatter', () => {
+		const content = createDirectorPlanReviewContent(samplePlan());
+
+		assert.ok(!content.startsWith('---'));
+		assert.ok(content.includes('Plan file: `.director/plans/20260516-120000-abcd1234-plan.md`'));
+		assert.ok(content.includes('## Proposed Steps\n1. Inspect files\n2. Implement'));
+		assert.ok(content.includes('## Validation\n- Run targeted tests'));
+		assert.ok(content.includes('## Risks\n- Button UI is minimal'));
+	});
+
+	function samplePlan(): DirectorPlanRecord {
+		return {
+			planId: '20260516-120000-abcd1234',
+			title: 'Plan Mode',
+			summary: 'Add a reviewable planning loop.',
+			planMarkdown: '1. Inspect files\n2. Implement',
+			assumptions: ['Workspace is open'],
+			validation: ['Run targeted tests'],
+			risks: ['Button UI is minimal'],
+			openQuestions: ['None'],
+			feedbackHistory: ['Use a smaller UI'],
+			created: '2026-05-16T12:00:00.000Z',
+			updated: '2026-05-16T12:00:10.000Z',
+			sourceSession: 'chat-session://director/test',
+			sourceRequest: 'request-1',
+			workspaceRoot: 'E:\\Projects\\Example',
+			planFile: '.director/plans/20260516-120000-abcd1234-plan.md',
+			planUri: URI.file('E:/Projects/Example/.director/plans/20260516-120000-abcd1234-plan.md'),
+			nonce: 'nonce-1',
+			status: 'Draft',
+			statusReason: '',
+		};
+	}
+});

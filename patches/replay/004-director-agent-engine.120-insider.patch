+// ============================================================================
+// DirectorCodeAgent
+// ============================================================================
+
+function missingAuthMessage(authState: IResolvedAuthState): string {
+	if (authState.authVariant === OPENAI_CODEX_AUTH_VARIANT) {
+		return 'No OpenAI Codex OAuth login found. Sign in under Director Code Settings > Subscription & Login.';
+	}
+	return `No API key configured for provider "${authState.provider}". Please set your API key in Director Code settings (Ctrl+Shift+P -> "Director Code: Open Settings").`;
+}
+
+function modelForAuthVariant(provider: ProviderName, modelId: string, authVariant: AuthVariantName): string {
+	if (provider === 'openai' && authVariant === OPENAI_CODEX_AUTH_VARIANT && !isOpenAICodexModel(modelId)) {
+		return getDefaultModelForAuthVariant(provider, OPENAI_CODEX_AUTH_VARIANT);
+	}
+	return modelId || getDefaultModelForAuthVariant(provider, authVariant);
+}
+
+export class DirectorCodeAgent extends Disposable implements IChatAgentImplementation {
+
+	private readonly _replaySnapshots = new Map<string, ReplaySnapshot>();
+	private readonly requestFetch: DirectorFetch | undefined;
+	private _chatServiceHooksRegistered = false;
+
+	constructor(
+		@IConfigurationService private readonly configService: IConfigurationService,
+		@IAuthStateService private readonly authStateService: IAuthStateService,
+		@ILanguageModelToolsService private readonly toolsService: ILanguageModelToolsService,
+		@IWorkspaceContextService private readonly workspaceService: IWorkspaceContextService,
+		@IInstantiationService private readonly instantiationService: IInstantiationService,
+		@IModelResolverService private readonly modelResolverService: IModelResolverService,
+		@ITextModelService private readonly textModelService: ITextModelService,
+		@IDirectorPlanModeService private readonly planModeService: IDirectorPlanModeService,
+		@IDirectorProviderRegistryService private readonly providerRegistryService: IDirectorProviderRegistryService,
+	) {
+		super();
+		this.requestFetch = this.instantiationService.invokeFunction(accessor => createDirectorFetch(
+			accessor.get(ISharedProcessService),
+			accessor.get(IRequestService),
+		));
+	}
+
+	async invoke(
+		request: IChatAgentRequest,
+		progress: (parts: IChatProgress[]) => void,
+		history: IChatAgentHistoryEntry[],
+		token: CancellationToken,
+	): Promise<IChatAgentResult> {
+		const startTime = Date.now();
+
+		try {
+			// 1. Resolve provider instance from the Director Provider Registry.
+			let selection = await this.providerRegistryService.getDefaultSelection();
+			if (!selection) {
+				return {
+					errorDetails: { message: 'No Director provider instance is configured.' },
+					timings: { totalElapsed: Date.now() - startTime },
+				};
+			}
+			let providerInstance: IDirectorProviderInstance = selection.instance;
+			let modelId = selection.modelId;
+			const configuredCompactModel = this.configService.getValue<string>(CONFIG_COMPACT_MODEL) || '';
+			const maxTurns = this.configService.getValue<number>(CONFIG_MAX_TURNS) || 25;
+			const maxTokens = this.configService.getValue<number>(CONFIG_MAX_TOKENS) || 8192;
+			const maxInputTokens = this.configService.getValue<number>(CONFIG_MAX_INPUT_TOKENS) || 0;
+			const modeKind = this.resolveRequestModeKind(request);
+			const routedDirectorMode = getDirectorToolModeForRequest({
+				location: request.location,
+				locationData: request.locationData,
+				modeKind,
+			});
+			const directorMode = routedDirectorMode === DirectorToolMode.Agent && this.planModeService.getSessionState(request.sessionResource).mode === 'plan'
+				? DirectorToolMode.Plan
+				: routedDirectorMode;
+			if (directorMode === DirectorToolMode.Plan) {
+				const readiness = this.planModeService.canUsePlanMode();
+				if (!readiness.ok) {
+					return {
+						errorDetails: { message: readiness.message },
+						timings: { totalElapsed: Date.now() - startTime },
+					};
+				}
+			}
+
+			// 1b. Override model if user selected one from the Chat UI model picker
+			if (request.userSelectedModelId) {
+				const parsed = parseDirectorModelIdentifier(request.userSelectedModelId);
+				if (parsed) {
+					const selectedInstance = await this.providerRegistryService.getInstance(parsed.providerInstanceId);
+					if (selectedInstance) {
+						providerInstance = selectedInstance;
+						modelId = parsed.modelId;
+					}
+				} else {
+					// Legacy identifier format: "director-code/<modelId>".
+					const shortId = request.userSelectedModelId.replace('director-code/', '');
+					const modelDef = findModelById(shortId);
+					if (modelDef) {
+						modelId = modelDef.id;
+						const state = await this.providerRegistryService.getState();
+						providerInstance = state.instances.find(instance => instance.enabled && instance.kind === modelDef.provider) ?? providerInstance;
+					}
+				}
+			}
+
+			// 2. Resolve auth state via the unified API-key/OAuth facade
+			const provider = providerInstance.kind;
+			const authVariant = normalizeAuthVariantForProvider(provider, providerInstance.authVariant);
+			modelId = modelForAuthVariant(provider, modelId, authVariant);
+			const resolved = await this.authStateService.resolveInstanceAuth(providerInstance, modelId);
+			if (resolved.source === 'missing' || !resolved.auth) {
+				return {
+					errorDetails: {
+						message: missingAuthMessage(resolved),
+					},
+					timings: { totalElapsed: Date.now() - startTime },
+				};
+			}
+
+			const availableModels = await this.modelResolverService.resolveModels(
+				provider,
+				resolved.accessToken ?? resolved.apiKey,
+				resolved.baseURL,
+				resolved.identityKey,
+				resolved.authVariant,
+			);
+			const normalizedBaseURL = normalizeModelResolverBaseURL(provider, resolved.baseURL, resolved.authVariant);
+			const compactModelResolution = resolveCompactModel({
+				provider,
+				authVariant: resolved.authVariant,
+				mainModel: modelId,
+				configuredCompactModel,
+				availableModels,
+				availabilityKeyForModel: compactModelId => createCompactModelAvailabilityKey(provider, normalizedBaseURL, resolved.identityKey, resolved.authVariant, compactModelId),
+			});
+
+			// 3. Create LLM provider with resolved options
+			const apiType = provider === 'openai' && resolved.authVariant === OPENAI_CODEX_AUTH_VARIANT
+				? 'openai-codex'
+				: providerToApiType(provider);
+			const llmProvider = createProvider(apiType, {
+				auth: resolved.auth,
+				baseURL: resolved.baseURL,
+				capabilities: resolved.capabilities,
+				headers: providerInstance.headers,
+				geminiKeyInUrl: this.configService.getValue<boolean>(CONFIG_GEMINI_KEY_IN_URL) === true,
+				fetch: this.requestFetch,
+			});
+
+			// 4. Set up tool bridge
+			await waitForAgentToolRegistryReady(this.toolsService, token);
+			if (token.isCancellationRequested) {
+				return {
+					metadata: { subtype: 'cancelled' },
+					timings: { totalElapsed: Date.now() - startTime },
+				};
+			}
+
+			const toolBridge = new VSCodeToolBridge(
+				this.toolsService,
+				request.sessionResource,
+				request.requestId,
+				token,
+				undefined,
+				directorMode,
+			);
+			const toolDefinitions = getAgentToolDefinitions(this.toolsService, undefined, directorMode);
+
+			// 5. Convert history to normalized messages
+			const richResponses = this.getRichResponses(request, history.length);
+			const historyMessages = historyToNormalizedMessages(history, richResponses, {
+				preserveThinking: apiType === 'openai-completions',
+			});
+			const replaySnapshot = this.getReplaySnapshot(request.sessionResource);
+			const previousMessages = this.shouldUseReplaySnapshot(historyMessages, history, richResponses, replaySnapshot, provider, modelId, apiType)
+				? replaySnapshot!.messages
+				: historyMessages;
+
+			// 6. Create AbortSignal from CancellationToken
+			const abortController = new AbortController();
+			const cancelListener = token.onCancellationRequested(() => {
+				abortController.abort();
+			});
+
+			// 7. Resolve workspace folder for cwd
+			const workspace = this.workspaceService.getWorkspace();
+			const cwd = workspace.folders.length > 0
+				? workspace.folders[0].uri.fsPath
+				: '.';
+
+			// 8. Create Agent Engine with conversation history
+			const config: AgentEngineConfig = {
+				cwd,
+				model: modelId,
+				provider: llmProvider,
+				tools: toolDefinitions,
+				systemPrompt: getDirectorModeSystemPrompt(directorMode),
+				appendSystemPrompt: request.modeInstructions?.content,
+				maxTurns: getDirectorModeMaxTurns(maxTurns, directorMode),
+				maxTokens,
+				maxInputTokens: maxInputTokens > 0 ? maxInputTokens : undefined,
+				compactModel: compactModelResolution.model,
+				compactModelUnavailableKey: compactModelResolution.unavailableKey,
+				abortSignal: abortController.signal,
+			};
+			const engine = new AgentEngine(config, toolBridge, previousMessages);
+
+			// 9. Run the agentic loop
+			const inlineContext = directorMode === DirectorToolMode.Inline
+				? await this.resolveInlineEditorContext(request, token)
+				: undefined;
+			if (directorMode === DirectorToolMode.Inline && !inlineContext) {
+				return {
+					errorDetails: {
+						message: 'Inline edit could not resolve the active editor document and selection.',
+					},
+					timings: { totalElapsed: Date.now() - startTime },
+				};
+			}
+			const planRequestContext = directorMode === DirectorToolMode.Plan
+				? this.planModeService.beginPlanRequest(request.sessionResource, request.requestId, request.message)
+				: undefined;
+			const baseUserMessage = inlineContext
+				? this.createInlineEditPrompt(request, inlineContext)
+				: requestToUserMessage(request);
+			const userMessage = directorMode === DirectorToolMode.Plan
+				? createPlanModeUserPrompt(baseUserMessage, planRequestContext)
+				: baseUserMessage;
+
+			try {
+				// 10. Run the agentic loop
+				let firstProgressSent = false;
+				let firstProgressTime: number | undefined;
+				let inlineResponseText = '';
+				let nextUserMessage = userMessage;
+
+				while (!token.isCancellationRequested) {
+					let restartPlanMessage: string | undefined;
+
+					for await (const event of engine.submitMessage(nextUserMessage)) {
+						if (token.isCancellationRequested) {
+							break;
+						}
+
+						if (directorMode === DirectorToolMode.Inline) {
+							inlineResponseText += this.extractEventText(event);
+						}
+
+						const progressParts = directorMode === DirectorToolMode.Inline
+							? []
+							: agentEventToProgress(event);
+						if (progressParts.length > 0) {
+							if (!firstProgressSent) {
+								firstProgressTime = Date.now() - startTime;
+								firstProgressSent = true;
+							}
+							progress(progressParts);
+						}
+
+						if (directorMode === DirectorToolMode.Plan && event.type === 'tool_result' && event.tool_name === DIRECTOR_PRESENT_PLAN_TOOL_NAME) {
+							const presentResult = this.parseDirectorPresentPlanResult(event.content);
+							if (presentResult?.ok) {
+								const plan = this.planModeService.getSessionState(request.sessionResource).activePlan;
+								if (!plan) {
+									return {
+										errorDetails: { message: 'Plan was presented, but the active plan record was not found.' },
+										timings: {
+											firstProgress: firstProgressTime,
+											totalElapsed: Date.now() - startTime,
+										},
+										metadata: { subtype: 'plan_missing_record' },
+									};
+								}
+								firstProgressTime ??= Date.now() - startTime;
+								firstProgressSent = true;
+								return this.reviewDirectorPlan(request, progress, plan, firstProgressTime, startTime, token);
+							}
+							if (presentResult?.fatal) {
+								return {
+									errorDetails: { message: presentResult.message },
+									timings: {
+										firstProgress: firstProgressTime,
+										totalElapsed: Date.now() - startTime,
+									},
+									metadata: { subtype: 'plan_present_invalid' },
+								};
+							}
+						}
+
+						// Handle final result event
+						if (event.type === 'result') {
+							const resultEvent = event as any;
+							if (resultEvent.subtype === 'error') {
+								return {
+									errorDetails: {
+										message: resultEvent.error || 'Agent encountered an error',
+									},
+									timings: {
+										firstProgress: firstProgressTime,
+										totalElapsed: Date.now() - startTime,
+									},
+									metadata: {
+										usage: resultEvent.usage,
+										cost: resultEvent.cost,
+										numTurns: resultEvent.numTurns,
+									},
+								};
+							}
+
+							if (directorMode === DirectorToolMode.Plan) {
+								const correction = this.planModeService.recordMissingPresentPlan(request.sessionResource);
+								if (correction.fatal) {
+									return {
+										errorDetails: { message: correction.message },
+										timings: {
+											firstProgress: firstProgressTime,
+											totalElapsed: Date.now() - startTime,
+										},
+										metadata: {
+											usage: resultEvent.usage,
+											cost: resultEvent.cost,
+											numTurns: resultEvent.numTurns,
+											subtype: 'plan_missing_present_tool',
+										},
+									};
+								}
+								restartPlanMessage = correction.message;
+								progress([{
+									kind: 'markdownContent',
+									content: new MarkdownString(correction.message),
+								}]);
+								break;
+							}
+
+							if (directorMode === DirectorToolMode.Inline && inlineContext) {
+								const replacement = parseDirectorInlineReplacement(inlineResponseText);
+								if (!replacement.ok) {
+									return {
+										errorDetails: { message: replacement.reason },
+										timings: {
+											firstProgress: firstProgressTime,
+											totalElapsed: Date.now() - startTime,
+										},
+										metadata: {
+											usage: resultEvent.usage,
+											cost: resultEvent.cost,
+											numTurns: resultEvent.numTurns,
+											subtype: 'inline_edit_parse_error',
+										},
+									};
+								}
+
+								const editAdapter = this.instantiationService.createInstance(DirectorChatEditingAdapter);
+								const editResult = await editAdapter.emitInlineTextEdit({
+									chatSessionResource: request.sessionResource,
+									chatRequestId: request.requestId,
+									targetUri: inlineContext.uri,
+									range: inlineContext.selection,
+									replacementText: replacement.text,
+								}, token);
+								if (!editResult.ok) {
+									return {
+										errorDetails: { message: editResult.reason },
+										timings: {
+											firstProgress: firstProgressTime,
+											totalElapsed: Date.now() - startTime,
+										},
+										metadata: {
+											usage: resultEvent.usage,
+											cost: resultEvent.cost,
+											numTurns: resultEvent.numTurns,
+											subtype: 'inline_edit_emit_error',
+										},
+									};
+								}
+
+								firstProgressTime ??= Date.now() - startTime;
+							}
+
+							return {
+								timings: {
+									firstProgress: firstProgressTime,
+									totalElapsed: Date.now() - startTime,
+								},
+								metadata: {
+									usage: resultEvent.usage,
+									cost: resultEvent.cost,
+									numTurns: resultEvent.numTurns,
+									subtype: resultEvent.subtype,
+								},
+							};
+						}
+					}
+
+					if (restartPlanMessage) {
+						nextUserMessage = restartPlanMessage;
+						continue;
+					}
+					break;
+				}
+			} finally {
+				cancelListener.dispose();
+				this.pushReplaySnapshot(request.sessionResource, engine.getMessages(), provider, modelId, apiType);
+			}
+
+			// [Director-Code] A2: explicit cancelled metadata — no errorDetails (avoids red error UI)
+			return {
+				metadata: { subtype: 'cancelled' },
+				timings: { totalElapsed: Date.now() - startTime },
+			};
+
+		} catch (err: any) {
+			return {
+				errorDetails: {
+					message: `Agent error: ${err.message || String(err)}`,
+				},
+				timings: { totalElapsed: Date.now() - startTime },
+			};
+		}
+	}
+
+	async provideFollowups(
+		_request: IChatAgentRequest,
+		result: IChatAgentResult,
+		_history: IChatAgentHistoryEntry[],
+		_token: CancellationToken,
+	): Promise<IChatFollowup[]> {
+		// If there was an error related to missing auth, suggest opening settings
+		if (result.errorDetails?.message?.includes('No API key') || result.errorDetails?.message?.includes('No OpenAI Codex OAuth')) {
+			return [{
+				kind: 'reply',
+				message: 'Open Director Code settings to configure authentication',
+				agentId: 'director-code',
+				title: 'Open Settings',
+			}];
+		}
+
+		// If the agent completed with max turns, suggest continuing
+		if (result.metadata?.subtype === 'error_max_turns') {
+			return [{
+				kind: 'reply',
+				message: 'Please continue where you left off.',
+				agentId: 'director-code',
+				title: 'Continue',
+			}];
+		}
+
+		return [];
+	}
+
+	private parseDirectorPresentPlanResult(content: string): DirectorPresentPlanResult | undefined {
+		try {
+			const value = JSON.parse(content) as DirectorPresentPlanResult;
+			if (typeof value?.ok === 'boolean' && typeof value.message === 'string') {
+				return value;
+			}
+		} catch {
+			// Ignore non-JSON tool results; the normal agent loop will continue.
+		}
+		return undefined;
+	}
+
+	private async reviewDirectorPlan(
+		request: IChatAgentRequest,
+		progress: (parts: IChatProgress[]) => void,
+		plan: DirectorPlanRecord,
+		firstProgressTime: number | undefined,
+		startTime: number,
+		token: CancellationToken,
+	): Promise<IChatAgentResult> {
+		const reviewData = new ChatPlanReviewData(
+			plan.title,
+			createDirectorPlanReviewContent(plan),
+			[{
+				id: DIRECTOR_PLAN_REVIEW_EXECUTE_ACTION_ID,
+				label: 'Execute',
+				description: 'Run this plan in Agent mode',
+				default: true,
+			}],
+			true,
+			undefined,
+			`director-plan-${plan.planId}-${plan.nonce}`,
+		);
+
+		progress([reviewData]);
+
+		const result = await raceCancellation(reviewData.completion.p, token);
+		if (!result || token.isCancellationRequested) {
+			return {
+				metadata: {
+					subtype: 'plan_review_cancelled',
+					planId: plan.planId,
+					planFile: plan.planFile,
+				},
+				timings: {
+					firstProgress: firstProgressTime,
+					totalElapsed: Date.now() - startTime,
+				},
+			};
+		}
+
+		if (result.rejected) {
+			const reason = result.feedback?.trim() || 'User rejected the plan.';
+			const rejectedPlan = await this.planModeService.rejectPlan(request.sessionResource, plan.planId, plan.nonce, reason, token);
+			if (!rejectedPlan) {
+				return this.planReviewMissingResult(firstProgressTime, startTime, 'plan_reject_missing');
+			}
+			return {
+				metadata: {
+					subtype: 'plan_rejected',
+					planId: rejectedPlan.planId,
+					planFile: rejectedPlan.planFile,
+				},
+				timings: {
+					firstProgress: firstProgressTime,
+					totalElapsed: Date.now() - startTime,
+				},
+			};
+		}
+
+		if (result.feedback?.trim() && result.actionId !== DIRECTOR_PLAN_REVIEW_EXECUTE_ACTION_ID) {
+			const revisedPlan = await this.planModeService.beginRevision(request.sessionResource, plan.planId, plan.nonce, result.feedback.trim(), token);
+			if (!revisedPlan) {
+				return this.planReviewMissingResult(firstProgressTime, startTime, 'plan_revision_missing');
+			}
+			const queued = await this.queueDirectorPlanRevision(request, revisedPlan, result);
+			if (!queued.ok) {
+				await this.planModeService.restorePlanReview(request.sessionResource, revisedPlan, `Revision did not start: ${queued.message}`, token);
+				return this.planReviewQueueFailedResult(firstProgressTime, startTime, queued.message, 'plan_revision_queue_rejected');
+			}
+			return {
+				metadata: {
+					subtype: 'plan_revision_queued',
+					planId: revisedPlan.planId,
+					planFile: revisedPlan.planFile,
+				},
+				timings: {
+					firstProgress: firstProgressTime,
+					totalElapsed: Date.now() - startTime,
+				},
+			};
+		}
+
+		const approvedPlan = await this.planModeService.approvePlanForExecution(request.sessionResource, plan.planId, plan.nonce, token);
+		if (!approvedPlan) {
+			return this.planReviewMissingResult(firstProgressTime, startTime, 'plan_execute_missing');
+		}
+		const queued = await this.queueDirectorPlanExecution(request, approvedPlan);
+		if (!queued.ok) {
+			await this.planModeService.restorePlanReview(request.sessionResource, approvedPlan, `Execution did not start: ${queued.message}`, token);
+			return this.planReviewQueueFailedResult(firstProgressTime, startTime, queued.message, 'plan_execution_queue_rejected');
+		}
+		return {
+			metadata: {
+				subtype: 'plan_execution_queued',
+				planId: approvedPlan.planId,
+				planFile: approvedPlan.planFile,
+			},
+			timings: {
+				firstProgress: firstProgressTime,
+				totalElapsed: Date.now() - startTime,
+			},
+		};
+	}
+
+	private async queueDirectorPlanExecution(request: IChatAgentRequest, plan: DirectorPlanRecord): Promise<{ readonly ok: true } | { readonly ok: false; readonly message: string }> {
+		const chatService = this.getChatService();
+		if (!chatService) {
+			return { ok: false, message: 'Chat service is not available.' };
+		}
+		const result = await chatService.sendRequest(request.sessionResource, createApprovedPlanExecutionPrompt(plan), {
+			agentIdSilent: AGENT_ID,
+			modeInfo: AGENT_MODE_INFO,
+			userSelectedModelId: request.userSelectedModelId,
+			location: ChatAgentLocation.Chat,
+			queue: ChatRequestQueueKind.Queued,
+			isSystemInitiated: true,
+			systemInitiatedLabel: 'Execute approved plan',
+		});
+		if (ChatSendResult.isRejected(result)) {
+			return { ok: false, message: result.reason };
+		}
+		if (ChatSendResult.isQueued(result)) {
+			void result.deferred.then(async deferred => {
+				if (ChatSendResult.isRejected(deferred)) {
+					await this.planModeService.restorePlanReview(request.sessionResource, plan, `Execution did not start: ${deferred.reason}`);
+				}
+			}).catch(() => undefined);
+		}
+		return { ok: true };
+	}
+
+	private async queueDirectorPlanRevision(request: IChatAgentRequest, plan: DirectorPlanRecord, result: IChatPlanReviewResult): Promise<{ readonly ok: true } | { readonly ok: false; readonly message: string }> {
+		const chatService = this.getChatService();
+		if (!chatService) {
+			return { ok: false, message: 'Chat service is not available.' };
+		}
+		const feedback = result.feedback?.trim() ?? '';
+		const sendResult = await chatService.sendRequest(request.sessionResource, createPlanRevisionPrompt(plan, feedback), {
+			agentIdSilent: AGENT_ID,
+			modeInfo: AGENT_MODE_INFO,
+			userSelectedModelId: request.userSelectedModelId,
+			location: ChatAgentLocation.Chat,
+			queue: ChatRequestQueueKind.Queued,
+			isSystemInitiated: true,
+			systemInitiatedLabel: 'Revise plan',
+		});
+		if (ChatSendResult.isRejected(sendResult)) {
+			return { ok: false, message: sendResult.reason };
+		}
+		if (ChatSendResult.isQueued(sendResult)) {
+			void sendResult.deferred.then(async deferred => {
+				if (ChatSendResult.isRejected(deferred)) {
+					await this.planModeService.restorePlanReview(request.sessionResource, plan, `Revision did not start: ${deferred.reason}`);
+				}
+			}).catch(() => undefined);
+		}
+		return { ok: true };
+	}
+
+	private planReviewMissingResult(firstProgressTime: number | undefined, startTime: number, subtype: string): IChatAgentResult {
+		return {
+			errorDetails: { message: 'This plan review is no longer active.' },
+			timings: {
+				firstProgress: firstProgressTime,
+				totalElapsed: Date.now() - startTime,
+			},
+			metadata: { subtype },
+		};
+	}
+
+	private planReviewQueueFailedResult(firstProgressTime: number | undefined, startTime: number, message: string, subtype: string): IChatAgentResult {
+		return {
+			errorDetails: { message },
+			timings: {
+				firstProgress: firstProgressTime,
+				totalElapsed: Date.now() - startTime,
+			},
+			metadata: { subtype },
+		};
+	}
+
+	private resolveRequestModeKind(request: IChatAgentRequest): ChatModeKind | undefined {
+		const chatService = this.getChatService();
+		const session = chatService?.getSession(request.sessionResource);
+		return session?.getRequests().find(candidate => candidate.id === request.requestId)?.modeInfo?.kind;
+	}
+
+	private async resolveInlineEditorContext(request: IChatAgentRequest, token: CancellationToken): Promise<DirectorInlineEditorContext | undefined> {
+		if (request.location !== ChatAgentLocation.EditorInline && request.locationData?.type !== ChatAgentLocation.EditorInline) {
+			return undefined;
+		}
+		if (request.locationData?.type !== ChatAgentLocation.EditorInline) {
+			return undefined;
+		}
+
+		const uri = request.locationData.document;
+		const selection = Selection.liftSelection(request.locationData.selection);
+		const ref = await this.textModelService.createModelReference(uri);
+		try {
+			if (token.isCancellationRequested) {
+				return undefined;
+			}
+
+			const model = ref.object.textEditorModel;
+			const selectedText = isEmptyRange(selection) ? '' : model.getValueInRange(selection);
+			const startLine = Math.max(1, selection.startLineNumber - 40);
+			const endLine = Math.min(model.getLineCount(), selection.endLineNumber + 40);
+			const nearbyRange: IRange = {
+				startLineNumber: startLine,
+				startColumn: 1,
+				endLineNumber: endLine,
+				endColumn: model.getLineMaxColumn(endLine),
+			};
+			const nearbyText = truncateInlineContext(model.getValueInRange(nearbyRange));
+			return {
+				uri,
+				selection,
+				selectedText,
+				nearbyText,
+				languageId: model.getLanguageId(),
+			};
+		} finally {
+			ref.dispose();
+		}
+	}
+
+	private createInlineEditPrompt(request: IChatAgentRequest, context: DirectorInlineEditorContext): string {
+		return [
+			'Edit the current editor selection according to the user request.',
+			'',
+			`User request:\n${request.message}`,
+			'',
+			`File: ${context.uri.toString()}`,
+			`Language: ${context.languageId}`,
+			`Selection: ${formatRange(context.selection)}`,
+			'',
+			context.selectedText
+				? `Selected text:\n\`\`\`\`${context.languageId}\n${context.selectedText}\n\`\`\`\``
+				: 'The selection is empty; return text to insert at the cursor.',
+			'',
+			`Nearby context:\n\`\`\`\`${context.languageId}\n${context.nearbyText}\n\`\`\`\``,
+			'',
+			'Return only the replacement text for the selected range or insertion.',
+		].join('\n');
+	}
+
+	private extractEventText(event: any): string {
+		if (event.type === 'text_delta') {
+			return event.text ?? '';
+		}
+		if (event.type !== 'assistant' || !event.renderText) {
+			return '';
+		}
+		const content = event.message?.content;
+		if (typeof content === 'string') {
+			return content;
+		}
+		if (Array.isArray(content)) {
+			return content
+				.filter((block: any) => block?.type === 'text' && typeof block.text === 'string')
+				.map((block: any) => block.text)
+				.join('');
+		}
+		return '';
+	}
+
+	private getRichResponses(request: IChatAgentRequest, historyLength: number): ReadonlyArray<ReadonlyArray<IChatProgressResponseContent>> | undefined {
+		if (historyLength === 0) {
+			return [];
+		}
+
+		const chatService = this.getChatService();
+		if (!chatService) {
+			return undefined;
+		}
+		this.ensureChatServiceHooks(chatService);
+
+		const session = chatService.getSession(request.sessionResource);
+		if (!session) {
+			return undefined;
+		}
+
+		const completedRequests = session.getRequests()
+			.filter(candidate => candidate.id !== request.requestId && !!candidate.response)
+			.slice(-historyLength);
+
+		return completedRequests.map(candidate => candidate.response!.entireResponse.value);
+	}
+
+	private getChatService(): IChatService | undefined {
+		try {
+			return this.instantiationService.invokeFunction(accessor => accessor.get(IChatService));
+		} catch {
+			return undefined;
+		}
+	}
+
+	private ensureChatServiceHooks(chatService: IChatService): void {
+		if (this._chatServiceHooksRegistered) {
+			return;
+		}
+		this._chatServiceHooksRegistered = true;
+		this._register(chatService.onDidDisposeSession(event => {
+			for (const resource of event.sessionResources) {
+				this._replaySnapshots.delete(this.sessionKey(resource));
+			}
+		}));
+	}
+
+	private shouldUseReplaySnapshot(
+		historyMessages: NormalizedMessageParam[],
+		history: IChatAgentHistoryEntry[],
+		richResponses: ReadonlyArray<ReadonlyArray<IChatProgressResponseContent>> | undefined,
+		replaySnapshot: ReplaySnapshot | undefined,
+		provider: ProviderName,
+		model: string,
+		apiType: AgentEngineConfig['provider']['apiType'],
+	): boolean {
+		if (!replaySnapshot || history.length === 0) {
+			return false;
+		}
+		if (replaySnapshot.provider !== provider || replaySnapshot.model !== model || replaySnapshot.apiType !== apiType) {
+			return false;
+		}
+		if (!richResponses || richResponses.length !== history.length) {
+			return true;
+		}
+		const richHasToolInvocations = richResponses.some(response => response.some(part => part.kind === 'toolInvocation' || part.kind === 'toolInvocationSerialized'));
+		return !richHasToolInvocations && replaySnapshot.messages.length > historyMessages.length;
+	}
+
+	private getReplaySnapshot(sessionResource: IChatAgentRequest['sessionResource']): ReplaySnapshot | undefined {
+		const key = this.sessionKey(sessionResource);
+		const snapshot = this._replaySnapshots.get(key);
+		if (snapshot) {
+			snapshot.lastUpdated = Date.now();
+		}
+		return snapshot;
+	}
+
+	private pushReplaySnapshot(
+		sessionResource: IChatAgentRequest['sessionResource'],
+		messages: NormalizedMessageParam[],
+		provider: ProviderName,
+		model: string,
+		apiType: AgentEngineConfig['provider']['apiType'],
+	): void {
+		if (messages.length === 0) {
+			return;
+		}
+
+		const key = this.sessionKey(sessionResource);
+		if (!this._replaySnapshots.has(key) && this._replaySnapshots.size >= MAX_REPLAY_SNAPSHOTS) {
+			let oldestKey: string | undefined;
+			let oldestTime = Number.POSITIVE_INFINITY;
+			for (const [candidateKey, snapshot] of this._replaySnapshots) {
+				if (snapshot.lastUpdated < oldestTime) {
+					oldestTime = snapshot.lastUpdated;
+					oldestKey = candidateKey;
+				}
+			}
+			if (oldestKey) {
+				this._replaySnapshots.delete(oldestKey);
+			}
+		}
+
+		this._replaySnapshots.set(key, {
+			messages: this.trimReplayMessages(messages),
+			lastUpdated: Date.now(),
+			provider,
+			model,
+			apiType,
+		});
+	}
+
+	private trimReplayMessages(messages: readonly NormalizedMessageParam[]): NormalizedMessageParam[] {
+		if (messages.length <= MAX_REPLAY_MESSAGES) {
+			return [...messages];
+		}
+
+		const firstUserMessage = messages.find(message => message.role === 'user');
+		const recent = messages.slice(-(MAX_REPLAY_MESSAGES - 1));
+		if (firstUserMessage && !recent.includes(firstUserMessage)) {
+			return [firstUserMessage, ...recent];
+		}
+		return messages.slice(-MAX_REPLAY_MESSAGES);
+	}
+
+	private sessionKey(sessionResource: IChatAgentRequest['sessionResource']): string {
+		return sessionResource.toString();
+	}
+}
+
+function isEmptyRange(range: IRange): boolean {
+	return range.startLineNumber === range.endLineNumber && range.startColumn === range.endColumn;
+}
+
+function formatRange(range: IRange): string {
+	return `${range.startLineNumber}:${range.startColumn}-${range.endLineNumber}:${range.endColumn}`;
+}
+
+function truncateInlineContext(value: string): string {
+	const maxChars = 12_000;
+	if (value.length <= maxChars) {
+		return value;
+	}
+	return value.slice(0, maxChars) + '\n[context truncated]';
+}

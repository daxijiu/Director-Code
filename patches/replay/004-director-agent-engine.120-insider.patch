+CommandsRegistry.registerCommand(DIRECTOR_PLAN_REVISE_COMMAND_ID, async (accessor, sessionResource: URI, planId: string, nonce: string) => {
+	const planModeService = accessor.get(IDirectorPlanModeService);
+	const chatWidgetService = accessor.get(IChatWidgetService);
+	const notificationService = accessor.get(INotificationService);
+	const currentPlan = planModeService.getPlanForReview(sessionResource, planId, nonce);
+	if (!currentPlan) {
+		notificationService.warn(localize('directorCode.plan.revise.missing', "This plan review is no longer active."));
+		return;

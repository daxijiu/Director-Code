+		disposables.clear();
+		DOM.clearNode(parent);
+		const enabledInstances = this.sortInstances(state.instances.filter(instance => instance.enabled));
+
+		const filter = this.modelFilter.trim().toLowerCase();
+		let rendered = false;
+		for (const instance of enabledInstances) {
+			const models = instance.models.filter(model => {
+				if (!filter) {
+					return true;
+				}
+				const name = modelDisplayName(instance, model).toLowerCase();
+				return name.includes(filter) || model.id.toLowerCase().includes(filter) || instance.displayName.toLowerCase().includes(filter);
+			});
+			if (!models.length) {
+				continue;
+			}
+			rendered = true;
+
+			const group = DOM.append(parent, $('.dc-model-group'));
+			const groupHeader = DOM.append(group, $('.dc-model-group-header'));
+			const title = DOM.append(groupHeader, $('.dc-model-group-title'));
+			this.renderProviderIcon(title, instance.kind);
+			DOM.append(title, $('span')).textContent = instance.displayName;
+
+			const groupToggleLabel = DOM.append(groupHeader, $<HTMLLabelElement>('label.dc-switch-label'));
+			const groupToggle = DOM.append(groupToggleLabel, $<HTMLInputElement>('input.dc-switch'));
+			groupToggle.type = 'checkbox';
+			groupToggle.checked = models.every(model => model.hidden !== true);
+			DOM.append(groupToggleLabel, $('span')).textContent = localize('providerSettings.showAll', 'Show all');
+			disposables.add(DOM.addDisposableListener(groupToggle, 'change', () => void this.setProviderModelsVisible(instance, groupToggle.checked)));
+
+			const list = DOM.append(group, $('.dc-settings-list'));
+			const foldedModels = filter ? [] : models.filter(model => model.hidden === true && isDefaultFoldedModel(instance.kind, model));
+			const promotedModels = models.filter(model => !(model.hidden === true && isDefaultFoldedModel(instance.kind, model)));
+			const orderedModels = [
+				...promotedModels.filter(model => !isDefaultFoldedModel(instance.kind, model)),
+				...promotedModels.filter(model => isDefaultFoldedModel(instance.kind, model)),
+			];
+			for (const model of orderedModels) {
+				this.renderModelRow(list, state, instance, model, disposables);
+			}
+			if (foldedModels.length) {
+				const foldedKey = `${instance.id}:default-folded`;
+				const expanded = this.expandedFoldedModelGroups.has(foldedKey);
+				this.renderFoldedModelRow(list, instance, foldedModels, expanded, disposables, () => {
+					if (expanded) {
+						this.expandedFoldedModelGroups.delete(foldedKey);
+					} else {
+						this.expandedFoldedModelGroups.add(foldedKey);
+					}
+					this.renderModelGroups(parent, state, disposables);
+				});
+				if (expanded) {
+					for (const model of foldedModels) {
+						this.renderModelRow(list, state, instance, model, disposables);
+					}
+				}
+			}
+		}
+		if (!rendered) {
+			const empty = DOM.append(parent, $('.dc-empty-state'));
+			empty.textContent = filter
+				? localize('providerSettings.modelsNoMatches', 'No models match "{0}".', this.modelFilter.trim())
+				: localize('providerSettings.modelsEmpty', 'Connect a provider to manage model visibility.');
+		}
+	}

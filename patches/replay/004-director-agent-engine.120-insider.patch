+const DIRECTOR_OAUTH_CALLBACK_CHANNEL = 'directorOAuthCallback';
+
+interface IDirectorOAuthCallbackSession {
+	readonly sessionId: string;
+	readonly state: string;
+	readonly port: number;
+	readonly callbackPath: string;
+	readonly server: Server;
+	readonly connections: Set<Socket>;
+	result?: IDirectorOAuthCallbackResult;
+}
+
+interface IDirectorOAuthCallbackResult {
+	readonly code?: string;
+	readonly state?: string;
+	readonly error?: string;
+}
+
+class DirectorOAuthCallbackChannel extends Disposable implements IServerChannel {
+
+	private readonly sessions = new Map<string, IDirectorOAuthCallbackSession>();
+
+	async call(_context: unknown, command: string, arg?: any): Promise<any> {
+		switch (command) {
+			case 'start':
+				return this.start(arg);
+			case 'consume':
+				return this.consume(arg);
+			case 'cancel':
+				return this.cancel(arg);
+		}
+		throw new Error(`Unknown Director OAuth callback command: ${command}`);
+	}
+
+	listen(): Event<any> {
+		throw new Error('Director OAuth callback channel does not support events.');
+	}
+
+	override dispose(): void {
+		for (const session of this.sessions.values()) {
+			for (const connection of session.connections) {
+				connection.destroy();
+			}
+			session.server.close();
+		}
+		this.sessions.clear();
+		super.dispose();
+	}
+
+	private async start(arg: { readonly sessionId: string; readonly state: string; readonly port?: number; readonly callbackPath?: string }): Promise<{ readonly redirectUri: string }> {
+		const sessionId = String(arg?.sessionId ?? '');
+		const state = String(arg?.state ?? '');
+		if (!sessionId || !state) {
+			throw new Error('Director OAuth callback requires sessionId and state.');
+		}
+
+		await this.cancel({ sessionId });
+		const port = Number(arg.port ?? 1455);
+		const callbackPath = String(arg.callbackPath ?? '/auth/callback');
+		for (const session of this.sessions.values()) {
+			if (session.port === port) {
+				await this.cancel({ sessionId: session.sessionId });
+			}
+		}
+
+		const connections = new Set<Socket>();
+		const server = createServer((request, response) => this.handleRequest(sessionId, request, response));
+		server.on('connection', connection => {
+			connections.add(connection);
+			connection.on('close', () => connections.delete(connection));
+		});
+		const session: IDirectorOAuthCallbackSession = { sessionId, state, port, callbackPath, server, connections };
+
+		await new Promise<void>((resolve, reject) => {
+			const onError = (error: Error) => {
+				server.off('listening', onListening);
+				reject(error);
+			};
+			const onListening = () => {
+				server.off('error', onError);
+				resolve();
+			};
+			server.once('error', onError);
+			server.once('listening', onListening);
+			server.listen(port, '127.0.0.1');
+		});
+
+		this.sessions.set(sessionId, session);
+		return { redirectUri: `http://localhost:${port}${callbackPath}` };
+	}
+
+	private async consume(arg: { readonly sessionId: string }): Promise<IDirectorOAuthCallbackResult | undefined> {
+		const sessionId = String(arg?.sessionId ?? '');
+		const session = this.sessions.get(sessionId);
+		if (!session?.result) {
+			return undefined;
+		}
+		return session.result;
+	}
+
+	private async cancel(arg: { readonly sessionId: string }): Promise<void> {
+		const sessionId = String(arg?.sessionId ?? '');
+		const session = this.sessions.get(sessionId);
+		if (!session) {
+			return;
+		}
+		this.sessions.delete(sessionId);
+		await new Promise<void>(resolve => {
+			session.server.close(() => resolve());
+			for (const connection of session.connections) {
+				connection.destroy();
+			}
+		});
+	}
+
+	private handleRequest(sessionId: string, request: IncomingMessage, response: ServerResponse): void {
+		const session = this.sessions.get(sessionId);
+		if (!session) {
+			this.writeHtml(response, 200, 'OAuth sign-in is already complete. You can close this browser tab and return to Director Code.');
+			return;
+		}
+
+		const target = new URL(request.url ?? '/', `http://localhost:${session.port}`);
+		if (target.pathname !== session.callbackPath) {
+			this.writeHtml(response, 404, 'Director Code OAuth callback path not found.');
+			return;
+		}
+
+		const state = target.searchParams.get('state') ?? undefined;
+		const code = target.searchParams.get('code') ?? undefined;
+		const error = target.searchParams.get('error') ?? undefined;
+		if (state !== session.state) {
+			session.result = { error: 'OAuth state mismatch.' };
+			this.writeHtml(response, 400, 'OAuth state mismatch. Return to Director Code and restart sign in.');
+			return;
+		}
+
+		session.result = error ? { error } : { code, state };
+		this.writeHtml(response, 200, 'Signed in. You can close this browser tab and return to Director Code.');
+	}
+
+	private writeHtml(response: ServerResponse, status: number, message: string): void {
+		response.writeHead(status, { 'Content-Type': 'text/html; charset=utf-8', 'Connection': 'close' });
+		response.end(`<!doctype html><html><head><meta charset="utf-8"><title>Director Code OAuth</title></head><body><p>${message}</p><script>setTimeout(() => window.close(), 800);</script></body></html>`);
+	}
+}

+
+import type { ILanguageModelsConfigurationService, ILanguageModelsProviderGroup } from '../../../chat/common/languageModelsConfiguration.js';
+import type { IDirectorProviderRegistryService } from './providerRegistry.js';
+
+export interface IDirectorProviderProjectionLog {
+	warn(message: string, ...args: unknown[]): void;
+}
+
+export async function syncDirectorProviderGroupProjection(
+	providerRegistryService: IDirectorProviderRegistryService,
+	languageModelsConfigurationService: ILanguageModelsConfigurationService,
+	logService?: IDirectorProviderProjectionLog,
+): Promise<boolean> {
+	try {
+		const projectionGroups = await providerRegistryService.getProjectionGroups();
+		const desired = new Map(projectionGroups.map(group => [group.providerInstanceId, group]));
+		const existing = languageModelsConfigurationService.getLanguageModelsProviderGroups()
+			.filter(group => group.vendor === 'director-code');
+
+		for (const group of existing) {
+			const providerInstanceId = typeof group.directorProviderInstanceId === 'string' ? group.directorProviderInstanceId : undefined;
+			if (!providerInstanceId || !desired.has(providerInstanceId)) {
+				await languageModelsConfigurationService.removeLanguageModelsProviderGroup(group);
+			}
+		}
+
+		const refreshedExisting = languageModelsConfigurationService.getLanguageModelsProviderGroups()
+			.filter(group => group.vendor === 'director-code');
+		for (const desiredGroup of desired.values()) {
+			const existingGroup = refreshedExisting.find(group => group.directorProviderInstanceId === desiredGroup.providerInstanceId);
+			const target: ILanguageModelsProviderGroup = {
+				name: desiredGroup.name,
+				vendor: 'director-code',
+				directorProviderInstanceId: desiredGroup.providerInstanceId,
+			};
+			if (!existingGroup) {
+				await languageModelsConfigurationService.addLanguageModelsProviderGroup(target);
+			} else if (existingGroup.name !== target.name || existingGroup.directorProviderInstanceId !== target.directorProviderInstanceId) {
+				await languageModelsConfigurationService.updateLanguageModelsProviderGroup(existingGroup, target);
+			}
+		}
+		return true;
+	} catch (error) {
+		logService?.warn('[Director Code] Failed to sync chatLanguageModels.json provider groups.', error);
+		return false;
+	}
+}

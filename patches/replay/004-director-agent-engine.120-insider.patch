+	private showOAuthDialog(template: ProviderTemplate, instance?: IDirectorProviderInstance): void {
+		if (!isOAuthProvider(template.kind)) {
+			return;
+		}
+		const oauthProvider = template.kind;
+
+		this.showDialog(localize('providerSettings.oauthTitle', 'Connect {0}', template.label), (body, footer, close) => {
+			const controller = this.modalDisposables.add(new OAuthLoginController(oauthProvider, this.oauthService));
+			const header = DOM.append(body, $('.dc-oauth-dialog-header'));
+			this.renderProviderIcon(header, template.kind);
+			const title = DOM.append(header, $('.dc-oauth-dialog-title'));
+			title.textContent = template.label;
+			DOM.append(body, $('.dc-section-subtitle')).textContent = template.note;
+
+			const detail = DOM.append(body, $('.dc-oauth-detail.dc-oauth-dialog-detail'));
+			const modelStatus = DOM.append(body, $('.dc-dialog-status'));
+			const actionRow = DOM.append(body, $('.dc-action-row'));
+			const primary = this.createButton(actionRow, localize('providerSettings.oauthStart', 'Start Sign In'), 'primary');
+			const secondary = this.createButton(actionRow, localize('providerSettings.oauthCheckNow', 'Check Now'), 'secondary');
+			secondary.style.display = 'none';
+
+			const cancel = this.createButton(footer, localize('providerSettings.cancel', 'Cancel'), 'secondary');
+			this.modalDisposables.add(DOM.addDisposableListener(cancel, 'click', close));
+			const refresh = instance ? this.createButton(footer, localize('providerSettings.refreshModels', 'Refresh Models'), 'secondary') : undefined;
+			const connect = this.createButton(footer, localize('providerSettings.connect', 'Connect'), 'primary');
+			connect.disabled = true;
+
+			const renderState = (state: IOAuthLoginControllerState) => {
+				DOM.clearNode(detail);
+				primary.disabled = state.phase === 'submitting' || state.phase === 'polling';
+				secondary.style.display = 'none';
+				connect.disabled = state.phase !== 'approved';
+				if (refresh) {
+					refresh.disabled = state.phase !== 'approved';
+				}
+
+				if (state.phase === 'approved') {
+					detail.textContent = localize('providerSettings.oauthApproved', 'Signed in with {0}.', state.sourceLabel || template.label);
+					detail.classList.add('dc-test-success');
+					primary.textContent = localize('providerSettings.oauthLogout', 'Logout');
+					primary.classList.remove('dc-btn-primary');
+					primary.classList.add('dc-btn-danger');
+					return;
+				}
+
+				detail.classList.remove('dc-test-success', 'dc-test-error');
+				primary.textContent = state.phase === 'starting'
+					? localize('providerSettings.oauthStart', 'Start Sign In')
+					: localize('providerSettings.oauthRestart', 'Restart Sign In');
+				primary.classList.remove('dc-btn-danger');
+				primary.classList.add('dc-btn-primary');
+
+				if (state.phase === 'error') {
+					detail.classList.add('dc-test-error');
+					detail.textContent = state.error || localize('providerSettings.oauthFailed', 'OAuth login failed.');
+					return;
+				}
+
+				if (state.phase === 'submitting' || state.phase === 'polling') {
+					detail.textContent = localize('providerSettings.oauthChecking', 'Checking authorization...');
+					return;
+				}
+
+				if (state.flow === 'pkce_manual' && state.authUrl) {
+					this.renderOAuthManual(detail, controller, state);
+					return;
+				}
+
+				if (state.flow === 'external' && state.authUrl) {
+					this.renderOAuthExternal(detail, state);
+					secondary.style.display = '';
+					return;
+				}
+
+				if (state.flow === 'device_code' && state.verificationUrl && state.userCode) {
+					this.renderOAuthDevice(detail, state);
+					secondary.style.display = '';
+					return;
+				}
+
+				detail.textContent = localize('providerSettings.oauthNotStarted', 'Start sign in to authorize this provider.');
+			};
+
+			this.modalDisposables.add(controller.onDidChangeState(renderState));
+			this.modalDisposables.add(DOM.addDisposableListener(primary, 'click', async () => {
+				if (controller.state.phase === 'approved') {
+					await controller.logout();
+					return;
+				}
+				const previousSessionId = controller.state.sessionId;
+				await controller.start();
+				const nextState = controller.state;
+				if (nextState.phase === 'awaiting_user' && nextState.authUrl && nextState.sessionId !== previousSessionId) {
+					void this.openExternalUrl(nextState.authUrl);
+				}
+			}));
+			this.modalDisposables.add(DOM.addDisposableListener(secondary, 'click', () => void controller.pollOnce()));
+			if (refresh && instance) {
+				this.modalDisposables.add(DOM.addDisposableListener(refresh, 'click', async () => {
+					refresh.disabled = true;
+					modelStatus.textContent = localize('providerSettings.refreshingModels', 'Refreshing models...');
+					modelStatus.classList.remove('dc-test-success', 'dc-test-error');
+					try {
+						const current = await this.providerRegistryService.getInstance(instance.id) ?? instance;
+						const next = await this.refreshModelsForInstance(current);
+						modelStatus.textContent = localize('providerSettings.refreshModelsSuccess', 'Refreshed {0} models.', next.models.length);
+						modelStatus.classList.add('dc-test-success');
+					} catch (error) {
+						modelStatus.textContent = localize('providerSettings.refreshModelsFailed', 'Failed: {0}', error instanceof Error ? error.message : String(error));
+						modelStatus.classList.add('dc-test-error');
+					} finally {
+						refresh.disabled = controller.state.phase !== 'approved';
+					}
+				}));
+			}
+			this.modalDisposables.add(DOM.addDisposableListener(connect, 'click', () => void this.completeOAuthProvider(template, close)));
+			renderState(controller.state);
+			void controller.refreshStatus();
+		});
+	}
+
+	private renderOAuthManual(parent: HTMLElement, controller: OAuthLoginController, state: IOAuthLoginControllerState): void {
+		parent.appendChild(this.createExternalLink(state.authUrl!, localize('providerSettings.oauthOpenAuthPage', 'Open authorization page')));
+		const codeRow = DOM.append(parent, $('.dc-oauth-code-row'));
+		const input = DOM.append(codeRow, $<HTMLInputElement>('input.dc-form-input.dc-oauth-code-input'));
+		input.type = 'text';
+		input.placeholder = localize('providerSettings.oauthCodePlaceholder', 'Paste authorization code');
+		input.autocomplete = 'off';
+		const submit = this.createButton(codeRow, localize('providerSettings.oauthSubmitCode', 'Submit Code'), 'primary');
+		this.modalDisposables.add(DOM.addDisposableListener(submit, 'click', () => void controller.submitManualCode(input.value)));
+		this.modalDisposables.add(DOM.addDisposableListener(input, 'keydown', (event: KeyboardEvent) => {
+			if (event.key === 'Enter') {
+				void controller.submitManualCode(input.value);
+			}
+		}));
+	}
+
+	private renderOAuthDevice(parent: HTMLElement, state: IOAuthLoginControllerState): void {
+		parent.appendChild(this.createExternalLink(state.verificationUrl!, state.verificationUrl!));
+		const code = DOM.append(parent, $('.dc-oauth-user-code'));
+		code.textContent = state.userCode!;
+		const hint = DOM.append(parent, $('.dc-form-hint'));
+		hint.textContent = localize('providerSettings.deviceHint', 'Enter this code in the browser. Director Code will keep checking this session.');
+	}
+
+	private renderOAuthExternal(parent: HTMLElement, state: IOAuthLoginControllerState): void {
+		parent.appendChild(this.createExternalLink(state.authUrl!, localize('providerSettings.oauthOpenAuthPage', 'Open authorization page')));
+		const hint = DOM.append(parent, $('.dc-form-hint'));
+		hint.textContent = localize('providerSettings.externalOAuthHint', 'Complete sign-in in the browser. Director Code will finish automatically after the browser redirects back.');
+	}
+
+	private async completeOAuthProvider(template: ProviderTemplate, close: () => void): Promise<void> {
+		const state = await this.providerRegistryService.getState();
+		const existing = state.instances.find(instance =>
+			instance.kind === template.kind
+			&& instance.authKind === 'oauth'
+			&& instance.authVariant === template.authVariant
+		);
+		const defaultModelId = getDefaultModelForAuthVariant(template.kind, template.authVariant);
+		const models = modelEntriesFromCatalog(template.kind, template.authVariant, defaultModelId);
+		const now = Date.now();
+		const instance: IDirectorProviderInstance = existing
+			? { ...existing, enabled: true, updatedAt: now, models: existing.models.length ? existing.models : models, defaultModelId: existing.defaultModelId || defaultModelId }
+			: {
+				id: this.uniqueInstanceId(sanitizeProviderInstanceId(template.label), state),
+				kind: template.kind,
+				displayName: template.label,
+				enabled: true,
+				authKind: 'oauth',
+				authVariant: template.authVariant,
+				models,
+				defaultModelId,
+				createdAt: now,
+				updatedAt: now,
+			};
+		await this.providerRegistryService.upsertInstance(instance, instance.defaultModelId || defaultModelId);
+		let savedInstance = instance;
+		try {
+			savedInstance = await this.refreshModelsForInstance(instance);
+		} catch {
+			// Keep the catalog-backed OAuth instance if the provider model endpoint is unavailable.
+		}
+		await this.providerRegistryService.setDefault(savedInstance.id, savedInstance.defaultModelId || defaultModelId);
+		close();
+		this.notificationService.info(localize('providerSettings.connectedProvider', 'Connected {0}.', savedInstance.displayName));
+	}
+
+	private async saveApiProviderFromDialog(args: {
+		readonly state: IDirectorProviderRegistryState;
+		readonly isEdit: boolean;
+		readonly existing: IDirectorProviderInstance | undefined;
+		readonly idInput: HTMLInputElement;
+		readonly displayNameInput: HTMLInputElement;
+		readonly enabledInput: HTMLInputElement;
+		readonly provider: ProviderName;
+		readonly authVariant: AuthVariantName;
+		readonly baseURLInput: HTMLInputElement;
+		readonly sourceSelect: HTMLSelectElement;
+		readonly envVarInput: HTMLInputElement;
+		readonly keyInput: HTMLInputElement;
+		readonly modelsTextArea: HTMLTextAreaElement;
+		readonly defaultModelSelect: HTMLSelectElement;
+		readonly headersTextArea: HTMLTextAreaElement;
+		readonly status: (message: string, kind?: 'info' | 'success' | 'error') => void;
+		readonly close: (() => void) | undefined;
+		readonly allowEmptyModels?: boolean;
+	}): Promise<IDirectorProviderInstance | undefined> {
+		const id = sanitizeProviderInstanceId(args.idInput.value);
+		if (!id) {
+			args.status(localize('providerSettings.providerIdRequired', 'Provider ID is required.'), 'error');
+			return undefined;
+		}
+		if (!args.isEdit && args.state.instances.some(instance => instance.id === id)) {
+			args.status(localize('providerSettings.providerIdDuplicate', 'Provider ID already exists.'), 'error');
+			return undefined;
+		}
+		if (providerRequiresBaseURL(args.provider) && !args.baseURLInput.value.trim()) {
+			args.status(localize('providerSettings.baseURLRequired', 'Base URL is required for compatible providers.'), 'error');
+			return undefined;
+		}
+		if (args.sourceSelect.value === 'env' && !args.envVarInput.value.trim()) {
+			args.status(localize('providerSettings.envRequired', 'Environment variable name is required.'), 'error');
+			return undefined;
+		}
+		const existingHasKey = args.existing ? await this.apiKeyService.hasInstanceApiKey(args.existing.id) : false;
+		if (args.sourceSelect.value === 'secret' && !args.keyInput.value.trim() && !existingHasKey) {
+			args.status(localize('providerSettings.apiKeyRequired', 'API key is required.'), 'error');
+			return undefined;
+		}
+		const modelIds = this.parseModelIds(args.modelsTextArea.value);
+		if (!modelIds.length && !args.allowEmptyModels) {
+			args.status(localize('providerSettings.modelsRequired', 'Add at least one model.'), 'error');
+			return undefined;
+		}
+
+		const defaultModelId = args.defaultModelSelect.value || modelIds[0];
+		const now = Date.now();
+		const apiKeySource: IDirectorApiKeySource = args.sourceSelect.value === 'env'
+			? { kind: 'env', envVar: args.envVarInput.value.trim() }
+			: { kind: 'secret' };
+		const instance: IDirectorProviderInstance = {
+			id,
+			kind: args.provider,
+			displayName: args.displayNameInput.value.trim() || PROVIDER_DISPLAY_NAMES[args.provider] || id,
+			enabled: args.enabledInput.checked,
+			authKind: 'api-key',
+			authVariant: normalizeRegistryAuthVariant(args.provider, args.authVariant),
+			baseURL: args.baseURLInput.value.trim() || undefined,
+			headers: parseHeadersValue(args.headersTextArea.value),
+			apiKeySource,
+			models: this.buildModelEntries(args.provider, args.authVariant, modelIds),
+			defaultModelId,
+			createdAt: args.existing?.createdAt ?? now,
+			updatedAt: now,
+		};
+
+		await this.providerRegistryService.upsertInstance(instance, defaultModelId);
+		if (args.sourceSelect.value === 'secret' && args.keyInput.value.trim()) {
+			await this.apiKeyService.setInstanceApiKey(instance.id, instance.kind, args.keyInput.value.trim());
+			args.keyInput.value = '';
+		}
+		if (defaultModelId && (!args.state.defaultProviderId || (!args.isEdit && instance.enabled))) {
+			await this.providerRegistryService.setDefault(instance.id, defaultModelId);
+		}
+		args.status(localize('providerSettings.savedProvider', 'Saved {0}.', instance.displayName), 'success');
+		args.close?.();
+		this.notificationService.info(localize('providerSettings.savedProvider', 'Saved {0}.', instance.displayName));
+		return instance;
+	}
+
+	private async refreshModelsForInstance(instance: IDirectorProviderInstance): Promise<IDirectorProviderInstance> {
+		const modelId = instance.defaultModelId || instance.models[0]?.id || getDefaultModelForAuthVariant(instance.kind, instance.authVariant);
+		const authState = await this.authStateService.resolveInstanceAuth(instance, modelId);
+		const credential = authState.accessToken || authState.apiKey;
+		if (!credential) {
+			throw new Error(localize('providerSettings.refreshModelsMissingCredential', 'A saved credential is required before models can be refreshed.'));
+		}
+		const models = await this.modelResolverService.refreshModels(instance.kind, credential, authState.baseURL, authState.identityKey, authState.authVariant);
+		if (!models.length) {
+			throw new Error(localize('providerSettings.noModelsReturned', 'No models were returned by the provider endpoint. Enter model IDs manually if this provider does not expose model discovery.'));
+		}
+		const previousModels = new Map(instance.models.map(model => [model.id, model]));
+		const nextModels = models.map(model => ({
+			id: model.id,
+			displayName: model.name,
+			enabled: true,
+			hidden: previousModels.get(model.id)?.hidden ?? isDefaultFoldedModel(instance.kind, {
+				id: model.id,
+				displayName: model.name,
+				family: model.family,
+			}),
+			family: model.family,
+			maxInputTokens: model.maxInputTokens,
+			maxOutputTokens: model.maxOutputTokens,
+			capabilities: model.capabilities,
+		}));
+		const next: IDirectorProviderInstance = {
+			...instance,
+			models: nextModels,
+			defaultModelId: instance.defaultModelId && nextModels.some(model => model.id === instance.defaultModelId)
+				? instance.defaultModelId
+				: nextModels[0]?.id,
+			updatedAt: Date.now(),
+		};
+		await this.providerRegistryService.upsertInstance(next, next.defaultModelId);
+		return next;
+	}
+
+	private async disconnectInstance(instance: IDirectorProviderInstance): Promise<void> {
+		await this.setInstanceEnabled(instance, false);
+		if (instance.authKind === 'api-key' && instance.apiKeySource?.kind !== 'env') {
+			await this.apiKeyService.deleteInstanceApiKey(instance.id, instance.kind);
+		}
+		if (instance.authKind === 'oauth' && isOAuthProvider(instance.kind)) {
+			await this.oauthService.logout(instance.kind);
+		}
+		this.notificationService.info(localize('providerSettings.disconnectedProvider', 'Disconnected {0}.', instance.displayName));
+	}
+
+	private async deleteInstance(instance: IDirectorProviderInstance, close: () => void): Promise<void> {
+		await this.providerRegistryService.removeInstance(instance.id);
+		await this.apiKeyService.deleteInstanceApiKey(instance.id, instance.kind);
+		if (instance.authKind === 'oauth' && isOAuthProvider(instance.kind)) {
+			await this.oauthService.logout(instance.kind);
+		}
+		close();
+		this.notificationService.info(localize('providerSettings.deletedProvider', 'Deleted {0}.', instance.displayName));
+	}
+
+	private async setInstanceEnabled(instance: IDirectorProviderInstance, enabled: boolean): Promise<void> {
+		await this.applyRegistryMutation(
+			() => this.providerRegistryService.upsertInstance({ ...instance, enabled, updatedAt: Date.now() }, instance.defaultModelId),
+			'providersAndModels',
+		);
+	}
+
+	private async setDefaultInstance(instance: IDirectorProviderInstance): Promise<void> {
+		const modelId = instance.defaultModelId || instance.models.find(model => model.enabled !== false)?.id || getDefaultModelForAuthVariant(instance.kind, instance.authVariant);
+		await this.setDefaultModel(instance.id, modelId);
+	}
+
+	private async setDefaultModel(instanceId: string, modelId: string): Promise<void> {
+		await this.applyRegistryMutation(
+			() => this.providerRegistryService.setDefault(instanceId, modelId),
+			'connectedAndModels',
+		);
+	}
+
+	private async setModelVisibility(instance: IDirectorProviderInstance, modelId: string, visible: boolean): Promise<void> {
+		const models = instance.models.map(model => model.id === modelId ? { ...model, hidden: !visible } : model);
+		await this.applyRegistryMutation(
+			() => this.providerRegistryService.upsertInstance({ ...instance, models, updatedAt: Date.now() }, instance.defaultModelId),
+			'models',
+		);
+	}
+
+	private async setProviderModelsVisible(instance: IDirectorProviderInstance, visible: boolean): Promise<void> {
+		const models = instance.models.map(model => ({ ...model, hidden: !visible }));
+		await this.applyRegistryMutation(
+			() => this.providerRegistryService.upsertInstance({ ...instance, models, updatedAt: Date.now() }, instance.defaultModelId),
+			'models',
+		);
+	}
+
+	private async applyRegistryMutation(
+		mutate: () => Promise<IDirectorProviderRegistryState>,
+		scope: ProviderSettingsRefreshScope,
+	): Promise<void> {
+		this.captureScrollPosition();
+		this._loading = true;
+		try {
+			const state = await mutate();
+			await this.render(state, scope);
+		} finally {
+			this._loading = false;
+		}
+	}
+
+	private renderModelRow(
+		parent: HTMLElement,
+		state: IDirectorProviderRegistryState,
+		instance: IDirectorProviderInstance,
+		model: IDirectorProviderModelEntry,
+		disposables: DisposableStore,
+	): void {
+		const row = DOM.append(parent, $('.dc-model-row'));
+		const info = DOM.append(row, $('.dc-model-info'));
+		DOM.append(info, $('.dc-model-name')).textContent = modelDisplayName(instance, model);
+		const meta = DOM.append(info, $('.dc-model-meta'));
+		meta.textContent = model.displayName && model.displayName !== model.id ? model.id : (model.family || model.id);
+
+		const actions = DOM.append(row, $('.dc-model-actions'));
+		if (state.defaultProviderId === instance.id && state.defaultModelId === model.id) {
+			this.createTag(actions, localize('providerSettings.defaultTag', 'Default'), 'accent');
+		} else {
+			const setDefault = this.createButton(actions, localize('providerSettings.setDefault', 'Set Default'), 'secondary');
+			disposables.add(DOM.addDisposableListener(setDefault, 'click', () => void this.setDefaultModel(instance.id, model.id)));
+		}
+
+		const toggleLabel = DOM.append(actions, $<HTMLLabelElement>('label.dc-switch-label'));
+		const toggle = DOM.append(toggleLabel, $<HTMLInputElement>('input.dc-switch'));
+		toggle.type = 'checkbox';
+		toggle.checked = model.hidden !== true;
+		DOM.append(toggleLabel, $('span')).textContent = model.hidden === true
+			? localize('providerSettings.hidden', 'Hidden')
+			: localize('providerSettings.visible', 'Visible');
+		disposables.add(DOM.addDisposableListener(toggle, 'change', () => void this.setModelVisibility(instance, model.id, toggle.checked)));
+	}
+
+	private renderFoldedModelRow(
+		parent: HTMLElement,
+		instance: IDirectorProviderInstance,
+		models: readonly IDirectorProviderModelEntry[],
+		expanded: boolean,
+		disposables: DisposableStore,
+		onToggle: () => void,
+	): void {
+		const row = DOM.append(parent, $('.dc-model-row.dc-model-fold-row'));
+		const info = DOM.append(row, $('.dc-model-info'));
+		DOM.append(info, $('.dc-model-name')).textContent = expanded
+			? localize('providerSettings.hideFoldedModels', 'Hide folded models')
+			: localize('providerSettings.showFoldedModels', 'Show {0} hidden models', models.length);
+		const meta = DOM.append(info, $('.dc-model-meta'));
+		meta.textContent = localize('providerSettings.foldedModelsHint', '{0} early or specialized models are hidden by default.', KIND_SHORT_LABELS[instance.kind]);
+		const actions = DOM.append(row, $('.dc-model-actions'));
+		const button = this.createButton(actions, expanded ? localize('providerSettings.collapse', 'Collapse') : localize('providerSettings.expand', 'Expand'), 'secondary');
+		disposables.add(DOM.addDisposableListener(button, 'click', onToggle));
+	}
+
+	private defaultModelForInstance(instance: IDirectorProviderInstance, state: IDirectorProviderRegistryState): string {
+		return state.defaultProviderId === instance.id && state.defaultModelId
+			? state.defaultModelId
+			: instance.defaultModelId || instance.models[0]?.id || getDefaultModelForAuthVariant(instance.kind, instance.authVariant);
+	}
+
+	private buildModelEntries(provider: ProviderName, authVariant: AuthVariantName, modelIds: readonly string[]): readonly IDirectorProviderModelEntry[] {
+		const catalog = new Map(modelEntriesFromCatalog(provider, authVariant).map(model => [model.id, model]));
+		return modelIds.map(id => catalog.get(id) ?? {
+			id,
+			displayName: id,
+			enabled: true,
+			hidden: false,
+			family: 'custom',
+			maxInputTokens: 0,
+			maxOutputTokens: 8_192,
+		});
+	}
+
+	private parseModelIds(value: string): string[] {
+		const values = value
+			.split(/[\n,]+/g)
+			.map(item => item.trim())
+			.filter(item => item.length > 0);
+		return Array.from(new Set(values));
+	}
+
+	private populateDefaultModelSelect(select: HTMLSelectElement, modelIds: readonly string[], preferred: string | undefined): void {
+		const current = preferred || select.value;
+		DOM.clearNode(select);
+		for (const modelId of modelIds) {
+			this.appendOption(select, modelId, modelId);
+		}
+		if (current && modelIds.includes(current)) {
+			select.value = current;
+		} else if (modelIds[0]) {
+			select.value = modelIds[0];
+		}
+	}
+
+	private uniqueInstanceId(base: string, state: IDirectorProviderRegistryState): string {
+		const used = new Set(state.instances.map(instance => instance.id));
+		const root = sanitizeProviderInstanceId(base) || 'provider';
+		if (!used.has(root)) {
+			return root;
+		}
+		for (let index = 2; index < 1000; index++) {
+			const candidate = `${root}-${index}`;
+			if (!used.has(candidate)) {
+				return candidate;
+			}
+		}
+		return `${root}-${Date.now().toString(36)}`;
+	}
+
+	private sortInstances(instances: readonly IDirectorProviderInstance[]): readonly IDirectorProviderInstance[] {
+		return [...instances].sort((left, right) => {
+			if (left.enabled !== right.enabled) {
+				return left.enabled ? -1 : 1;
+			}
+			return left.displayName.localeCompare(right.displayName);
+		});
+	}
+
+	private templateFromInstance(instance: IDirectorProviderInstance): ProviderTemplate {
+		return {
+			id: instance.id,
+			kind: instance.kind,
+			label: instance.displayName,
+			note: instanceAuthLabel(instance),
+			authKind: instance.authKind,
+			authVariant: instance.authVariant,
+		};
+	}
+
+	private showDialog(title: string, render: (body: HTMLElement, footer: HTMLElement, close: () => void) => void): void {
+		this.modalDisposables.clear();
+		const overlay = document.createElement('div');
+		overlay.className = 'dc-modal-backdrop';
+		const dialog = DOM.append(overlay, $('.dc-modal'));
+		const header = DOM.append(dialog, $('.dc-modal-header'));
+		DOM.append(header, $('.dc-modal-title')).textContent = title;
+		const closeButton = DOM.append(header, $<HTMLButtonElement>('button.dc-icon-button'));
+		closeButton.type = 'button';
+		closeButton.textContent = 'x';
+		closeButton.title = localize('providerSettings.close', 'Close');
+		const body = DOM.append(dialog, $('.dc-modal-body'));
+		const footer = DOM.append(dialog, $('.dc-modal-footer'));
+
+		const close = () => this.modalDisposables.clear();
+		this.modalDisposables.add({ dispose: () => overlay.remove() });
+		this.modalDisposables.add(DOM.addDisposableListener(closeButton, 'click', close));
+		this.modalDisposables.add(DOM.addDisposableListener(overlay, 'click', event => {
+			if (event.target === overlay) {
+				close();
+			}
+		}));
+		this.modalDisposables.add(DOM.addDisposableListener(document, 'keydown', (event: KeyboardEvent) => {
+			if (event.key === 'Escape') {
+				close();
+			}
+		}));
+
+		document.body.appendChild(overlay);
+		render(body, footer, close);
+	}
+
+	private captureScrollPosition(): void {
+		this.restoreScrollTop = this.getScrollContainer().scrollTop;
+	}
+
+	private restoreScrollPosition(): void {
+		const scrollTop = this.restoreScrollTop;
+		if (scrollTop === undefined) {
+			return;
+		}
+		this.restoreScrollTop = undefined;
+		setTimeout(() => {
+			this.getScrollContainer().scrollTop = scrollTop;
+		}, 0);
+	}
+
+	private getScrollContainer(): HTMLElement {
+		let node: HTMLElement | null = this.element;
+		while (node) {
+			if (node.scrollHeight > node.clientHeight) {
+				const style = getComputedStyle(node);
+				if (style.overflowY === 'auto' || style.overflowY === 'scroll') {
+					return node;
+				}
+			}
+			node = node.parentElement;
+		}
+		return this.element;
+	}
+
+	private createPanel(parent: HTMLElement, title: string, subtitle?: string): HTMLElement {
+		const section = DOM.append(parent, $('.dc-settings-panel'));
+		const header = DOM.append(section, $('.dc-settings-panel-header'));
+		DOM.append(header, $('.dc-settings-panel-title')).textContent = title;
+		if (subtitle) {
+			DOM.append(header, $('.dc-section-subtitle')).textContent = subtitle;
+		}
+		return section;
+	}
+
+	private renderProviderIdentity(parent: HTMLElement, provider: { id: ProviderName; name: string; description: string }): void {
+		const row = DOM.append(parent, $('.dc-provider-identity'));
+		this.renderProviderIcon(row, provider.id);
+		const text = DOM.append(row, $('.dc-provider-text'));
+		DOM.append(text, $('.dc-provider-name')).textContent = provider.name;
+		DOM.append(text, $('.dc-provider-desc')).textContent = provider.description;
+	}
+
+	private renderProviderIcon(parent: HTMLElement, provider: ProviderName): void {
+		const icon = DOM.append(parent, $('.dc-provider-icon'));
+		icon.textContent = KIND_SHORT_LABELS[provider].slice(0, 1).toUpperCase();
+		icon.classList.add(`dc-provider-icon-${provider.replace(/[^a-z0-9]+/g, '-')}`);
+	}
+
+	private createTag(parent: HTMLElement, label: string, tone: 'neutral' | 'accent' | 'success' | 'danger' | 'muted'): HTMLElement {
+		const tag = DOM.append(parent, $(`.dc-tag.dc-tag-${tone}`));
+		tag.textContent = label;
+		return tag;
+	}
+
+	private createSelectRow(parent: HTMLElement, labelText: string, options: { value: string; label: string }[]): HTMLSelectElement {
+		const row = DOM.append(parent, $('.dc-form-row'));
+		DOM.append(row, $<HTMLLabelElement>('label.dc-form-label')).textContent = labelText;
+		const select = DOM.append(row, $<HTMLSelectElement>('select.dc-form-select'));
+		for (const option of options) {
+			this.appendOption(select, option.value, option.label);
+		}
+		return select;
+	}
+
+	private createInputRow(parent: HTMLElement, labelText: string, placeholder: string, type: string = 'text'): HTMLInputElement {
+		const row = DOM.append(parent, $('.dc-form-row'));
+		DOM.append(row, $<HTMLLabelElement>('label.dc-form-label')).textContent = labelText;
+		const input = DOM.append(row, $<HTMLInputElement>('input.dc-form-input'));
+		input.type = type;
+		input.placeholder = placeholder;
+		input.autocomplete = 'off';
+		return input;
+	}
+
+	private createButton(parent: HTMLElement, label: string, variant: 'primary' | 'secondary' | 'danger' = 'secondary'): HTMLButtonElement {
+		const button = DOM.append(parent, $<HTMLButtonElement>(`button.dc-btn.dc-btn-${variant}`));
+		button.type = 'button';
+		button.textContent = label;
+		return button;
+	}
+
+	private appendOption(select: HTMLSelectElement, value: string, label: string): void {
+		const option = document.createElement('option');
+		option.value = value;
+		option.textContent = label;
+		select.appendChild(option);
+	}
+
+	private createExternalLink(url: string, label: string): HTMLAnchorElement {
+		const link = document.createElement('a');
+		link.className = 'dc-oauth-link';
+		link.href = url;
+		link.target = '_blank';
+		link.rel = 'noopener noreferrer';
+		link.textContent = label;
+		this.modalDisposables.add(DOM.addDisposableListener(link, 'click', event => {
+			event.preventDefault();
+			void this.openExternalUrl(url);
+		}));
+		return link;
+	}
+
+	private async openExternalUrl(url: string): Promise<void> {
+		try {
+			await this.openerService.open(URI.parse(url), { openExternal: true });
+		} catch (err: any) {
+			this.notificationService.warn(err?.message || String(err));
+		}
+	}
+
+	private queueNumberConfig(key: string, input: HTMLInputElement, min: number, max: number): void {
+		const value = parseInt(input.value, 10);
+		if (!isNaN(value) && value >= min && value <= max) {
+			this.pendingWrites.queue(key, value);
+		}
+	}
+}

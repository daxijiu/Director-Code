+
+		test("NormalizedMessageParam supports content block arrays", () => {
+			const msg: NormalizedMessageParam = {
+				role: "assistant",
+				content: [
+					{ type: "text", text: "Let me check that file." },
+					{ type: "tool_use", id: "tool-1", name: "readFile", input: { filePath: "test.ts" } },

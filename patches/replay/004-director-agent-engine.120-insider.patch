+const DIRECTOR_CODE_PROVIDER_DESCRIPTOR = { vendor: VENDOR, displayName: 'Director Code', configuration: DIRECTOR_CODE_PROVIDER_CONFIGURATION, managementCommand: OPEN_SETTINGS_COMMAND_ID, when: undefined } as any;
+
+class DirectorProviderGroupProjection extends Disposable {
+	private syncPromise: Promise<void> = Promise.resolve();
+
+	constructor(
+		@IDirectorProviderRegistryService private readonly providerRegistryService: IDirectorProviderRegistryService,
+		@ILanguageModelsConfigurationService private readonly languageModelsConfigurationService: ILanguageModelsConfigurationService,
+		@ILogService private readonly logService: ILogService,
+	) {
+		super();
+		this._register(this.providerRegistryService.onDidChangeProviderRegistry(() => this.queueSync()));
+		this.queueSync();
+	}
+
+	private queueSync(): void {
+		this.syncPromise = this.syncPromise.then(() => this.sync()).then(() => undefined);
+	}
+
+	private async sync(): Promise<void> {
+		await syncDirectorProviderGroupProjection(this.providerRegistryService, this.languageModelsConfigurationService, this.logService);
+	}
+}
+
+class DirectorCodeAgentContribution extends Disposable implements IWorkbenchContribution {

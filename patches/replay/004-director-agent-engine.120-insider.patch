+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Director-Code Contributors. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+/* ============================================================================
+   Director Code Settings Editor Styles
+   ============================================================================ */
+
+/* --- General Layout --- */
+
+.director-code-settings-editor {
+	padding: 20px 24px;
+	overflow-y: auto;
+	height: 100%;
+	box-sizing: border-box;
+}
+
+.dc-section-header {
+	font-size: 16px;
+	font-weight: 600;
+	margin-bottom: 4px;
+	color: var(--vscode-foreground, #cccccc);
+}
+
+.dc-section-subtitle {
+	font-size: 12px;
+	color: var(--vscode-descriptionForeground, #9d9d9d);
+	margin-bottom: 16px;
+	line-height: 1.4;
+}
+
+/* --- Quick Status Bar --- */
+
+.dc-status-bar {
+	display: flex;
+	gap: 16px;
+	padding: 10px 14px;
+	border-radius: 6px;
+	border: 1px solid var(--vscode-widget-border, var(--vscode-input-border));
+	background-color: var(--vscode-editor-background);
+	margin-bottom: 20px;
+	max-width: 500px;
+	font-size: 12px;
+	flex-wrap: wrap;
+}
+
+.dc-status-bar-item {
+	display: flex;
+	align-items: center;
+	gap: 6px;
+}
+
+.dc-status-bar-label {
+	color: var(--vscode-descriptionForeground);
+}
+
+.dc-status-bar-value {
+	font-weight: 600;
+	color: var(--vscode-foreground);
+}
+
+.dc-status-bar-value.dc-ready {
+	color: var(--vscode-testing-iconPassed, #388a34);
+}
+
+.dc-status-bar-value.dc-not-ready {
+	color: var(--vscode-errorForeground, #f44747);
+}
+
+/* --- Provider Settings Form --- */
+
+.director-code-provider-settings-widget {
+	margin-bottom: 32px;
+}
+
+.dc-settings-form {
+	display: flex;
+	flex-direction: column;
+	gap: 12px;
+	max-width: 500px;
+}
+
+.dc-form-row {
+	display: flex;
+	flex-direction: column;
+	gap: 4px;
+}
+
+.dc-form-label {
+	font-size: 12px;
+	font-weight: 500;
+	color: var(--vscode-foreground, #cccccc);
+}
+
+.dc-form-select,
+.dc-form-input {
+	padding: 6px 8px;
+	font-size: 13px;
+	border: 1px solid var(--vscode-input-border, var(--vscode-widget-border));
+	border-radius: 4px;
+	background-color: var(--vscode-input-background, #3c3c3c);
+	color: var(--vscode-input-foreground, var(--vscode-foreground, #cccccc));
+	outline: none;
+}
+
+.dc-form-select:focus,
+.dc-form-input:focus {
+	border-color: var(--vscode-focusBorder, #007fd4);
+}
+
+.dc-form-hint {
+	font-size: 11px;
+	color: var(--vscode-descriptionForeground, #9d9d9d);
+	line-height: 1.4;
+	margin-top: 2px;
+}
+
+/* --- API Keys Widget --- */
+
+.director-code-api-keys-widget {
+	margin-bottom: 32px;
+}
+
+.dc-api-keys-container {
+	display: flex;
+	flex-direction: column;
+	gap: 16px;
+	max-width: 500px;
+}
+
+.dc-provider-row {
+	border: 1px solid var(--vscode-widget-border, var(--vscode-input-border));
+	border-radius: 6px;
+	padding: 12px 16px;
+	background-color: var(--vscode-editor-background);
+}
+
+.dc-provider-label-row {
+	display: flex;
+	align-items: center;
+	justify-content: space-between;
+	margin-bottom: 8px;
+}
+
+.dc-provider-label {
+	font-size: 13px;
+	font-weight: 600;
+	color: var(--vscode-foreground);
+}
+
+.dc-status-badge {
+	font-size: 11px;
+	padding: 2px 8px;
+	border-radius: 10px;
+	font-weight: 500;
+}
+
+.dc-status-set {
+	background-color: var(--vscode-testing-iconPassed, #388a34);
+	color: #fff;
+}
+
+.dc-status-not-set {
+	background-color: var(--vscode-input-border, #5a5a5a);
+	color: var(--vscode-foreground);
+}
+
+.dc-status-progress {
+	background-color: var(--vscode-charts-blue, #3794ff);
+	color: #fff;
+}
+
+.dc-status-error {
+	background-color: var(--vscode-errorForeground, #f44747);
+	color: #fff;
+}
+
+/* --- Input Row --- */
+
+.dc-input-row {
+	display: flex;
+	gap: 8px;
+	margin-bottom: 8px;
+}
+
+.dc-api-key-input {
+	flex: 1;
+	padding: 5px 8px;
+	font-size: 13px;
+	font-family: var(--vscode-editor-font-family, monospace);
+	border: 1px solid var(--vscode-input-border, var(--vscode-widget-border));
+	border-radius: 4px;
+	background-color: var(--vscode-input-background);
+	color: var(--vscode-input-foreground);
+	outline: none;
+}
+
+.dc-api-key-input:focus {
+	border-color: var(--vscode-focusBorder);
+}
+
+/* --- Buttons --- */
+
+.dc-btn {
+	padding: 4px 12px;
+	font-size: 12px;
+	border: 1px solid transparent;
+	border-radius: 4px;
+	cursor: pointer;
+	white-space: nowrap;
+}
+
+.dc-btn:disabled {
+	opacity: 0.5;
+	cursor: default;
+}
+
+.dc-btn-primary {
+	background-color: var(--vscode-button-background, #0e639c);
+	color: var(--vscode-button-foreground, #ffffff);
+	border-color: var(--vscode-button-border, transparent);
+}
+
+.dc-btn-primary:hover:not(:disabled) {
+	background-color: var(--vscode-button-hoverBackground, #1177bb);

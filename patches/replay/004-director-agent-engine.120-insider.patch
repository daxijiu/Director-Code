+CommandsRegistry.registerCommand(DIRECTOR_PLAN_EXECUTE_COMMAND_ID, async (accessor, sessionResource: URI, planId: string, nonce: string) => {
+	const planModeService = accessor.get(IDirectorPlanModeService);
+	const chatService = accessor.get(IChatService);
+	const chatWidgetService = accessor.get(IChatWidgetService);
+	const notificationService = accessor.get(INotificationService);
+	const pendingPlan = planModeService.prepareExecution(sessionResource, planId, nonce);
+	if (!pendingPlan) {
+		notificationService.warn(localize('directorCode.plan.execute.missing', "This plan review is no longer active."));
+		return;
+	}
+	let plan = pendingPlan;
+	try {
+		const approvedPlan = await planModeService.approvePlanForExecution(sessionResource, planId, nonce);
+		if (!approvedPlan) {
+			notificationService.warn(localize('directorCode.plan.execute.missing', "This plan review is no longer active."));
+			return;
+		}
+		plan = approvedPlan;
+	} catch (error) {
+		const message = error instanceof Error ? error.message : String(error);
+		notificationService.warn(localize('directorCode.plan.execute.approveFailed', "Could not approve this plan: {0}", message));
+		return;
+	}
+
+	const widget = chatWidgetService.getWidgetBySessionResource(sessionResource);
+	const userSelectedModelId = resolvePlanExecutionModelId(chatService, widget?.input.currentLanguageModel, sessionResource, plan.sourceRequest);
+	widget?.input.setChatMode(ChatModeKind.Agent, false);
+	widget?.focusInput();
+	try {
+		const result = await chatService.sendRequest(sessionResource, createApprovedPlanExecutionPrompt(plan), {
+			agentIdSilent: AGENT_ID,
+			modeInfo: AGENT_MODE_INFO,
+			userSelectedModelId,
+			location: ChatAgentLocation.Chat,
+			isSystemInitiated: true,
+			systemInitiatedLabel: localize('directorCode.plan.execute.label', "Execute approved plan"),
+		});
+
+		const sent = ChatSendResult.isSent(result)
+			? result
+			: ChatSendResult.isQueued(result)
+				? await result.deferred
+				: result;
+		if (ChatSendResult.isSent(sent)) {
+			notificationService.info(localize('directorCode.plan.execute.sent', "Executing approved plan."));
+		} else if (ChatSendResult.isRejected(sent)) {
+			await planModeService.restorePlanReview(sessionResource, plan, `Execution did not start: ${sent.reason}`);
+			notificationService.warn(localize('directorCode.plan.execute.rejected', "Could not start execution: {0}", sent.reason));
+		} else {
+			notificationService.warn(localize('directorCode.plan.execute.stillQueued', "Execution is still queued."));
+		}
+	} catch (error) {
+		const message = error instanceof Error ? error.message : String(error);
+		await planModeService.restorePlanReview(sessionResource, plan, `Execution did not start: ${message}`);
+		notificationService.warn(localize('directorCode.plan.execute.rejected', "Could not start execution: {0}", message));
+	}
+});
+
+CommandsRegistry.registerCommand(DIRECTOR_PLAN_REJECT_COMMAND_ID, async (accessor, sessionResource: URI, planId: string, nonce: string) => {
+	const planModeService = accessor.get(IDirectorPlanModeService);

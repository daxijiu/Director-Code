+ *--------------------------------------------------------------------------------------------*/
+
+import { ChatAgentLocation, ChatModeKind } from '../../../chat/common/constants.js';
+import type { IChatLocationData } from '../../../chat/common/chatService/chatService.js';
+import { DirectorToolMode } from './directorToolRegistry.js';
+
+export interface DirectorChatModeRoutingInput {
+	readonly location: ChatAgentLocation;
+	readonly locationData?: IChatLocationData;
+	readonly modeKind?: ChatModeKind;
+}
+
+export function getDirectorToolModeForRequest(input: DirectorChatModeRoutingInput): DirectorToolMode {
+	if (input.location === ChatAgentLocation.EditorInline || input.locationData?.type === ChatAgentLocation.EditorInline) {
+		return DirectorToolMode.Inline;
+	}
+
+	switch (input.modeKind) {
+		case ChatModeKind.Ask:
+			return DirectorToolMode.Ask;
+		case ChatModeKind.Edit:
+			return DirectorToolMode.Edit;
+		case ChatModeKind.Agent:
+		default:
+			return DirectorToolMode.Agent;
+	}
+}
+
+export function getDirectorModeMaxTurns(configuredMaxTurns: number, mode: DirectorToolMode): number {
+	switch (mode) {
+		case DirectorToolMode.Ask:
+			return Math.max(1, Math.min(configuredMaxTurns, 6));
+		case DirectorToolMode.Inline:
+			return 1;
+		case DirectorToolMode.Plan:
+			return configuredMaxTurns;
+		default:
+			return configuredMaxTurns;
+	}
+}
+
+export function getDirectorModeSystemPrompt(mode: DirectorToolMode): string | undefined {
+	switch (mode) {
+		case DirectorToolMode.Ask:
+			return [
+				'You are Director Code in Ask mode.',
+				'Answer programming and workspace questions clearly and concisely.',
+				'You may use only read-only context tools when they help answer the question.',
+				'Do not edit files, run terminal commands, create tasks, or mutate workspace state.',
+				'Use provided attachments, current editor context, custom instructions, and chat history when relevant.',
+			].join('\n');
+		case DirectorToolMode.Edit:
+			return [
+				'You are Director Code in Edit mode.',
+				'Focus on producing reviewable workspace edits for the user request.',
+				'Read relevant context first, then use only Director reviewable edit tools for file changes.',
+				'Do not use terminal or task execution. Keep edits conservative and explain the result briefly.',
+			].join('\n');
+		case DirectorToolMode.Inline:
+			return [
+				'You are Director Code in inline editor mode.',
+				'Return only the exact replacement text for the selected range or cursor insertion.',
+				'Do not include explanations, markdown prose, file names, or tool calls.',
+				'If the replacement is multiple lines, a single fenced code block containing only the replacement is allowed.',
+			].join('\n');
+		case DirectorToolMode.Plan:
+			return [
+				'You are Director Code in Plan Mode.',
+				'Research and plan the requested change without modifying project files or running terminal/task/browser automation.',
+				'Use read-only tools proactively when they help you understand the workspace, repository, errors, or external context.',
+				'When important information is missing, use askQuestions to ask the user concise clarifying questions before presenting the plan.',
+				'You must finish by calling director_present_plan. Do not end with final markdown only.',
+				'If uncertainty remains after any needed questions, include assumptions and openQuestions in director_present_plan.',
+				'The planMarkdown argument is only the Proposed Steps body. Do not include YAML frontmatter, status/path/cwd/root metadata, or write target fields.',
+				'After calling director_present_plan, stop; the host will present Execute, Reject, and Revise actions.',
+			].join('\n');
+		case DirectorToolMode.Agent:
+		default:
+			return undefined;
+	}
+}

+
+import assert from 'assert';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../base/test/common/utils.js';
+import { ExtensionIdentifier } from '../../../../platform/extensions/common/extensions.js';
+import type { IExtensionDescription } from '../../../../platform/extensions/common/extensions.js';
+import type { ApiProposalName } from '../../../../platform/extensions/common/extensionsApiProposals.js';
+import { NullLogService } from '../../../../platform/log/common/log.js';
+import { nullExtensionDescription, isProposedApiEnabled } from '../../../services/extensions/common/extensions.js';
+import { mock } from '../../../test/common/workbenchTestServices.js';
+import { MainContext } from '../../common/extHost.protocol.js';
+import type { IToolDataDto, MainThreadLanguageModelsShape, MainThreadLanguageModelToolsShape } from '../../common/extHost.protocol.js';
+import type { IExtHostAuthentication } from '../../common/extHostAuthentication.js';
+import { ExtHostLanguageModels } from '../../common/extHostLanguageModels.js';
+import { ExtHostLanguageModelTools } from '../../common/extHostLanguageModelTools.js';
+import { TestRPCProtocol } from './testRPCProtocol.js';
+
+suite('ExtHost language model runtime', () => {
+
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	test('proposed API gating is exact per proposal', () => {
+		const extension = extensionWithProposals('vscode.mermaid-chat-features', ['chatOutputRenderer']);
+
+		assert.strictEqual(isProposedApiEnabled(extension, 'chatOutputRenderer'), true);
+		assert.strictEqual(isProposedApiEnabled(extension, 'chatParticipantAdditions'), false);
+		assert.strictEqual(isProposedApiEnabled(extension, 'chatParticipantPrivate'), false);
+	});
+
+	test('tool metadata additions are gated by chatParticipantAdditions', () => {
+		const rpcProtocol = createRpcProtocol();
+		const languageModels = createLanguageModels(rpcProtocol);
+		const tools = new ExtHostLanguageModelTools(rpcProtocol, languageModels);
+		const tool = createToolData();
+
+		tools.$onDidChangeTools([tool]);
+
+		const mermaidTools = tools.getTools(extensionWithProposals('vscode.mermaid-chat-features', ['chatOutputRenderer']));
+		assert.strictEqual(mermaidTools.length, 1);
+		assert.strictEqual((mermaidTools[0] as { source?: unknown }).source, undefined);
+		assert.strictEqual((mermaidTools[0] as { fullReferenceName?: unknown }).fullReferenceName, undefined);
+
+		const participantTools = tools.getTools(extensionWithProposals('test.participant', ['chatParticipantAdditions']));
+		assert.strictEqual(participantTools.length, 1);
+		assert.notStrictEqual((participantTools[0] as { source?: unknown }).source, undefined);
+		assert.strictEqual((participantTools[0] as { fullReferenceName?: string }).fullReferenceName, tool.fullReferenceName);
+
+		languageModels.dispose();
+	});
+
+	test('missing model lookup tries recovery once and does not recurse', async () => {
+		const rpcProtocol = createRpcProtocol();
+		const extension = extensionWithProposals('vscode.mermaid-chat-features', ['chatOutputRenderer']);
+		const languageModels = createLanguageModels(rpcProtocol);
+		let selectCalls = 0;
+
+		rpcProtocol.set(MainContext.MainThreadLanguageModels, new class extends mock<MainThreadLanguageModelsShape>() {
+			override $selectChatModels(): Promise<string[]> {
+				selectCalls++;
+				return Promise.resolve(['director-code/deepseek-chat']);
+			}
+		});
+
+		const first = await languageModels.getLanguageModelByIdentifier(extension, 'director-code/deepseek-chat');
+		const second = await languageModels.getLanguageModelByIdentifier(extension, 'director-code/deepseek-chat');
+
+		assert.strictEqual(first, undefined);
+		assert.strictEqual(second, undefined);
+		assert.strictEqual(selectCalls, 1);
+
+		languageModels.dispose();
+	});
+
+	test('missing model recovery errors are bounded', async () => {
+		const rpcProtocol = createRpcProtocol();
+		const extension = extensionWithProposals('vscode.mermaid-chat-features', ['chatOutputRenderer']);
+		const languageModels = createLanguageModels(rpcProtocol);
+		let selectCalls = 0;
+
+		rpcProtocol.set(MainContext.MainThreadLanguageModels, new class extends mock<MainThreadLanguageModelsShape>() {
+			override $selectChatModels(): Promise<string[]> {
+				selectCalls++;
+				return Promise.reject(new Error('provider unavailable'));
+			}
+		});
+
+		const first = await languageModels.getLanguageModelByIdentifier(extension, 'director-code/deepseek-chat');
+		const second = await languageModels.getLanguageModelByIdentifier(extension, 'director-code/deepseek-chat');
+
+		assert.strictEqual(first, undefined);
+		assert.strictEqual(second, undefined);
+		assert.strictEqual(selectCalls, 1);
+
+		languageModels.dispose();
+	});
+
+	test('selectLanguageModels does not recover missing identifiers recursively', async () => {
+		const rpcProtocol = createRpcProtocol();
+		const extension = extensionWithProposals('test.participant', ['chatParticipantAdditions']);
+		const languageModels = createLanguageModels(rpcProtocol);
+		let selectCalls = 0;
+
+		rpcProtocol.set(MainContext.MainThreadLanguageModels, new class extends mock<MainThreadLanguageModelsShape>() {
+			override $selectChatModels(): Promise<string[]> {
+				selectCalls++;
+				return Promise.resolve(['director-code/deepseek-chat']);
+			}
+		});
+
+		const result = await languageModels.selectLanguageModels(extension, { vendor: 'director-code' });
+
+		assert.deepStrictEqual(result, []);
+		assert.strictEqual(selectCalls, 1);
+
+		languageModels.dispose();
+	});
+});
+
+function createRpcProtocol(): TestRPCProtocol {
+	const rpcProtocol = new TestRPCProtocol();
+	rpcProtocol.set(MainContext.MainThreadLanguageModelTools, new class extends mock<MainThreadLanguageModelToolsShape>() {
+		override $getTools(): Promise<IToolDataDto[]> {
+			return Promise.resolve([]);
+		}
+	});
+	rpcProtocol.set(MainContext.MainThreadLanguageModels, new class extends mock<MainThreadLanguageModelsShape>() {
+		override $selectChatModels(): Promise<string[]> {
+			return Promise.resolve([]);
+		}
+	});
+	return rpcProtocol;
+}
+
+function createLanguageModels(rpcProtocol: TestRPCProtocol): ExtHostLanguageModels {
+	return new ExtHostLanguageModels(rpcProtocol, new NullLogService(), new class extends mock<IExtHostAuthentication>() { });
+}
+
+function createToolData(): IToolDataDto {
+	return {
+		id: 'renderMermaidDiagram',
+		displayName: 'Render Mermaid Diagram',
+		modelDescription: 'Render a Mermaid diagram.',
+		source: {
+			type: 'extension',
+			label: 'Mermaid',
+			extensionId: new ExtensionIdentifier('vscode.mermaid-chat-features')
+		},
+		fullReferenceName: 'vscode.mermaid-chat-features/renderMermaidDiagram',
+		inputSchema: {
+			type: 'object',
+			properties: {
+				markup: { type: 'string' }
+			}
+		}
+	};
+}
+
+function extensionWithProposals(id: string, proposals: ApiProposalName[]): IExtensionDescription {
+	return {
+		...nullExtensionDescription,
+		identifier: new ExtensionIdentifier(id),
+		enabledApiProposals: proposals
+	};
+}

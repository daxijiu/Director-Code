+	private showProviderDialog(mode: DialogApiMode): void {
+		const isEdit = mode.kind === 'edit';
+		const instance = isEdit ? mode.instance : undefined;
+		const template = isEdit ? undefined : mode.template;
+		const kind = instance?.kind ?? template!.kind;
+		const authVariant = normalizeRegistryAuthVariant(kind, instance?.authVariant ?? template?.authVariant ?? DEFAULT_AUTH_VARIANT);
+		if (instance?.authKind === 'oauth' || template?.authKind === 'oauth') {
+			this.showOAuthDialog(template ?? this.templateFromInstance(instance!), instance);
+			return;
+		}
+
+		void this.showApiProviderDialog(mode, kind, authVariant);
+	}

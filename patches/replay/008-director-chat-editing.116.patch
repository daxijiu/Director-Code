+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Director-Code Contributors. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import assert from 'assert';
+import { CancellationToken } from '../../../../../../base/common/cancellation.js';
+import { URI } from '../../../../../../base/common/uri.js';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../../base/test/common/utils.js';
+import { TextEdit } from '../../../../../../editor/common/languages.js';
+import { IWorkspaceContextService, IWorkspaceFolder } from '../../../../../../platform/workspace/common/workspace.js';
+import { IChatProgress, IChatService } from '../../../common/chatService/chatService.js';
+import { IChatModel, IChatRequestModel } from '../../../common/model/chatModel.js';
+import { DirectorChatEditingAdapter, DirectorInternalSingleFileEditProbe, formatDirectorChatEditToolResult } from '../../../common/agentEngine/editing/directorChatEditingAdapter.js';
+
+suite('Director Chat Editing Adapter', () => {
+
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	const root = URI.file('/workspace');
+	const folder = { uri: root, name: 'workspace', index: 0 } as IWorkspaceFolder;
+	const sessionResource = URI.parse('vscode-chat://director-test/session');
+
+	function workspaceService(): IWorkspaceContextService {
+		return {
+			getWorkspace: () => ({ id: 'test', folders: [folder] }),
+			getWorkspaceFolder: (resource: URI) => resource.path.startsWith(root.path) ? folder : null,
+		} as unknown as IWorkspaceContextService;
+	}
+
+	function request(id: string): IChatRequestModel {
+		return { id } as IChatRequestModel;
+	}
+
+	function textEdit(text: string): TextEdit {
+		return {
+			range: {
+				startLineNumber: 1,
+				startColumn: 1,
+				endLineNumber: 1,
+				endColumn: 1,
+			},
+			text
+		};
+	}
+
+	function modelWithRequests(requests: IChatRequestModel[]) {
+		const calls: Array<{ requestId: string; progress: IChatProgress }> = [];
+		let startCount = 0;
+		const model = {
+			getRequests: () => requests,
+			startEditingSession: () => { startCount++; },
+			acceptResponseProgress: (target: IChatRequestModel, progress: IChatProgress) => calls.push({ requestId: target.id, progress }),
+			sessionResource,
+		} as unknown as IChatModel & { acceptResponseProgress(target: IChatRequestModel, progress: IChatProgress): void };
+
+		return {
+			model,
+			calls,
+			startCount: () => startCount,
+		};
+	}
+
+	function chatService(model: IChatModel): IChatService {
+		return {
+			getSession: (resource: URI) => resource.toString() === sessionResource.toString() ? model : undefined,
+		} as unknown as IChatService;
+	}
+
+	test('emits reviewable text edit progress against the explicit chatRequestId', async () => {
+		const targetRequest = request('target-request');
+		const laterRequest = request('later-request');
+		const fake = modelWithRequests([targetRequest, laterRequest]);
+		const adapter = new DirectorChatEditingAdapter(chatService(fake.model), workspaceService());
+
+		const result = await adapter.emitSingleFileTextEdit({
+			chatSessionResource: sessionResource,
+			chatRequestId: 'target-request',
+			path: 'src/example.ts',
+			explanation: 'Replace selected text',
+			edits: [textEdit('value')],
+		}, CancellationToken.None);
+
+		assert.strictEqual(result.ok, true);
+		assert.strictEqual(fake.startCount(), 1);
+		assert.deepStrictEqual(fake.calls.map(call => call.requestId), [
+			'target-request',
+			'target-request',
+			'target-request',
+			'target-request',
+			'target-request',
+		]);
+		assert.deepStrictEqual(fake.calls.map(call => call.progress.kind), [
+			'markdownContent',
+			'codeblockUri',
+			'textEdit',
+			'textEdit',
+			'textEdit',
+		]);
+		assert.strictEqual(fake.calls[2].progress.kind, 'textEdit');
+		assert.strictEqual(fake.calls[2].progress.edits.length, 0);
+		assert.strictEqual(fake.calls[3].progress.kind, 'textEdit');
+		assert.strictEqual(fake.calls[3].progress.edits.length, 1);
+		assert.strictEqual(fake.calls[4].progress.kind, 'textEdit');
+		assert.strictEqual(fake.calls[4].progress.done, true);
+		assert.strictEqual(result.relativePath, 'src/example.ts');
+	});
+
+	test('does not fall back to the last request when chatRequestId is missing from the session', async () => {
+		const fake = modelWithRequests([request('first-request'), request('last-request')]);
+		const adapter = new DirectorChatEditingAdapter(chatService(fake.model), workspaceService());
+
+		const result = await adapter.emitSingleFileTextEdit({
+			chatSessionResource: sessionResource,
+			chatRequestId: 'missing-request',
+			path: 'src/example.ts',
+			edits: [textEdit('value')],
+		}, CancellationToken.None);
+
+		assert.strictEqual(result.ok, false);
+		assert.match(result.reason, /missing-request/);
+		assert.strictEqual(fake.calls.length, 0);
+		assert.strictEqual(fake.startCount(), 0);
+	});
+
+	test('rejects edit targets outside the workspace', async () => {
+		const fake = modelWithRequests([request('target-request')]);
+		const adapter = new DirectorChatEditingAdapter(chatService(fake.model), workspaceService());
+
+		const result = await adapter.emitSingleFileTextEdit({
+			chatSessionResource: sessionResource,
+			chatRequestId: 'target-request',
+			targetUri: URI.file('/outside/example.ts'),
+			edits: [textEdit('value')],
+		}, CancellationToken.None);
+
+		assert.strictEqual(result.ok, false);
+		assert.match(result.reason, /outside the current workspace/);
+		assert.strictEqual(fake.calls.length, 0);
+	});
+
+	test('keeps the synthetic edit probe internal to the adapter contract', async () => {
+		const fake = modelWithRequests([request('target-request')]);
+		const adapter = new DirectorChatEditingAdapter(chatService(fake.model), workspaceService());
+		const probe = new DirectorInternalSingleFileEditProbe(adapter);
+
+		const result = await probe.run({
+			chatSessionResource: sessionResource,
+			chatRequestId: 'target-request',
+			path: 'src/probe.ts',
+			edits: [textEdit('probe')],
+		}, CancellationToken.None);
+
+		assert.strictEqual(result.ok, true);
+		assert.strictEqual(fake.calls[0].progress.kind, 'markdownContent');
+		assert.match(formatDirectorChatEditToolResult(result), /edit_result: success/);
+	});
+
+	test('formats compact edit errors for the model loop', () => {
+		assert.strictEqual(formatDirectorChatEditToolResult({ ok: false, reason: 'no session' }), 'edit_result: error\nreason: no session');
+	});
+});

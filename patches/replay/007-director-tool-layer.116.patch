+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Director-Code Contributors. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import assert from 'assert';
+import { VSBuffer } from '../../../../../../base/common/buffer.js';
+import { CancellationToken } from '../../../../../../base/common/cancellation.js';
+import { URI } from '../../../../../../base/common/uri.js';
+import { IFileContent, IFileService, IFileStat } from '../../../../../../platform/files/common/files.js';
+import { IMarkerService, MarkerSeverity } from '../../../../../../platform/markers/common/markers.js';
+import { IWorkspaceContextService, IWorkspaceFolder } from '../../../../../../platform/workspace/common/workspace.js';
+import { ISCMService } from '../../../../scm/common/scm.js';
+import { ISearchService, QueryType, TextSearchMatch } from '../../../../../services/search/common/search.js';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../../base/test/common/utils.js';
+import { IToolInvocation } from '../../../common/tools/languageModelToolsService.js';
+import {
+	DirectorFileSearchTool,
+	DirectorGetChangedFilesTool,
+	DirectorGetErrorsTool,
+	DirectorGithubRepoTool,
+	DirectorGrepSearchTool,
+	DirectorListDirectoryTool,
+	DirectorReadFileTool,
+	DirectorReadOnlyToolData,
+	DirectorViewImageTool,
+} from '../../../../directorCode/common/agentEngine/directorReadOnlyTools.js';
+
+suite('Director Read-Only Tools', () => {
+
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	const root = URI.file('/workspace');
+	const folder = { uri: root, name: 'workspace', index: 0 } as IWorkspaceFolder;
+
+	function workspaceService(): IWorkspaceContextService {
+		return {
+			getWorkspace: () => ({ id: 'test', folders: [folder] }),
+			getWorkspaceFolder: (resource: URI) => resource.path.startsWith(root.path) ? folder : null,
+		} as unknown as IWorkspaceContextService;
+	}
+
+	function content(value: string | VSBuffer): IFileContent {
+		const buffer = typeof value === 'string' ? VSBuffer.fromString(value) : value;
+		return {
+			resource: root,
+			name: 'file',
+			value: buffer,
+			mtime: 1,
+			ctime: 1,
+			etag: '1',
+			size: buffer.byteLength,
+			readonly: false,
+			locked: false,
+			executable: false,
+		};
+	}
+
+	function fileStat(name: string, resource: URI, isDirectory: boolean, children?: IFileStat[]): IFileStat {
+		return {
+			name,
+			resource,
+			isFile: !isDirectory,
+			isDirectory,
+			isSymbolicLink: false,
+			children,
+			size: 1,
+		};
+	}
+
+	function invocation(parameters: Record<string, unknown>): IToolInvocation {
+		return {
+			callId: 'call',
+			toolId: 'tool',
+			parameters,
+			context: undefined,
+		};
+	}
+
+	test('declares the read-only facade tool data set', () => {
+		assert.deepStrictEqual(DirectorReadOnlyToolData.map(tool => tool.toolReferenceName), [
+			'readFile',
+			'listDirectory',
+			'fileSearch',
+			'textSearch',
+			'problems',
+			'changes',
+			'viewImage',
+			'github_repo',
+		]);
+	});
+
+	test('readFile reads workspace text and rejects external paths', async () => {
+		const fileService = {
+			readFile: async () => content('one\ntwo\nthree\nfour'),
+		} as unknown as IFileService;
+		const tool = new DirectorReadFileTool(fileService, workspaceService());
+
+		const result = await tool.invoke(invocation({ filePath: 'src/app.ts', startLine: 2, endLine: 3 }), async () => 0, undefined as any, CancellationToken.None);
+		assert.ok(result.content[0].kind === 'text' && result.content[0].value.includes('two\nthree'));
+		assert.ok(result.content[0].kind === 'text' && result.content[0].value.includes('lines: 2-3'));
+
+		const external = await tool.invoke(invocation({ filePath: '/outside/app.ts' }), async () => 0, undefined as any, CancellationToken.None);
+		assert.ok(external.content[0].kind === 'text' && external.content[0].value.includes('outside the current workspace'));
+	});
+
+	test('listDirectory sorts directories before files and caps results', async () => {
+		const stat = fileStat('src', URI.joinPath(root, 'src'), true, [
+			fileStat('z.ts', URI.joinPath(root, 'src', 'z.ts'), false),
+			fileStat('lib', URI.joinPath(root, 'src', 'lib'), true),
+			fileStat('a.ts', URI.joinPath(root, 'src', 'a.ts'), false),
+		]);
+		const fileService = {
+			resolve: async () => stat,
+		} as unknown as IFileService;
+		const tool = new DirectorListDirectoryTool(fileService, workspaceService());
+
+		const result = await tool.invoke(invocation({ path: 'src', maxResults: 2 }));
+		const text = result.content[0].kind === 'text' ? result.content[0].value : '';
+		assert.ok(text.includes('truncated: true'));
+		assert.ok(text.indexOf('lib/') < text.indexOf('a.ts'));
+		assert.ok(!text.includes('z.ts'));
+	});
+
+	test('fileSearch and textSearch use workspace-scoped VS Code search queries', async () => {
+		const fileQueries: any[] = [];
+		const textQueries: any[] = [];
+		const searchService = {
+			fileSearch: async (query: any) => {
+				fileQueries.push(query);
+				return { results: [{ resource: URI.joinPath(root, 'src', 'app.ts') }], limitHit: false, messages: [] };
+			},
+			textSearch: async (query: any) => {
+				textQueries.push(query);
+				return {
+					results: [{
+						resource: URI.joinPath(root, 'src', 'app.ts'),
+						results: [new TextSearchMatch('const value = 1;', { startLineNumber: 7, startColumn: 6, endLineNumber: 7, endColumn: 11 })],
+					}],
+					limitHit: false,
+					messages: [],
+				};
+			},
+		} as unknown as ISearchService;
+
+		const files = await new DirectorFileSearchTool(searchService, workspaceService()).invoke(invocation({ query: '*.ts', exclude: '**/node_modules/**' }), async () => 0, undefined as any, CancellationToken.None);
+		assert.strictEqual(fileQueries[0].type, QueryType.File);
+		assert.strictEqual(fileQueries[0].folderQueries[0].folder.toString(), root.toString());
+		assert.deepStrictEqual(fileQueries[0].excludePattern, { '**/node_modules/**': true });
+		assert.ok(files.content[0].kind === 'text' && files.content[0].value.includes('src/app.ts'));
+
+		const grep = await new DirectorGrepSearchTool(searchService, workspaceService()).invoke(invocation({ query: 'value', isRegexp: true, isCaseSensitive: true, includePattern: '**/*.ts', includeIgnoredFiles: true }), async () => 0, undefined as any, CancellationToken.None);
+		assert.strictEqual(textQueries[0].type, QueryType.Text);
+		assert.strictEqual(textQueries[0].contentPattern.isRegExp, true);
+		assert.strictEqual(textQueries[0].contentPattern.isCaseSensitive, true);
+		assert.deepStrictEqual(textQueries[0].includePattern, { '**/*.ts': true });
+		assert.strictEqual(textQueries[0].folderQueries[0].disregardIgnoreFiles, true);
+		assert.ok(grep.content[0].kind === 'text' && grep.content[0].value.includes('src/app.ts:7:6'));
+	});
+
+	test('problems returns workspace diagnostics only', async () => {
+		const markerService = {
+			read: () => [
+				{ owner: 'ts', resource: URI.joinPath(root, 'src', 'app.ts'), severity: MarkerSeverity.Error, message: 'broken', startLineNumber: 4, startColumn: 2, endLineNumber: 4, endColumn: 8 },
+				{ owner: 'ts', resource: URI.joinPath(root, 'test', 'app.ts'), severity: MarkerSeverity.Error, message: 'test broken', startLineNumber: 5, startColumn: 3, endLineNumber: 5, endColumn: 8 },
+				{ owner: 'ts', resource: URI.file('/outside/app.ts'), severity: MarkerSeverity.Error, message: 'outside', startLineNumber: 1, startColumn: 1, endLineNumber: 1, endColumn: 1 },
+			],
+		} as unknown as IMarkerService;
+		const tool = new DirectorGetErrorsTool(markerService, workspaceService());
+
+		const result = await tool.invoke(invocation({ filePaths: ['src'] }));
+		const text = result.content[0].kind === 'text' ? result.content[0].value : '';
+		assert.ok(text.includes('src/app.ts:4:2'));
+		assert.ok(!text.includes('test/app.ts'));
+		assert.ok(!text.includes('outside'));
+	});
+
+	test('changes reads SCM resource groups without running Git', async () => {
+		const resource = {
+			sourceUri: URI.joinPath(root, 'src', 'app.ts'),
+			decorations: { tooltip: 'Modified' },
+			contextValue: 'modified',
+			resourceGroup: undefined as any,
+		};
+		const group = { id: 'workingTree', label: 'Changes', resources: [resource] };
+		resource.resourceGroup = group;
+		const scmService = {
+			repositoryCount: 1,
+			repositories: [{
+				id: 'repo',
+				provider: { label: 'Git', rootUri: root, groups: [group] },
+			}],
+		} as unknown as ISCMService;
+		const tool = new DirectorGetChangedFilesTool(scmService, workspaceService());
+
+		const result = await tool.invoke(invocation({ repositoryPath: '.', sourceControlState: ['modified'] }));
+		assert.ok(result.content[0].kind === 'text' && result.content[0].value.includes('Modified\tsrc/app.ts'));
+	});
+
+	test('viewImage returns metadata and image data for workspace images', async () => {
+		const imageBytes = VSBuffer.fromByteArray([0, 1, 2, 3]);
+		const fileService = {
+			readFile: async () => content(imageBytes),
+		} as unknown as IFileService;
+		const tool = new DirectorViewImageTool(fileService, workspaceService());
+
+		const result = await tool.invoke(invocation({ filePath: 'image.png' }), async () => 0, undefined as any, CancellationToken.None);
+		assert.strictEqual(result.content[0].kind, 'text');
+		assert.strictEqual(result.content[1].kind, 'data');
+		assert.strictEqual(result.content[1].kind === 'data' ? result.content[1].value.mimeType : undefined, 'image/png');
+	});
+
+	test('github_repo infers sanitized GitHub remotes and reports v1 search fallback', async () => {
+		const config = '[remote "origin"]\n\turl = https://token@github.com/example/project.git\n';
+		const fileService = {
+			readFile: async () => content(config),
+		} as unknown as IFileService;
+		const tool = new DirectorGithubRepoTool(fileService, workspaceService());
+
+		const inferred = await tool.invoke(invocation({}), async () => 0, undefined as any, CancellationToken.None);
+		const text = inferred.content[0].kind === 'text' ? inferred.content[0].value : '';
+		assert.ok(text.includes('"repository": "example/project"'));
+		assert.ok(text.includes('"url": "https://github.com/example/project.git"'));
+		assert.ok(!text.includes('token@'));
+
+		const search = await tool.invoke(invocation({ repo: 'example/project', query: 'Symbol' }), async () => 0, undefined as any, CancellationToken.None);
+		assert.ok(search.content[0].kind === 'text' && search.content[0].value.includes('remote GitHub search is not supported'));
+	});
+});

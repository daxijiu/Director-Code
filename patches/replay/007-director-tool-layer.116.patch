+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Director-Code Contributors. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import assert from 'assert';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../../base/test/common/utils.js';
+import { ToolDataSource, type IToolData } from '../../../common/tools/languageModelToolsService.js';
+import { createDirectorRawToolSnapshot, DirectorToolMode, getDirectorToolAllowlist } from '../../../../directorCode/common/agentEngine/directorToolRegistry.js';
+
+suite('Director Tool Registry', () => {
+
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	function tool(id: string, referenceName: string | undefined, modelDescription = `${referenceName ?? id} description`): IToolData {
+		return {
+			id,
+			toolReferenceName: referenceName,
+			displayName: referenceName ?? id,
+			modelDescription,
+			source: ToolDataSource.Internal,
+			inputSchema: {
+				type: 'object',
+				properties: {
+					value: { type: 'string' },
+				},
+				required: ['value'],
+			},
+		};
+	}
+
+	test('computes an Ask allowlist with read-only tools only', () => {
+		const raw = [
+			tool('vscode_listCodeUsages', 'usages'),
+			tool('run_in_terminal', 'runInTerminal'),
+			tool('vscode_renameSymbol', 'rename'),
+			tool('vscode_fetchWebPage_internal', undefined),
+		];
+
+		const askTools = getDirectorToolAllowlist(raw, DirectorToolMode.Ask);
+
+		assert.deepStrictEqual(askTools.map(item => item.modelName), ['usages', 'vscode_fetchWebPage_internal']);
+		assert.ok(askTools.every(item => item.definition.isReadOnly === true));
+		assert.ok(!askTools.some(item => item.modelName === 'runInTerminal'));
+		assert.ok(!askTools.some(item => item.modelName === 'rename'));
+	});
+
+	test('preserves existing terminal and task tools for Agent mode', () => {
+		const raw = [
+			tool('run_in_terminal', 'runInTerminal'),
+			tool('run_task', 'runTask'),
+			tool('create_and_run_task', 'createAndRunTask'),
+			tool('get_task_output', 'getTaskOutput'),
+		];
+
+		const agentTools = getDirectorToolAllowlist(raw, DirectorToolMode.Agent);
+		const names = agentTools.map(item => item.modelName);
+
+		assert.deepStrictEqual(names, ['createAndRunTask', 'getTaskOutput', 'runInTerminal', 'runTask']);
+		assert.strictEqual(agentTools.find(item => item.modelName === 'getTaskOutput')?.definition.isReadOnly, true);
+		assert.strictEqual(agentTools.find(item => item.modelName === 'runTask')?.definition.isReadOnly, false);
+	});
+
+	test('exposes read-only facade workspace tools in Ask/Edit/Agent only', () => {
+		const raw = [
+			tool('director_read_file', 'readFile'),
+			tool('director_list_dir', 'listDirectory'),
+			tool('director_file_search', 'fileSearch'),
+			tool('director_grep_search', 'textSearch'),
+			tool('director_get_errors', 'problems'),
+			tool('director_get_changed_files', 'changes'),
+			tool('director_view_image', 'viewImage'),
+			tool('director_github_repo', 'github_repo'),
+		];
+
+		const expected = ['changes', 'fileSearch', 'github_repo', 'listDirectory', 'problems', 'readFile', 'textSearch', 'viewImage'];
+
+		assert.deepStrictEqual(getDirectorToolAllowlist(raw, DirectorToolMode.Ask).map(item => item.modelName), expected);
+		assert.deepStrictEqual(getDirectorToolAllowlist(raw, DirectorToolMode.Edit).map(item => item.modelName), expected);
+		assert.deepStrictEqual(getDirectorToolAllowlist(raw, DirectorToolMode.Agent).map(item => item.modelName), expected);
+		assert.deepStrictEqual(getDirectorToolAllowlist(raw, DirectorToolMode.Inline).map(item => item.modelName), []);
+		assert.ok(getDirectorToolAllowlist(raw, DirectorToolMode.Ask).every(item => item.definition.isReadOnly === true));
+		for (const oldName of ['read_file', 'list_dir', 'file_search', 'grep_search', 'get_errors', 'get_changed_files', 'view_image']) {
+			assert.ok(!getDirectorToolAllowlist(raw, DirectorToolMode.Agent).some(item => item.modelName === oldName), `${oldName} should not be model-facing after facade cutover`);
+		}
+	});
+
+	test('exposes Phase 4 reviewable edit tools in Edit and Agent only', () => {
+		const raw = [
+			tool('director_apply_patch', 'apply_patch'),
+			tool('director_create_file', 'create_file'),
+			tool('director_create_directory', 'create_directory'),
+			tool('director_replace_string_in_file', 'replace_string_in_file'),
+			tool('director_multi_replace_string_in_file', 'multi_replace_string_in_file'),
+		];
+
+		const expected = ['apply_patch', 'create_directory', 'create_file', 'multi_replace_string_in_file', 'replace_string_in_file'];
+
+		assert.deepStrictEqual(getDirectorToolAllowlist(raw, DirectorToolMode.Ask).map(item => item.modelName), []);
+		assert.deepStrictEqual(getDirectorToolAllowlist(raw, DirectorToolMode.Edit).map(item => item.modelName), expected);
+		assert.deepStrictEqual(getDirectorToolAllowlist(raw, DirectorToolMode.Agent).map(item => item.modelName), expected);
+		assert.deepStrictEqual(getDirectorToolAllowlist(raw, DirectorToolMode.Inline).map(item => item.modelName), []);
+		assert.ok(getDirectorToolAllowlist(raw, DirectorToolMode.Agent).every(item => item.definition.isReadOnly === false));
+	});
+
+	test('hides internal edit and deferred mutation tools from Agent mode', () => {
+		const raw = [
+			tool('vscode_editFile_internal', undefined),
+			tool('vscode_renameSymbol', 'rename'),
+			tool('setup_tools_createNewWorkspace', 'new'),
+			tool('manage_todo_list', 'todo'),
+		];
+
+		const agentTools = getDirectorToolAllowlist(raw, DirectorToolMode.Agent);
+
+		assert.deepStrictEqual(agentTools.map(item => item.modelName), ['todo']);
+	});
+
+	test('exposes direct-reuse browser tools in Agent mode with Director approval policy', () => {
+		const raw = [
+			tool('open_browser_page', 'openBrowserPage'),
+			tool('read_page', 'readPage'),
+			tool('screenshot_page', 'screenshotPage'),
+			tool('navigate_page', 'navigatePage'),
+			tool('click_element', 'clickElement'),
+			tool('drag_element', 'dragElement'),
+			tool('hover_element', 'hoverElement'),
+			tool('type_in_page', 'typeInPage'),
+			tool('run_playwright_code', 'runPlaywrightCode'),
+			tool('handle_dialog', 'handleDialog'),
+		];
+
+		const expected = ['clickElement', 'dragElement', 'handleDialog', 'hoverElement', 'navigatePage', 'openBrowserPage', 'readPage', 'runPlaywrightCode', 'screenshotPage', 'typeInPage'];
+
+		assert.deepStrictEqual(getDirectorToolAllowlist(raw, DirectorToolMode.Ask).map(item => item.modelName), []);
+		assert.deepStrictEqual(getDirectorToolAllowlist(raw, DirectorToolMode.Edit).map(item => item.modelName), []);
+		assert.deepStrictEqual(getDirectorToolAllowlist(raw, DirectorToolMode.Agent).map(item => item.modelName), expected);
+		assert.deepStrictEqual(getDirectorToolAllowlist(raw, DirectorToolMode.Inline).map(item => item.modelName), []);
+
+		const agentTools = getDirectorToolAllowlist(raw, DirectorToolMode.Agent);
+		for (const name of ['clickElement', 'dragElement', 'handleDialog', 'navigatePage', 'openBrowserPage', 'runPlaywrightCode', 'typeInPage']) {
+			const resolved = agentTools.find(item => item.modelName === name);
+			assert.ok(resolved?.directorPreApprovalReason, `${name} should require Director pre-approval`);
+			assert.strictEqual(resolved?.entry.confirmationPolicy, 'director-pre-approval');
+			assert.strictEqual(resolved?.definition.isReadOnly, false);
+		}
+		for (const name of ['readPage', 'screenshotPage']) {
+			const resolved = agentTools.find(item => item.modelName === name);
+			assert.ok(resolved?.directorPreApprovalReason, `${name} should require Director session approval`);
+			assert.strictEqual(resolved?.entry.confirmationPolicy, 'director-session-approval');
+			assert.strictEqual(resolved?.definition.isReadOnly, true);
+		}
+		assert.strictEqual(agentTools.find(item => item.modelName === 'hoverElement')?.directorPreApprovalReason, undefined);
+	});
+
+	test('allows retained Mermaid extension tool in Agent mode only', () => {
+		const raw = [
+			tool('renderMermaidDiagram', 'renderMermaidDiagram'),
+			tool('vscode_searchExtensions_internal', 'extensions'),
+		];
+
+		const agentTools = getDirectorToolAllowlist(raw, DirectorToolMode.Agent);
+
+		assert.deepStrictEqual(getDirectorToolAllowlist(raw, DirectorToolMode.Ask).map(item => item.modelName), []);
+		assert.deepStrictEqual(getDirectorToolAllowlist(raw, DirectorToolMode.Edit).map(item => item.modelName), []);
+		assert.deepStrictEqual(agentTools.map(item => item.modelName), ['renderMermaidDiagram']);
+		assert.deepStrictEqual(getDirectorToolAllowlist(raw, DirectorToolMode.Inline).map(item => item.modelName), []);
+		assert.strictEqual(agentTools[0].entry.backing, 'vscode-extension');
